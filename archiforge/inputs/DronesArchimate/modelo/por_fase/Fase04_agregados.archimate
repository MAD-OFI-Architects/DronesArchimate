  <folder name="Technology &amp; Physical" id="id-7f3099b1390b5c4194199599fc70963c" type="technology"/>
  <folder name="Motivation" id="id-962c8dcf48ca501d84d29d02061b918d" type="motivation"/>
  <folder name="Implementation &amp; Migration" id="id-375bef8cf2f1535d99c0c65569be1e6c" type="implementation_migration"/>
  <folder name="Other" id="id-00934b9a97b0567595cdc8e47123ba04" type="other">
    <folder name="Agregados" id="id-8f9ebe555f6f5d15a1f13019022b4c1a">
      <element xsi:type="archimate:Grouping" name="Agregado: Dron" id="id-eb05dd7a47405478b1337702ce2d3cb6">
        <documentation>Límite de consistencia transaccional. La invariante «una pieza por posición» y la de instalación única exigen modificar el dron y su mapa de instalación en una sola transacción.</documentation>
        <property key="Dominio" value="Flota y Componentes"/>
        <property key="Fase" value="4 (V6)"/>
      </element>
      <element xsi:type="archimate:Grouping" name="Agregado: Componente" id="id-9dc43dec8a4c525ba41ea0128d5010d6">
        <documentation>Límite de consistencia transaccional. El contador y la vida remanente deben cambiar juntos y viajar con la pieza entre drones (pool de baterías, donantes).</documentation>
        <property key="Dominio" value="Flota y Componentes"/>
        <property key="Fase" value="4 (V6)"/>
      </element>
      <element xsi:type="archimate:Grouping" name="Agregado: Plan por modelo" id="id-1c3869b6039b519ab6f0961c68ba20e5">
        <documentation>Límite de consistencia transaccional. Las condiciones de un modelo se versionan juntas: un boletín cambia varias tareas a la vez.</documentation>
        <property key="Dominio" value="Plan de Mantenimiento"/>
        <property key="Fase" value="4 (V6)"/>
      </element>
      <element xsi:type="archimate:Grouping" name="Agregado: Plan por dron" id="id-a9702ea2b9165f52a5fe535604280d2f">
        <documentation>Límite de consistencia transaccional. Cada dron decide su vencimiento y sus diferimientos con su propia historia; una transacción por dron.</documentation>
        <property key="Dominio" value="Plan de Mantenimiento"/>
        <property key="Fase" value="4 (V6)"/>
      </element>
      <element xsi:type="archimate:Grouping" name="Agregado: Programa semanal" id="id-84f70c927618550cb1825ca56e31d25f">
        <documentation>Límite de consistencia transaccional. Las restricciones de capacidad (dos bahías, misma línea) solo se pueden proteger viendo todas las paradas de la semana a la vez.</documentation>
        <property key="Dominio" value="Plan de Mantenimiento"/>
        <property key="Fase" value="4 (V6)"/>
      </element>
      <element xsi:type="archimate:Grouping" name="Agregado: Orden de trabajo" id="id-7cc7e814c6d85acc83a578efa8884365">
        <documentation>Límite de consistencia transaccional. La liberación, el vuelo de prueba y el cierre comparten el mismo ciclo de vida y la misma regla «quien ejecuta no libera».</documentation>
        <property key="Dominio" value="Intervenciones"/>
        <property key="Fase" value="4 (V6)"/>
      </element>
      <element xsi:type="archimate:Grouping" name="Agregado: Jornada de vuelo" id="id-ea9c1ae2f46b586cacc345755bbb6b4d">
        <documentation>Límite de consistencia transaccional. Una jornada es el límite natural para no duplicar vuelos y confirmar datos.</documentation>
        <property key="Dominio" value="Operación y Horas"/>
        <property key="Fase" value="4 (V6)"/>
      </element>
      <element xsi:type="archimate:Grouping" name="Agregado: Importación de telemetría" id="id-9399e8a2522b5a459e5fce010d79414e">
        <documentation>Límite de consistencia transaccional. Un archivo es la unidad de idempotencia y de consistencia: entra completo o no entra.</documentation>
        <property key="Dominio" value="Operación y Horas"/>
        <property key="Fase" value="4 (V6)"/>
      </element>
      <element xsi:type="archimate:Grouping" name="Agregado: Existencia" id="id-4fb8bf41fc4e5331b27b4fbb8f419644">
        <documentation>Límite de consistencia transaccional. Reserva y existencia deben cambiar en la misma transacción para que no se prometa lo que no hay.</documentation>
        <property key="Dominio" value="Repuestos del Taller"/>
        <property key="Fase" value="4 (V6)"/>
      </element>
      <element xsi:type="archimate:Grouping" name="Agregado: Solicitud de reposición" id="id-68d44a8ed92c505f984ff53b575e4f1c">
        <documentation>Límite de consistencia transaccional. Tiene su propio ciclo de vida (pedir, aprobar, cancelar) y termina donde empieza compras.</documentation>
        <property key="Dominio" value="Repuestos del Taller"/>
        <property key="Fase" value="4 (V6)"/>
      </element>
      <element xsi:type="archimate:Grouping" name="Agregado: Definición de indicador" id="id-c84933be6e9352fcaa9d2962344cbaca">
        <documentation>Límite de consistencia transaccional. Fórmula, regla y meta se versionan juntas.</documentation>
        <property key="Dominio" value="Indicadores"/>
        <property key="Fase" value="4 (V6)"/>
      </element>
      <element xsi:type="archimate:Grouping" name="Agregado: Medición de indicador" id="id-48eb8ddb6a1154ffbbaaec2715a63373">
        <documentation>Límite de consistencia transaccional. Cada medición es un hecho histórico independiente.</documentation>
        <property key="Dominio" value="Indicadores"/>
        <property key="Fase" value="4 (V6)"/>
      </element>
      <element xsi:type="archimate:Grouping" name="Agregado: Técnico habilitado" id="id-23f2767f07ac5623929d8ba9410f8b2d">
        <documentation>Límite de consistencia transaccional. Las habilitaciones de un técnico se evalúan juntas al asignarle trabajo.</documentation>
        <property key="Dominio" value="Habilitación de Personal"/>
        <property key="Fase" value="4 (V6)"/>
      </element>
    </folder>
  </folder>
