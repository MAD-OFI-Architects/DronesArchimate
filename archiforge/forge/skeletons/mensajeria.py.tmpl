"""Outbox e inbox durables — generado por ArchiForge.

ARCHIFORGE: mensajeria-durable (este módulo lo escribe el scaffolding; cabledalo, no lo reimplementes)

Reglas que no se negocian:
- El evento de salida se escribe en ``bandeja_salida`` dentro de la MISMA transacción
  que el agregado (``UnidadDeTrabajo``) y sólo se marca publicado cuando el bus lo aceptó.
- ``DespachadorDeBandeja.despachar_una_vez`` NUNCA descarta: si el bus falla, el mensaje
  queda pendiente, se registra el intento y se reintenta en la próxima vuelta. No hay
  límite de intentos: un mensaje sólo desaparece cuando se publicó.
- ``bandeja_entrada`` deduplica por ``event_id`` en la misma transacción del efecto:
  si el caso de uso falla, la marca se revierte y el sobre se puede reintentar.

Este archivo no importa psycopg: recibe una conexión con la interfaz de psycopg
(``execute``, ``commit``, ``rollback``, ``close``) y por eso también corre contra
sqlite en las pruebas herméticas.
"""
from __future__ import annotations

import json
import threading
import uuid
from datetime import datetime, timezone
from typing import Any, Callable

ESQUEMA = (
    "CREATE TABLE IF NOT EXISTS bandeja_salida ("
    "id TEXT PRIMARY KEY, topico TEXT NOT NULL, payload TEXT NOT NULL, ocurrido_en TEXT NOT NULL, "
    "intentos INTEGER NOT NULL DEFAULT 0, ultimo_error TEXT, publicado_en TEXT)",
    "CREATE TABLE IF NOT EXISTS bandeja_entrada (event_id TEXT PRIMARY KEY, procesado_en TEXT NOT NULL)",
)


def ahora() -> str:
    return datetime.now(timezone.utc).isoformat()


class UnidadDeTrabajo:
    """Una transacción por petición: agregado + bandeja de salida + marca de entrada, o nada.

    ``fabrica`` devuelve una conexión nueva (por ejemplo ``psycopg.connect(dsn)``); la
    conexión se cierra al salir del bloque y nunca se comparte entre peticiones.
    """

    def __init__(self, fabrica: Callable[[], Any]) -> None:
        self._fabrica = fabrica
        self._conexion: Any | None = None
        self._confirmada = False

    def __enter__(self) -> "UnidadDeTrabajo":
        self._conexion = self._fabrica()
        try:
            self._conexion.autocommit = False
        except (AttributeError, TypeError):  # sqlite y dobles de prueba
            pass
        for sentencia in ESQUEMA:
            self._conexion.execute(sentencia)
        return self

    def __exit__(self, tipo, valor, traza) -> None:
        try:
            if tipo is None or self._confirmada:
                self.confirmar()
            else:
                self.revertir()
        finally:
            if self._conexion is not None:
                self._conexion.close()

    @property
    def conexion(self) -> Any:
        if self._conexion is None:
            raise RuntimeError("La unidad de trabajo se usa dentro de un bloque `with`.")
        return self._conexion

    def confirmar(self) -> None:
        if not self._confirmada:
            self._conexion.commit()
            self._confirmada = True

    def revertir(self) -> None:
        if not self._confirmada:
            self._conexion.rollback()

    def marcar_entrante(self, event_id: str) -> bool:
        """Devuelve True la primera vez que se ve el evento; False si ya estaba procesado."""
        cursor = self._conexion.execute(
            "INSERT INTO bandeja_entrada (event_id, procesado_en) VALUES (%s, %s) "
            "ON CONFLICT (event_id) DO NOTHING",
            (event_id, ahora()),
        )
        return getattr(cursor, "rowcount", 0) == 1


class _ConexionEnMemoria:
    """Doble de conexión para pruebas: las bandejas en memoria hacen el trabajo."""

    autocommit = False

    def execute(self, *_args, **_kwargs):  # pragma: no cover - nunca recibe SQL real
        raise AssertionError("La unidad en memoria no ejecuta SQL.")

    def commit(self) -> None: ...

    def rollback(self) -> None: ...

    def close(self) -> None: ...


class UnidadEnMemoria:
    """Misma semántica que ``UnidadDeTrabajo`` para pruebas herméticas, sin base de datos."""

    def __init__(self) -> None:
        self.conexion = _ConexionEnMemoria()
        self._procesados: set[str] = set()
        self._respaldo: set[str] = set()
        self.confirmada = False

    def __enter__(self) -> "UnidadEnMemoria":
        self._respaldo = set(self._procesados)
        return self

    def __exit__(self, tipo, valor, traza) -> None:
        if tipo is None:
            self.confirmar()
        else:
            self.revertir()

    def confirmar(self) -> None:
        self.confirmada = True

    def revertir(self) -> None:
        self._procesados = set(self._respaldo)

    def marcar_entrante(self, event_id: str) -> bool:
        if event_id in self._procesados:
            return False
        self._procesados.add(event_id)
        return True


class BandejaDeSalida:
    """Outbox sobre la conexión de la unidad de trabajo (misma transacción que el agregado)."""

    def __init__(self, unidad: UnidadDeTrabajo) -> None:
        self._unidad = unidad

    def agregar(self, topico: str, evento: dict) -> dict:
        identificador = str(evento.get("eventId") or uuid.uuid4())
        sobre = {**evento, "eventId": identificador}
        self._unidad.conexion.execute(
            "INSERT INTO bandeja_salida (id, topico, payload, ocurrido_en) VALUES (%s, %s, %s, %s)",
            (identificador, topico, json.dumps(sobre, ensure_ascii=False), ahora()),
        )
        return sobre

    def pendientes(self, limite: int = 50) -> list[dict]:
        filas = self._unidad.conexion.execute(
            "SELECT id, topico, payload FROM bandeja_salida WHERE publicado_en IS NULL "
            "ORDER BY ocurrido_en LIMIT %s",
            (limite,),
        ).fetchall()
        return [{"id": fila[0], "topico": fila[1], "payload": json.loads(fila[2])} for fila in filas]

    def marcar_publicado(self, identificador: str) -> None:
        self._unidad.conexion.execute(
            "UPDATE bandeja_salida SET publicado_en = %s WHERE id = %s", (ahora(), identificador))

    def registrar_fallo(self, identificador: str, error: str) -> None:
        self._unidad.conexion.execute(
            "UPDATE bandeja_salida SET intentos = intentos + 1, ultimo_error = %s WHERE id = %s",
            (error[:500], identificador))


class BandejaDeSalidaEnMemoria:
    """Misma semántica que ``BandejaDeSalida`` sin base de datos. No descarta: reintenta."""

    def __init__(self) -> None:
        self._filas: dict[str, dict] = {}
        self._lock = threading.RLock()

    def __enter__(self) -> "BandejaDeSalidaEnMemoria":
        return self

    def __exit__(self, tipo, valor, traza) -> None:
        return None

    def agregar(self, topico: str, evento: dict) -> dict:
        identificador = str(evento.get("eventId") or uuid.uuid4())
        sobre = {**evento, "eventId": identificador}
        with self._lock:
            self._filas[identificador] = {"id": identificador, "topico": topico, "payload": sobre,
                                          "ocurrido_en": ahora(), "intentos": 0,
                                          "ultimo_error": None, "publicado_en": None}
        return sobre

    def pendientes(self, limite: int = 50) -> list[dict]:
        with self._lock:
            filas = [dict(f) for f in self._filas.values() if f["publicado_en"] is None]
        return sorted(filas, key=lambda f: f["ocurrido_en"])[:limite]

    def marcar_publicado(self, identificador: str) -> None:
        with self._lock:
            self._filas[identificador]["publicado_en"] = ahora()

    def registrar_fallo(self, identificador: str, error: str) -> None:
        with self._lock:
            fila = self._filas[identificador]
            fila["intentos"] += 1
            fila["ultimo_error"] = error[:500]


class BandejaTransaccional:
    """Abre una ``UnidadDeTrabajo`` y entrega su bandeja: el lote del despachador se confirma al salir."""

    def __init__(self, fabrica_de_conexion: Callable[[], Any]) -> None:
        self._fabrica = fabrica_de_conexion
        self._unidad: UnidadDeTrabajo | None = None

    def __enter__(self) -> BandejaDeSalida:
        self._unidad = UnidadDeTrabajo(self._fabrica)
        self._unidad.__enter__()
        return BandejaDeSalida(self._unidad)

    def __exit__(self, tipo, valor, traza) -> None:
        self._unidad.__exit__(tipo, valor, traza)


class DespachadorDeBandeja:
    """Vacía la bandeja DESPUÉS de responder: hilo propio, nunca dentro de la petición.

    ``fabrica_de_bandeja`` devuelve un gestor de contexto que entrega una bandeja y
    confirma el lote al salir: ``lambda: BandejaTransaccional(fabrica_de_conexion)``
    contra PostgreSQL, o ``lambda: bandeja_en_memoria`` en pruebas. Cada vuelta es una
    transacción corta; si el bus falla, el mensaje sigue pendiente para la próxima.
    """

    def __init__(self, fabrica_de_bandeja: Callable[[], Any], publicador: Any,
                 intervalo: float = 0.2, tamano_de_lote: int = 50) -> None:
        self._fabrica = fabrica_de_bandeja
        self._publicador = publicador
        self._intervalo = intervalo
        self._lote = tamano_de_lote
        self._parar = threading.Event()
        self._hilo: threading.Thread | None = None

    def despachar_una_vez(self) -> int:
        enviados = 0
        with self._fabrica() as bandeja:
            for fila in bandeja.pendientes(self._lote):
                try:
                    self._publicador.publicar(fila["topico"], fila["payload"])
                except Exception as error:  # el mensaje sigue pendiente: se reintenta
                    bandeja.registrar_fallo(fila["id"], str(error))
                else:
                    bandeja.marcar_publicado(fila["id"])
                    enviados += 1
        return enviados

    def arrancar(self) -> "DespachadorDeBandeja":
        if self._hilo is not None:
            return self
        self._parar.clear()
        self._hilo = threading.Thread(target=self._bucle, name="despachador-outbox", daemon=True)
        self._hilo.start()
        return self

    def detener(self) -> None:
        self._parar.set()
        if self._hilo is not None:
            self._hilo.join(timeout=5)
            self._hilo = None

    def _bucle(self) -> None:
        self._intentar()  # recuperación: lo pendiente que dejó una caída
        while not self._parar.wait(self._intervalo):
            self._intentar()

    def _intentar(self) -> None:
        try:
            self.despachar_una_vez()
        except Exception:  # el hilo no puede morir por un error de la base
            pass


class ProcesadorDeMensajeEntrante:
    """Idempotencia durable: el ``event_id`` se marca en la misma transacción del efecto."""

    def __init__(self, unidad: UnidadDeTrabajo | UnidadEnMemoria) -> None:
        self._unidad = unidad

    def procesar(self, evento: dict, consumidor: Callable[[dict], object]) -> bool:
        identificador = str(evento.get("eventId") or "")
        if not identificador:
            raise ValueError("El sobre no trae eventId: no se puede garantizar idempotencia.")
        if not self._unidad.marcar_entrante(identificador):
            return False
        consumidor(evento)
        return True


class PublicadorConBandeja:
    """Adaptador del puerto de publicación: sólo encola. El despacho lo hace el despachador."""

    def __init__(self, bandeja: BandejaDeSalida | BandejaDeSalidaEnMemoria) -> None:
        self._bandeja = bandeja

    def publicar(self, topico: str, evento: dict) -> None:
        self._bandeja.agregar(topico, evento)
