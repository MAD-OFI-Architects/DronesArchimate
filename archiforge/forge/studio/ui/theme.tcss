/* ArchiForge Studio — tema. Paleta definida en app.py (Theme "archiforge"); aquí solo composición. */
Screen { background: $background; }
Header { background: $panel; color: $text; }
Footer { background: $panel; }

.card {
    background: $surface;
    border: round $primary 60%;
    padding: 1 2;
    margin: 0 1 1 0;
}
.card > .card-title { color: $primary; text-style: bold; margin-bottom: 1; }
.muted { color: $text-muted; }
.accent { color: $accent; }
.good { color: $success; }
.bad { color: $error; }
.warn { color: $warning; }
.title { text-style: bold; color: $text; }

#logo { height: auto; padding: 1 2; color: $primary; text-style: bold; }
#tagline { color: $text-muted; padding: 0 2 1 2; }

Banner { height: auto; padding: 0 1; margin: 1 0; display: none; }
Banner.-visible { display: block; }
Banner.-ok { background: $success 15%; color: $success; border-left: thick $success; }
Banner.-warn { background: $warning 15%; color: $warning; border-left: thick $warning; }
Banner.-error { background: $error 15%; color: $error; border-left: thick $error; }
Banner.-info { background: $primary 15%; color: $text; border-left: thick $primary; }

Button { margin-right: 1; }
.buttons { height: auto; padding-top: 1; }

DataTable { height: 1fr; background: $surface; }
DataTable > .datatable--header { background: $panel; color: $primary; text-style: bold; }
DataTable > .datatable--cursor { background: $primary 35%; color: $text; }

Input { margin-bottom: 0; }
Input:focus { border: tall $accent; }
Select { margin-bottom: 0; }
.field-label { color: $text-muted; margin-top: 1; }

RichLog { background: $background; border: round $primary 40%; padding: 0 1; height: 1fr; }
SelectionList { height: auto; max-height: 18; background: $surface; border: round $primary 40%; }
TextArea { height: 5; margin-bottom: 1; }
TabbedContent { height: 1fr; }
TabPane { padding: 1 1; }

PathPicker { align: center middle; }
PathPicker > Vertical { width: 80%; height: 80%; background: $surface; border: round $accent; padding: 1 2; }
PathPicker DirectoryTree { height: 1fr; background: $background; }

HomeScreen #body { height: 1fr; }
HomeScreen #projects { width: 3fr; }
HomeScreen #about { width: 2fr; }

DomainsScreen #detail { height: 1fr; overflow-y: auto; }
DomainsScreen #portfolio { height: auto; max-height: 14; }

DomainsScreen #platform { height: auto; }

PlatformScreen #form { width: 3fr; overflow-y: auto; }
PlatformScreen #why { width: 2fr; overflow-y: auto; }

DecisionScreen #form { width: 3fr; overflow-y: auto; }
DecisionScreen #why { width: 2fr; overflow-y: auto; }

BuildScreen #opts { width: 2fr; overflow-y: auto; }
BuildScreen #run { width: 3fr; }
BuildScreen #progress { height: 12; }

.pathrow { height: auto; }
.pathrow Input { width: 1fr; }
.pathrow Button { width: auto; min-width: 14; }
.switch-row { height: 3; margin-top: 1; }
.switch-row Label { padding: 1 0 0 1; }
.pair { height: auto; }
.pair > Vertical { width: 1fr; height: auto; margin-right: 1; }
DomainsScreen #left { width: 5fr; }
DomainsScreen #right { width: 3fr; }

#where { height: auto; }
#where Input { height: 3; margin-bottom: 1; }
