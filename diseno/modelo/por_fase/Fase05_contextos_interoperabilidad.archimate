      <folder name="ACL" id="id-c26863261b5657fea3682cdb3151884d">
        <element xsi:type="archimate:ApplicationComponent" name="ACL – Programación de servicios" id="id-d96c0ca34e225058914143e6a9be7c9d">
          <documentation>ACL-01. Componente de adaptación entre «Programación de servicios a clientes» y el contexto que lo consume. Traduce: Servicio contratado → ventana de ocupación del dron; estado del dron → disponibilidad entregable.</documentation>
          <property key="ID" value="ACL-01"/>
          <property key="Traduce" value="Servicio contratado → ventana de ocupación del dron; estado del dron → disponibilidad entregable"/>
          <property key="Fase" value="5 (V9)"/>
          <property key="Fuente" value="P128; H-36"/>
        </element>
        <element xsi:type="archimate:ApplicationInterface" name="Interfaz hacia programación de servicios a clientes" id="id-a0632deb1e1057a98cb0c57457a0e2df">
          <documentation>Punto de acceso del ACL-01 hacia el externo.</documentation>
          <property key="ID" value="ACL-01"/>
          <property key="Fase" value="5 (V9)"/>
        </element>
        <element xsi:type="archimate:ApplicationService" name="Servicio de programación de servicios hacia el interior" id="id-14f9a0b44a16579a9ce27fc5c6f6920a">
          <documentation>Servicio que el ACL-01 ofrece al interior con el modelo propio.</documentation>
          <property key="ID" value="ACL-01"/>
          <property key="Fase" value="5 (V9)"/>
        </element>
        <element xsi:type="archimate:ApplicationComponent" name="ACL – Inventario y compras" id="id-b0eb53a8af0454b98513796e3ccc42a6">
          <documentation>ACL-02. Componente de adaptación entre «Inventario y compras de repuestos» y el contexto que lo consume. Traduce: Salida del kardex → consumo de repuesto; stock de bodega → existencia usable.</documentation>
          <property key="ID" value="ACL-02"/>
          <property key="Traduce" value="Salida del kardex → consumo de repuesto; stock de bodega → existencia usable"/>
          <property key="Fase" value="5 (V9)"/>
          <property key="Fuente" value="P129; H-36"/>
        </element>
        <element xsi:type="archimate:ApplicationInterface" name="Interfaz hacia inventario y compras de repuestos" id="id-877ce7de9dd25f139eece723098e5012">
          <documentation>Punto de acceso del ACL-02 hacia el externo.</documentation>
