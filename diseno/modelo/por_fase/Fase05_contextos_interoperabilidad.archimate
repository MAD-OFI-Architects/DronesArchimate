      <element xsi:type="archimate:ApplicationComponent" name="Flota y Componentes" id="id-9bf5f2968a5253a7b29b2d62a3546268">
        <documentation>Componente del contexto delimitado «Flota y Componentes» (Core). Saber qué drones hay, qué componentes lleva cada uno y cuánta vida les queda, con el contador pegado al componente.</documentation>
        <property key="Clasificación" value="Core"/>
        <property key="Fase" value="3 (V5)"/>
      </element>
      <element xsi:type="archimate:ApplicationComponent" name="Plan de Mantenimiento" id="id-a9415f54aa14560ba9ce342ee3a245cf">
        <documentation>Componente del contexto delimitado «Plan de Mantenimiento» (Core). Decidir cuándo toca intervenir cada dron y componente y programar paradas sin chocar con los servicios.</documentation>
        <property key="Clasificación" value="Core"/>
        <property key="Fase" value="3 (V5)"/>
      </element>
      <element xsi:type="archimate:ApplicationComponent" name="Intervenciones" id="id-5fb2e8c1954e593cae010b56da9294f4">
        <documentation>Componente del contexto delimitado «Intervenciones» (Core). Ejecutar, liberar y cerrar el trabajo de mantenimiento dejando evidencia verificable.</documentation>
        <property key="Clasificación" value="Core"/>
        <property key="Fase" value="3 (V5)"/>
      </element>
      <element xsi:type="archimate:ApplicationComponent" name="Operación y Horas" id="id-d04e44283afb50d7bc04a22869194a8a">
        <documentation>Componente del contexto delimitado «Operación y Horas» (Soporte). Registrar las operaciones de vuelo y consolidar horas y ciclos en una entrada única.</documentation>
        <property key="Clasificación" value="Soporte"/>
        <property key="Fase" value="3 (V5)"/>
      </element>
      <element xsi:type="archimate:ApplicationComponent" name="Repuestos del Taller" id="id-92b6019b163950f9853d9de79388269c">
        <documentation>Componente del contexto delimitado «Repuestos del Taller» (Soporte). Reservar y consumir repuestos por OT y pedir reposición al tocar el mínimo.</documentation>
        <property key="Clasificación" value="Soporte"/>
        <property key="Fase" value="3 (V5)"/>
      </element>
      <element xsi:type="archimate:ApplicationComponent" name="Indicadores" id="id-1d94d416333e50b78640580977bade21">
        <documentation>Componente del contexto delimitado «Indicadores» (Soporte). Calcular disponibilidad, cumplimiento del plan, MTBF y costo por hora con una sola regla de conteo.</documentation>
        <property key="Clasificación" value="Soporte"/>
        <property key="Fase" value="3 (V5)"/>
      </element>
      <element xsi:type="archimate:ApplicationComponent" name="Habilitación de Personal" id="id-d662ac3df2dd524bb6e84b1913926797">
        <documentation>Componente del contexto delimitado «Habilitación de Personal» (Soporte). Saber qué técnico está habilitado para qué modelo y tarea (espejo de lo que administra Talento humano).</documentation>
        <property key="Clasificación" value="Soporte"/>
        <property key="Fase" value="3 (V5)"/>
      </element>
      <element xsi:type="archimate:ApplicationComponent" name="Evidencia y Reportes" id="id-76fa75960dc1538fafd0e6b34e3ba273">
        <documentation>Componente del contexto delimitado «Evidencia y Reportes» (Genérico). Entregar el histórico por dron a ingenios, aseguradora y autoridad en un día.</documentation>
        <property key="Clasificación" value="Genérico"/>
        <property key="Fase" value="3 (V5)"/>
      </element>
      <element xsi:type="archimate:ApplicationComponent" name="Notificaciones" id="id-7cb3fd0c3d9e5d8b8ebfcc5231fe9f07">
        <documentation>Componente del contexto delimitado «Notificaciones» (Genérico). Avisar por correo o WhatsApp vencimientos, paradas y habilitaciones por vencer.</documentation>
        <property key="Clasificación" value="Genérico"/>
        <property key="Fase" value="3 (V5)"/>
      </element>
    </folder>
