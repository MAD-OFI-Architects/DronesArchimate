        <element xsi:type="archimate:ApplicationComponent" name="ACL – Contabilidad y facturación" id="id-a41346af4ed35989965311426e0f5555">
          <documentation>ACL-06. Componente de adaptación entre «Contabilidad y facturación» y el contexto que lo consume. Traduce: Factura → costo por OT y por dron.</documentation>
          <property key="ID" value="ACL-06"/>
          <property key="Traduce" value="Factura → costo por OT y por dron"/>
          <property key="Fase" value="5 (V9)"/>
          <property key="Fuente" value="P133; H-27"/>
        </element>
        <element xsi:type="archimate:ApplicationInterface" name="Interfaz hacia contabilidad y facturación" id="id-a927b15a289b5847bc4c997d128f4155">
          <documentation>Punto de acceso del ACL-06 hacia el externo.</documentation>
          <property key="ID" value="ACL-06"/>
          <property key="Fase" value="5 (V9)"/>
        </element>
        <element xsi:type="archimate:ApplicationService" name="Servicio de contabilidad y facturación hacia el interior" id="id-11362f2521b4569db0ff956da35579ae">
          <documentation>Servicio que el ACL-06 ofrece al interior con el modelo propio.</documentation>
          <property key="ID" value="ACL-06"/>
          <property key="Fase" value="5 (V9)"/>
        </element>
        <element xsi:type="archimate:ApplicationComponent" name="ACL – Fabricante y distribuidor" id="id-6f3ad6e4e8665c559c2f8a5bbeffa14d">
          <documentation>ACL-07. Componente de adaptación entre «Soporte, garantías y boletines del fabricante» y el contexto que lo consume. Traduce: Boletín → nueva versión del plan por modelo (fuente = manual).</documentation>
          <property key="ID" value="ACL-07"/>
          <property key="Traduce" value="Boletín → nueva versión del plan por modelo (fuente = manual)"/>
          <property key="Fase" value="5 (V9)"/>
          <property key="Fuente" value="P106, P133; H-15"/>
        </element>
        <element xsi:type="archimate:ApplicationInterface" name="Interfaz hacia soporte, garantías y boletines del fabricante" id="id-a4784a80278956dbaddfcaf3a8c17ab1">
          <documentation>Punto de acceso del ACL-07 hacia el externo.</documentation>
          <property key="ID" value="ACL-07"/>
          <property key="Fase" value="5 (V9)"/>
        </element>
        <element xsi:type="archimate:ApplicationService" name="Servicio de fabricante y distribuidor hacia el interior" id="id-5b8a1f5588c556379cc3b2895519477a">
          <documentation>Servicio que el ACL-07 ofrece al interior con el modelo propio.</documentation>
          <property key="ID" value="ACL-07"/>
          <property key="Fase" value="5 (V9)"/>
        </element>
        <element xsi:type="archimate:ApplicationComponent" name="ACL – Aseguradora" id="id-f27966aa38005a6789c05ded124e99c2">
          <documentation>ACL-08. Componente de adaptación entre «Cobertura de seguros» y el contexto que lo consume. Traduce: OT y bitácora → paquete de evidencia del siniestro.</documentation>
          <property key="ID" value="ACL-08"/>
          <property key="Traduce" value="OT y bitácora → paquete de evidencia del siniestro"/>
          <property key="Fase" value="5 (V9)"/>
          <property key="Fuente" value="P121, P133; H-05"/>
        </element>
        <element xsi:type="archimate:ApplicationInterface" name="Interfaz hacia cobertura de seguros" id="id-60e52db73de95b54bf3289c115182144">
          <documentation>Punto de acceso del ACL-08 hacia el externo.</documentation>
          <property key="ID" value="ACL-08"/>
          <property key="Fase" value="5 (V9)"/>
        </element>
        <element xsi:type="archimate:ApplicationService" name="Servicio de aseguradora hacia el interior" id="id-ababe05d6e835479a31f95a9b93cdfd1">
          <documentation>Servicio que el ACL-08 ofrece al interior con el modelo propio.</documentation>
          <property key="ID" value="ACL-08"/>
          <property key="Fase" value="5 (V9)"/>
        </element>
        <element xsi:type="archimate:ApplicationComponent" name="ACL – Clientes (auditoría)" id="id-d91bb4d78e655617bc31f05a1fac00f7">
          <documentation>ACL-09. Componente de adaptación entre «Auditoría comercial de clientes» y el contexto que lo consume. Traduce: Histórico por dron → informe por contrato.</documentation>
          <property key="ID" value="ACL-09"/>
          <property key="Traduce" value="Histórico por dron → informe por contrato"/>
          <property key="Fase" value="5 (V9)"/>
          <property key="Fuente" value="P133, P137"/>
        </element>
        <element xsi:type="archimate:ApplicationInterface" name="Interfaz hacia auditoría comercial de clientes" id="id-0b6b338812bf5160949ad8188f0e0de4">
          <documentation>Punto de acceso del ACL-09 hacia el externo.</documentation>
          <property key="ID" value="ACL-09"/>
          <property key="Fase" value="5 (V9)"/>
        </element>
        <element xsi:type="archimate:ApplicationService" name="Servicio de clientes (auditoría) hacia el interior" id="id-f2adeb3cc7ef59aa974331c33ad0b8af">
          <documentation>Servicio que el ACL-09 ofrece al interior con el modelo propio.</documentation>
          <property key="ID" value="ACL-09"/>
          <property key="Fase" value="5 (V9)"/>
        </element>
        <element xsi:type="archimate:ApplicationComponent" name="ACL – Gestor de residuos" id="id-cdba3d739e2556c59b68a09ab6f79d5c">
          <documentation>ACL-10. Componente de adaptación entre «Gestión de residuos y posconsumo» y el contexto que lo consume. Traduce: Certificado de disposición → disposición del componente.</documentation>
          <property key="ID" value="ACL-10"/>
          <property key="Traduce" value="Certificado de disposición → disposición del componente"/>
          <property key="Fase" value="5 (V9)"/>
          <property key="Fuente" value="P54, P63, P119; H-09"/>
        </element>
        <element xsi:type="archimate:ApplicationInterface" name="Interfaz hacia gestión de residuos y posconsumo" id="id-238eb5f800f15e989e2cfb5ed5206b28">
