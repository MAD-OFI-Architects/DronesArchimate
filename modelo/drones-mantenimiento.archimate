        </element>
        <element xsi:type="archimate:BusinessService" name="Telemetría de vuelo del fabricante" id="id-bed984175ff853f0ac3c0423f0050cd4">
          <documentation>ACL-03. Servicio externo (Proveedor / dispositivo (DJI y XAG)). Información: ← horas de motor por dron, ciclos y salud por batería (por ID), voltajes, alarmas, errores de motor/ESC, rutas y litros.</documentation>
          <property key="Alcance" value="Externo (se consume por la capa anticorrupción)"/>
          <property key="ID" value="ACL-03"/>
          <property key="Externo" value="Sí"/>
          <property key="Dueño" value="Cuenta DJI de la empresa (el dato vive en la nube del fabricante)"/>
          <property key="Fase" value="2 (V4)"/>
          <property key="Fuente" value="P130; H-26, H-35"/>
        </element>
        <element xsi:type="archimate:BusinessService" name="Certificaciones de personal" id="id-74547f2f531553cda49b522cfeb6888c">
          <documentation>ACL-04. Servicio externo (Proceso interno (Administración / Talento humano)). Información: ← certificaciones vigentes con vencimientos y disponibilidad de técnicos. → tareas firmadas, horas-hombre y necesidades de formación.</documentation>
          <property key="Alcance" value="Externo (se consume por la capa anticorrupción)"/>
          <property key="ID" value="ACL-04"/>
          <property key="Externo" value="Sí"/>
          <property key="Dueño" value="Marta"/>
          <property key="Fase" value="2 (V4)"/>
          <property key="Fuente" value="P131; H-04"/>
        </element>
        <element xsi:type="archimate:BusinessService" name="Registro y supervisión aeronáutica" id="id-bd0ea5c75b145ecea6d2d117739753a5">
          <documentation>ACL-05. Servicio externo (Entidad regulatoria (Aerocivil, UAS Colombia)). Información: → registros de mantenimiento, bitácoras y evidencias para inspección; reportes de ocurrencias. ← requisitos (RAC 100), certificados y registros.</documentation>
          <property key="Alcance" value="Externo (se consume por la capa anticorrupción)"/>
          <property key="ID" value="ACL-05"/>
          <property key="Externo" value="Sí"/>
          <property key="Dueño" value="Marta (papeles); Don Hernando (responsable legal)"/>
          <property key="Fase" value="2 (V4)"/>
          <property key="Fuente" value="P132; H-02, H-03"/>
        </element>
        <element xsi:type="archimate:BusinessService" name="Contabilidad y facturación" id="id-150f0bc577e757a384f369c2b1fce1ff">
          <documentation>ACL-06. Servicio externo (Proceso interno (Administración)). Información: ← facturas de repuestos y servicios (costos). → costos por OT, horas-hombre y consumos.</documentation>
          <property key="Alcance" value="Externo (se consume por la capa anticorrupción)"/>
          <property key="ID" value="ACL-06"/>
          <property key="Externo" value="Sí"/>
          <property key="Dueño" value="Marta"/>
          <property key="Fase" value="2 (V4)"/>
          <property key="Fuente" value="P133; H-27"/>
        </element>
        <element xsi:type="archimate:BusinessService" name="Soporte, garantías y boletines del fabricante" id="id-1838a1d07d94534ba6d1e00fbdfe3788">
          <documentation>ACL-07. Servicio externo (Proveedor (distribuidor DJI de Cali, fabricantes)). Información: ← boletines de servicio, firmware, intervalos del manual y respuesta a garantías. → reclamos con serie, fecha, factura y evidencia de uso.</documentation>
          <property key="Alcance" value="Externo (se consume por la capa anticorrupción)"/>
          <property key="ID" value="ACL-07"/>
          <property key="Externo" value="Sí"/>
          <property key="Dueño" value="Distribuidor y fabricantes"/>
          <property key="Fase" value="2 (V4)"/>
          <property key="Fuente" value="P106, P133; H-15"/>
        </element>
        <element xsi:type="archimate:BusinessService" name="Cobertura de seguros" id="id-8345fb3e0f6a58daafb4ea3f47752bd2">
          <documentation>ACL-08. Servicio externo (Proveedor (aseguradora)). Información: → evidencia de mantenimiento (OTs y bitácoras) en siniestros. ← condiciones de la póliza.</documentation>
          <property key="Alcance" value="Externo (se consume por la capa anticorrupción)"/>
          <property key="ID" value="ACL-08"/>
          <property key="Externo" value="Sí"/>
          <property key="Dueño" value="Marta con Don Hernando"/>
          <property key="Fase" value="2 (V4)"/>
          <property key="Fuente" value="P121, P133; H-05"/>
        </element>
        <element xsi:type="archimate:BusinessService" name="Auditoría comercial de clientes" id="id-ebaa910b978c55058522cfe2274ff1be">
          <documentation>ACL-09. Servicio externo (Cliente (ingenios y agroempresas)). Información: → informes y evidencias de operación y mantenimiento por dron. ← solicitudes de auditoría.</documentation>
          <property key="Alcance" value="Externo (se consume por la capa anticorrupción)"/>
          <property key="ID" value="ACL-09"/>
          <property key="Externo" value="Sí"/>
          <property key="Dueño" value="Sandra y Pompilio"/>
          <property key="Fase" value="2 (V4)"/>
          <property key="Fuente" value="P133, P137"/>
        </element>
        <element xsi:type="archimate:BusinessService" name="Gestión de residuos y posconsumo" id="id-8c7a6110ebbe5784b12698e4e5dc1896">
          <documentation>ACL-10. Servicio externo (Proveedor (gestor de residuos)). Información: → batería retirada para disposición. ← certificado de disposición.</documentation>
          <property key="Alcance" value="Externo (se consume por la capa anticorrupción)"/>
          <property key="ID" value="ACL-10"/>
          <property key="Externo" value="Sí"/>
          <property key="Dueño" value="Gestor de residuos y Marta"/>
          <property key="Fase" value="2 (V4)"/>
          <property key="Fuente" value="P54, P63, P119; H-09"/>
        </element>
      </folder>
      <folder name="Fuera del alcance" id="id-78176299dc82584e99ee58087bb54979">
        <element xsi:type="archimate:BusinessService" name="Planeación de misiones de vuelo" id="id-1b96b8e5826058268633823632f61474">
          <documentation>Excluido: La solicitud pide registrar los resultados del vuelo, no planear misiones (P155). Lo cubre: Pilotos con la app del fabricante.</documentation>
          <property key="Alcance" value="Excluido"/>
          <property key="Criterio principal" value="Alcance de la solicitud"/>
          <property key="Lo cubre" value="Pilotos con la app del fabricante"/>
          <property key="Fase" value="2 (V4)"/>
          <property key="Fuente" value="H-38"/>
        </element>
        <element xsi:type="archimate:BusinessService" name="Facturación por hectárea" id="id-ee8a1eaf188a5498b864944a9fa0d2ed">
          <documentation>Excluido: Fuera del alcance; factura Administración contra el informe firmado (P152). Lo cubre: Administración (Marta).</documentation>
          <property key="Alcance" value="Excluido"/>
          <property key="Criterio principal" value="Alcance de la solicitud"/>
          <property key="Lo cubre" value="Administración (Marta)"/>
          <property key="Fase" value="2 (V4)"/>
          <property key="Fuente" value="H-25, H-38"/>
        </element>
        <element xsi:type="archimate:BusinessService" name="Nómina" id="id-d193e6753dc8580498ff3aae200e3c5d">
          <documentation>Excluido: Fuera del alcance (P155). Lo cubre: Administración (Marta).</documentation>
          <property key="Alcance" value="Excluido"/>
          <property key="Criterio principal" value="Alcance de la solicitud"/>
          <property key="Lo cubre" value="Administración (Marta)"/>
          <property key="Fase" value="2 (V4)"/>
          <property key="Fuente" value="H-38"/>
        </element>
        <element xsi:type="archimate:BusinessService" name="Contabilidad general" id="id-ef28ec3740445953bcc40f50d1453528">
          <documentation>Excluido: Ya resuelto; se consume el costo por OT (ACL-06) (P152). Lo cubre: Administración (Marta) y contador externo.</documentation>
          <property key="Alcance" value="Excluido"/>
          <property key="Criterio principal" value="Existencia de un proveedor"/>
          <property key="Lo cubre" value="Administración (Marta) y contador externo"/>
          <property key="Fase" value="2 (V4)"/>
          <property key="Fuente" value="H-38"/>
        </element>
        <element xsi:type="archimate:BusinessService" name="CRM y contratos de clientes" id="id-9133225d15785f1eaf2ab4448bc60e79">
          <documentation>Excluido: Ya resuelto en Comercial; la aplicación solo le entrega disponibilidad (ACL-01). Lo cubre: Comercial (Sandra).</documentation>
          <property key="Alcance" value="Excluido"/>
          <property key="Criterio principal" value="Existencia de un proveedor"/>
          <property key="Lo cubre" value="Comercial (Sandra)"/>
          <property key="Fase" value="2 (V4)"/>
          <property key="Fuente" value="H-38"/>
        </element>
        <element xsi:type="archimate:BusinessService" name="Inventario general de la empresa" id="id-3b921c2a7ed15161baa80b7d6ecb2b13">
          <documentation>Excluido: Solo se necesita el stock de repuestos del taller (P155, P156). Lo cubre: Almacén (Nubia).</documentation>
          <property key="Alcance" value="Excluido"/>
          <property key="Criterio principal" value="Alcance de la solicitud"/>
          <property key="Lo cubre" value="Almacén (Nubia)"/>
          <property key="Fase" value="2 (V4)"/>
          <property key="Fuente" value="H-38"/>
        </element>
        <element xsi:type="archimate:BusinessService" name="Compras y aprobación de compras" id="id-845918223d1d5065b05b893d9106cb43">
          <documentation>Excluido: Decisión D-04: la aplicación solo llega hasta la solicitud de reposición; comprar y aprobar es de otra área (P156). Lo cubre: Almacén, Administración y Gerencia.</documentation>
          <property key="Alcance" value="Excluido"/>
          <property key="Criterio principal" value="Madurez/commodity"/>
          <property key="Lo cubre" value="Almacén, Administración y Gerencia"/>
          <property key="Fase" value="2 (V4)"/>
          <property key="Fuente" value="H-30"/>
        </element>
        <element xsi:type="archimate:BusinessService" name="Gestión documental de certificaciones" id="id-d3d51b3d9cc05b1880d20fdee901e53a">
          <documentation>Excluido: La propiedad de los datos es de Administración; mantenimiento solo consulta la habilitación vigente (D-03). Lo cubre: Administración (Marta).</documentation>
          <property key="Alcance" value="Excluido"/>
          <property key="Criterio principal" value="Cohesión y propiedad de datos"/>
          <property key="Lo cubre" value="Administración (Marta)"/>
          <property key="Fase" value="2 (V4)"/>
          <property key="Fuente" value="H-04, H-06"/>
        </element>
        <element xsi:type="archimate:BusinessService" name="Telemetría y gestión de flota en la nube" id="id-de7a37a120b559c2ae889b86ad5816ca">
          <documentation>Excluido: Existe en el fabricante; no se construye, se importa (H-35). Lo cubre: Fabricante (DJI/XAG).</documentation>
          <property key="Alcance" value="Excluido"/>
          <property key="Criterio principal" value="Existencia de un proveedor"/>
          <property key="Lo cubre" value="Fabricante (DJI/XAG)"/>
          <property key="Fase" value="2 (V4)"/>
          <property key="Fuente" value="H-35"/>
        </element>
        <element xsi:type="archimate:BusinessService" name="Trámites de registro y renovación ante la Aerocivil" id="id-545f220959475fd18c019251eacb0eaf">
          <documentation>Excluido: Los hace Administración en UAS Colombia; la aplicación solo aporta la evidencia (ACL-05). Lo cubre: Administración (Marta).</documentation>
          <property key="Alcance" value="Excluido"/>
          <property key="Criterio principal" value="Existencia de un proveedor"/>
          <property key="Lo cubre" value="Administración (Marta)"/>
          <property key="Fase" value="2 (V4)"/>
          <property key="Fuente" value="H-02"/>
        </element>
        <element xsi:type="archimate:BusinessService" name="Mantenimiento predictivo con analítica avanzada" id="id-57f3207403fe5d4f935f13bab60b1c78">
          <documentation>Excluido: Hoy solo el 5 % es por condición; se trata como condición de estado en el plan; analítica avanzada excede el alcance y el presupuesto. Lo cubre: Mantenimiento por condición dentro del plan.</documentation>
          <property key="Alcance" value="Excluido"/>
          <property key="Criterio principal" value="Costo/beneficio y riesgo"/>
          <property key="Lo cubre" value="Mantenimiento por condición dentro del plan"/>
          <property key="Fase" value="2 (V4)"/>
          <property key="Fuente" value="H-27"/>
        </element>
        <element xsi:type="archimate:BusinessService" name="Gestión de SST y exámenes ocupacionales" id="id-a1d8a53a53fb532198138c2879713698">
          <documentation>Excluido: Es de Administración y del SG-SST; la aplicación solo respeta la habilitación de técnicos. Lo cubre: Administración (Marta).</documentation>
          <property key="Alcance" value="Excluido"/>
          <property key="Criterio principal" value="Madurez/commodity"/>
          <property key="Lo cubre" value="Administración (Marta)"/>
          <property key="Fase" value="2 (V4)"/>
          <property key="Fuente" value="H-10"/>
        </element>
      </folder>
    </folder>
    <folder name="Objetos y contratos" id="id-7cd820c8eead53789cb2ead97a45e4ba">
      <folder name="Contratos de servicio" id="id-0ab4261e431c5cc995971b6485d76017">
        <element xsi:type="archimate:Contract" name="Contrato de programación de mantenimiento preventivo" id="id-32d41ea2716e50e8b7c59782558b2638">
          <documentation>Operaciones: Consultar vencimientos; Proponer programa semanal; Programar parada; Reprogramar parada; Diferir tarea. Entradas: Dron, horas y ciclos consolidados, calendario de servicios (ACL-01), existencias del taller (ACL-02). Salidas: Programa semanal con paradas, técnicos y repuestos reservados; lista de vencimientos. Errores: TAREA_CRITICA_NO_DIFERIBLE; BAHIAS_COMPLETAS; MISMA_LINEA_EN_TALLER; TECNICO_NO_HABILITADO; REPUESTO_NO_DISPONIBLE. Pre: plan por dron vigente y contadores informados. Post: cada parada con técnico habilitado y repuestos reservados. Consumidores: Jefe de Operaciones y Mantenimiento; Coordinación de servicios (consulta).</documentation>
          <property key="Servicio" value="Programación de mantenimiento preventivo"/>
          <property key="Versión" value="1.0.0"/>
          <property key="Nivel" value="N2"/>
          <property key="RNF" value="Disponibilidad 99 % en horario de taller (6:00-20:00); respuesta &lt; 2 s; acceso por rol; datos de personas bajo la Ley 1581/2012."/>
          <property key="Política de cambios" value="Agregar campos en lugar de modificar; versionar el contrato; avisar al catálogo de servicios"/>
          <property key="Fase" value="2 (V4)"/>
          <property key="Fuente" value="Metodología SOA P3 (Contract-First)"/>
        </element>
        <element xsi:type="archimate:Contract" name="Contrato de ejecución y liberación de intervenciones" id="id-0cada71205fa531995521625a9a9cab2">
          <documentation>Operaciones: Abrir orden; Registrar ejecución y consumos; Registrar vuelo de prueba; Liberar dron; Cerrar orden. Entradas: Parada programada, tareas, repuestos con serie, hallazgos, firma. Salidas: Orden de trabajo cerrada, dron liberado, contadores y relojes actualizados. Errores: LIBERA_EL_MISMO_QUE_EJECUTO; PRUEBA_DE_VUELO_PENDIENTE; SERIE_FALTANTE; ORDEN_CERRADA_INMUTABLE. Pre: parada programada y técnico habilitado. Post: relojes reiniciados y bitácora actualizada. Consumidores: Técnicos; Jefe de Operaciones y Mantenimiento; Almacenista.</documentation>
          <property key="Servicio" value="Ejecución y liberación de intervenciones"/>
          <property key="Versión" value="1.0.0"/>
          <property key="Nivel" value="N2"/>
          <property key="RNF" value="Disponibilidad 99 % en horario de taller (6:00-20:00); respuesta &lt; 2 s; acceso por rol; datos de personas bajo la Ley 1581/2012."/>
          <property key="Política de cambios" value="Agregar campos en lugar de modificar; versionar el contrato; avisar al catálogo de servicios"/>
          <property key="Fase" value="2 (V4)"/>
          <property key="Fuente" value="Metodología SOA P3 (Contract-First)"/>
        </element>
        <element xsi:type="archimate:Contract" name="Contrato de disponibilidad de la flota" id="id-778097bff13059868d4f732701507064">
          <documentation>Operaciones: Consultar estado del dron; Consultar disponibilidad por período; Consultar indicadores. Entradas: Estado de tareas y paradas, regla de conteo. Salidas: Estado verde/amarillo/rojo por dron, disponibilidad y tablero mensual. Errores: REGLA_DE_CONTEO_NO_DEFINIDA; DRON_SIN_PLAN. Pre: contadores al día. Post: una sola cifra por período y regla. Consumidores: Coordinación de servicios; Gerencia; Jefe de Operaciones y Mantenimiento.</documentation>
          <property key="Servicio" value="Disponibilidad de la flota"/>
          <property key="Versión" value="1.0.0"/>
          <property key="Nivel" value="N2"/>
          <property key="RNF" value="Disponibilidad 99 % en horario de taller (6:00-20:00); respuesta &lt; 2 s; acceso por rol; datos de personas bajo la Ley 1581/2012."/>
          <property key="Política de cambios" value="Agregar campos en lugar de modificar; versionar el contrato; avisar al catálogo de servicios"/>
          <property key="Fase" value="2 (V4)"/>
          <property key="Fuente" value="Metodología SOA P3 (Contract-First)"/>
        </element>
        <element xsi:type="archimate:Contract" name="Contrato de evidencia de mantenimiento" id="id-b424817b91ea5d3294bb0780af8119e6">
          <documentation>Operaciones: Generar histórico por dron; Exportar evidencia por destinatario. Entradas: Dron, rango de fechas, destinatario (ingenio, aseguradora, autoridad). Salidas: Paquete de evidencia: OTs, bitácora, consumos y series. Errores: HISTORIAL_INCOMPLETO; DESTINATARIO_NO_SOPORTADO. Pre: OTs cerradas con series. Post: entrega en menos de un día. Consumidores: Jefe de Operaciones y Mantenimiento; Gerencia.</documentation>
          <property key="Servicio" value="Evidencia de mantenimiento"/>
          <property key="Versión" value="1.0.0"/>
          <property key="Nivel" value="N2"/>
          <property key="RNF" value="Disponibilidad 99 % en horario de taller (6:00-20:00); respuesta &lt; 2 s; acceso por rol; datos de personas bajo la Ley 1581/2012."/>
          <property key="Política de cambios" value="Agregar campos en lugar de modificar; versionar el contrato; avisar al catálogo de servicios"/>
          <property key="Fase" value="2 (V4)"/>
          <property key="Fuente" value="Metodología SOA P3 (Contract-First)"/>
        </element>
        <element xsi:type="archimate:Contract" name="Contrato de registro de operación de flota" id="id-685c0f1acb6d512eba91ed46d931dce9">
          <documentation>Operaciones: Registrar jornada; Consolidar horas y ciclos; Importar telemetría. Entradas: Parte de vuelo, lecturas de telemetría, vuelos. Salidas: Registro de operación, horas de vuelo y ciclos por dron/componente. Errores: DUPLICADO; DISCREPANCIA_MAYOR_20H. Pre: dron existente. Post: un vuelo se cuenta una sola vez. Consumidores: sv_prog, sv_disp, sv_evid.</documentation>
          <property key="Servicio" value="Registro de operación de flota"/>
          <property key="Versión" value="1.0.0"/>
          <property key="Nivel" value="N3"/>
          <property key="RNF" value="Respuesta &lt; 2 s; trazabilidad de cambios; consistencia fuerte dentro del subdominio."/>
          <property key="Política de cambios" value="Agregar campos en lugar de modificar; versionar el contrato; avisar al catálogo de servicios"/>
          <property key="Fase" value="2 (V4)"/>
          <property key="Fuente" value="Metodología SOA P3 (Contract-First)"/>
        </element>
        <element xsi:type="archimate:Contract" name="Contrato de gestión de flota y componentes" id="id-e37bbec0ccc75219876c3d769c16a362">
          <documentation>Operaciones: Alta; Instalar/retirar componente; Consultar vida remanente. Entradas: Modelo, serie, posición, hora de corte. Salidas: Dron, componente instalado, vida remanente. Errores: POSICION_OCUPADA; COMPONENTE_RETIRADO. Pre: posición libre y componente utilizable. Post: contador viaja con el componente. Consumidores: sv_prog, sv_ejec, sv_evid.</documentation>
          <property key="Servicio" value="Gestión de flota y componentes"/>
          <property key="Versión" value="1.0.0"/>
          <property key="Nivel" value="N3"/>
          <property key="RNF" value="Respuesta &lt; 2 s; trazabilidad de cambios; consistencia fuerte dentro del subdominio."/>
          <property key="Política de cambios" value="Agregar campos en lugar de modificar; versionar el contrato; avisar al catálogo de servicios"/>
          <property key="Fase" value="2 (V4)"/>
          <property key="Fuente" value="Metodología SOA P3 (Contract-First)"/>
        </element>
        <element xsi:type="archimate:Contract" name="Contrato de gestión del plan de mantenimiento" id="id-109280fe904c5f7cb88769ef93f609d4">
          <documentation>Operaciones: Definir plan por modelo; Ajustar por dron; Evaluar vencimientos; Diferir; Programar parada. Entradas: Boletines, umbrales, contadores. Salidas: Plan versionado, vencimientos, paradas. Errores: UMBRAL_SIN_FUENTE; AJUSTE_MAS_LAXO_QUE_MANUAL. Pre: catálogo de intervalos. Post: cada umbral con fuente. Consumidores: sv_prog, sv_disp.</documentation>
          <property key="Servicio" value="Gestión del plan de mantenimiento"/>
          <property key="Versión" value="1.0.0"/>
          <property key="Nivel" value="N3"/>
          <property key="RNF" value="Respuesta &lt; 2 s; trazabilidad de cambios; consistencia fuerte dentro del subdominio."/>
          <property key="Política de cambios" value="Agregar campos en lugar de modificar; versionar el contrato; avisar al catálogo de servicios"/>
          <property key="Fase" value="2 (V4)"/>
          <property key="Fuente" value="Metodología SOA P3 (Contract-First)"/>
        </element>
        <element xsi:type="archimate:Contract" name="Contrato de gestión de órdenes de trabajo" id="id-6149dc67cf195ffa8427ab04dad003d6">
          <documentation>Operaciones: Abrir; Registrar; Liberar; Cerrar. Entradas: Parada, tareas, consumos. Salidas: OT y su historial. Errores: ORDEN_CERRADA_INMUTABLE. Pre: parada programada. Post: OT cerrada con series y horas de corte. Consumidores: sv_ejec, sv_evid.</documentation>
          <property key="Servicio" value="Gestión de órdenes de trabajo"/>
          <property key="Versión" value="1.0.0"/>
          <property key="Nivel" value="N3"/>
          <property key="RNF" value="Respuesta &lt; 2 s; trazabilidad de cambios; consistencia fuerte dentro del subdominio."/>
          <property key="Política de cambios" value="Agregar campos en lugar de modificar; versionar el contrato; avisar al catálogo de servicios"/>
          <property key="Fase" value="2 (V4)"/>
          <property key="Fuente" value="Metodología SOA P3 (Contract-First)"/>
        </element>
        <element xsi:type="archimate:Contract" name="Contrato de gestión de repuestos del taller" id="id-8255e694ce1c5151aba78964a16b8eec">
          <documentation>Operaciones: Reservar; Consultar existencia; Solicitar reposición. Entradas: Repuesto, cantidad, OT. Salidas: Reserva, existencia usable, solicitud. Errores: EXISTENCIA_INSUFICIENTE. Pre: referencia en catálogo. Post: reservado ≤ existencia. Consumidores: sv_prog, sv_ejec.</documentation>
          <property key="Servicio" value="Gestión de repuestos del taller"/>
          <property key="Versión" value="1.0.0"/>
          <property key="Nivel" value="N3"/>
