        <element xsi:type="archimate:ApplicationService" name="Servicio de gestor de residuos hacia el interior" id="id-38566dfe3b32535f944db6311127458b">
          <documentation>Servicio que el ACL-10 ofrece al interior con el modelo propio.</documentation>
          <property key="ID" value="ACL-10"/>
