      <folder name="ACL Externos" id="id-8cb290afc9805f968512a3e234abaa1b">
        <element xsi:type="archimate:BusinessService" name="Programación de servicios a clientes" id="id-1ca46e4278d156589bf63b5d86e81d9a">
          <documentation>ACL-01. Servicio externo (Proceso interno (Comercial)). Información: ← calendario de servicios (lote, hectáreas, fechas, horas estimadas ±20 %). → disponibilidad por dron (verde/amarillo/rojo), fechas de parada, horas remanentes y tope de drones prometibles.</documentation>
          <property key="Alcance" value="Externo (se consume por la capa anticorrupción)"/>
          <property key="ID" value="ACL-01"/>
          <property key="Externo" value="Sí"/>
          <property key="Dueño" value="Sandra (servicios); Pompilio (disponibilidad)"/>
          <property key="Fase" value="2 (V4)"/>
          <property key="Fuente" value="P128; H-36"/>
        </element>
        <element xsi:type="archimate:BusinessService" name="Inventario y compras de repuestos" id="id-1a77442a538d5ef7822dc884237ae4c5">
          <documentation>ACL-02. Servicio externo (Proceso interno (Almacén y Administración)). Información: ← existencias, ubicación, reservas y tiempos de entrega. → requerimiento por OT, consumos reales, solicitudes de reposición y kit de temporada.</documentation>
          <property key="Alcance" value="Externo (se consume por la capa anticorrupción)"/>
          <property key="ID" value="ACL-02"/>
          <property key="Externo" value="Sí"/>
          <property key="Dueño" value="Nubia; aprueban Pompilio (≤ $5 M) y Don Hernando (&gt; $5 M)"/>
          <property key="Fase" value="2 (V4)"/>
          <property key="Fuente" value="P129; H-36"/>
        </element>
        <element xsi:type="archimate:BusinessService" name="Telemetría de vuelo del fabricante" id="id-bed984175ff853f0ac3c0423f0050cd4">
          <documentation>ACL-03. Servicio externo (Proveedor / dispositivo (DJI y XAG)). Información: ← horas de motor por dron, ciclos y salud por batería (por ID), voltajes, alarmas, errores de motor/ESC, rutas y litros.</documentation>
          <property key="Alcance" value="Externo (se consume por la capa anticorrupción)"/>
          <property key="ID" value="ACL-03"/>
          <property key="Externo" value="Sí"/>
          <property key="Dueño" value="Cuenta DJI de la empresa (el dato vive en la nube del fabricante)"/>
          <property key="Fase" value="2 (V4)"/>
          <property key="Fuente" value="P130; H-26, H-35"/>
        </element>
        <element xsi:type="archimate:BusinessService" name="Certificaciones de personal" id="id-74547f2f531553cda49b522cfeb6888c">
          <documentation>ACL-04. Servicio externo (Proceso interno (Administración / Talento humano)). Información: ← certificaciones vigentes con vencimientos y disponibilidad de técnicos. → tareas firmadas, horas-hombre y necesidades de formación.</documentation>
          <property key="Alcance" value="Externo (se consume por la capa anticorrupción)"/>
          <property key="ID" value="ACL-04"/>
          <property key="Externo" value="Sí"/>
          <property key="Dueño" value="Marta"/>
          <property key="Fase" value="2 (V4)"/>
          <property key="Fuente" value="P131; H-04"/>
        </element>
        <element xsi:type="archimate:BusinessService" name="Registro y supervisión aeronáutica" id="id-bd0ea5c75b145ecea6d2d117739753a5">
          <documentation>ACL-05. Servicio externo (Entidad regulatoria (Aerocivil, UAS Colombia)). Información: → registros de mantenimiento, bitácoras y evidencias para inspección; reportes de ocurrencias. ← requisitos (RAC 100), certificados y registros.</documentation>
          <property key="Alcance" value="Externo (se consume por la capa anticorrupción)"/>
          <property key="ID" value="ACL-05"/>
          <property key="Externo" value="Sí"/>
          <property key="Dueño" value="Marta (papeles); Don Hernando (responsable legal)"/>
          <property key="Fase" value="2 (V4)"/>
          <property key="Fuente" value="P132; H-02, H-03"/>
        </element>
        <element xsi:type="archimate:BusinessService" name="Contabilidad y facturación" id="id-150f0bc577e757a384f369c2b1fce1ff">
          <documentation>ACL-06. Servicio externo (Proceso interno (Administración)). Información: ← facturas de repuestos y servicios (costos). → costos por OT, horas-hombre y consumos.</documentation>
          <property key="Alcance" value="Externo (se consume por la capa anticorrupción)"/>
          <property key="ID" value="ACL-06"/>
          <property key="Externo" value="Sí"/>
          <property key="Dueño" value="Marta"/>
          <property key="Fase" value="2 (V4)"/>
          <property key="Fuente" value="P133; H-27"/>
        </element>
        <element xsi:type="archimate:BusinessService" name="Soporte, garantías y boletines del fabricante" id="id-1838a1d07d94534ba6d1e00fbdfe3788">
          <documentation>ACL-07. Servicio externo (Proveedor (distribuidor DJI de Cali, fabricantes)). Información: ← boletines de servicio, firmware, intervalos del manual y respuesta a garantías. → reclamos con serie, fecha, factura y evidencia de uso.</documentation>
          <property key="Alcance" value="Externo (se consume por la capa anticorrupción)"/>
          <property key="ID" value="ACL-07"/>
          <property key="Externo" value="Sí"/>
          <property key="Dueño" value="Distribuidor y fabricantes"/>
          <property key="Fase" value="2 (V4)"/>
          <property key="Fuente" value="P106, P133; H-15"/>
        </element>
        <element xsi:type="archimate:BusinessService" name="Cobertura de seguros" id="id-8345fb3e0f6a58daafb4ea3f47752bd2">
          <documentation>ACL-08. Servicio externo (Proveedor (aseguradora)). Información: → evidencia de mantenimiento (OTs y bitácoras) en siniestros. ← condiciones de la póliza.</documentation>
          <property key="Alcance" value="Externo (se consume por la capa anticorrupción)"/>
          <property key="ID" value="ACL-08"/>
          <property key="Externo" value="Sí"/>
          <property key="Dueño" value="Marta con Don Hernando"/>
          <property key="Fase" value="2 (V4)"/>
          <property key="Fuente" value="P121, P133; H-05"/>
        </element>
        <element xsi:type="archimate:BusinessService" name="Auditoría comercial de clientes" id="id-ebaa910b978c55058522cfe2274ff1be">
          <documentation>ACL-09. Servicio externo (Cliente (ingenios y agroempresas)). Información: → informes y evidencias de operación y mantenimiento por dron. ← solicitudes de auditoría.</documentation>
          <property key="Alcance" value="Externo (se consume por la capa anticorrupción)"/>
          <property key="ID" value="ACL-09"/>
          <property key="Externo" value="Sí"/>
          <property key="Dueño" value="Sandra y Pompilio"/>
          <property key="Fase" value="2 (V4)"/>
          <property key="Fuente" value="P133, P137"/>
        </element>
        <element xsi:type="archimate:BusinessService" name="Gestión de residuos y posconsumo" id="id-8c7a6110ebbe5784b12698e4e5dc1896">
          <documentation>ACL-10. Servicio externo (Proveedor (gestor de residuos)). Información: → batería retirada para disposición. ← certificado de disposición.</documentation>
          <property key="Alcance" value="Externo (se consume por la capa anticorrupción)"/>
          <property key="ID" value="ACL-10"/>
          <property key="Externo" value="Sí"/>
          <property key="Dueño" value="Gestor de residuos y Marta"/>
          <property key="Fase" value="2 (V4)"/>
          <property key="Fuente" value="P54, P63, P119; H-09"/>
        </element>
      </folder>
      <folder name="Fuera del alcance" id="id-78176299dc82584e99ee58087bb54979">
        <element xsi:type="archimate:BusinessService" name="Planeación de misiones de vuelo" id="id-1b96b8e5826058268633823632f61474">
          <documentation>Excluido: La solicitud pide registrar los resultados del vuelo, no planear misiones (P155). Lo cubre: Pilotos con la app del fabricante.</documentation>
