<?xml version="1.0" encoding="UTF-8"?>
<archimate:model xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:archimate="http://www.archimatetool.com/archimate" name="Drones - Mantenimiento Preventivo - Fase 2" id="id-984c5fcbf0045ba080b7aa388da82234" version="5.0.0">
  <purpose>Arquitectura de la aplicación de mantenimiento preventivo de la flota de drones de fumigación de AgroDrones del Valle S.A.S. (ArchiMate + DDD). Un solo modelo con las vistas V1 a V11. Modelo parcial: Fase 2.</purpose>
  <folder name="Strategy" id="id-34147471b29c55d19c1668ed90d3ea62" type="strategy">
    <folder name="Capacidades" id="id-f40e931e4e9d5ce1ad547e4f3e557390">
      <element xsi:type="archimate:Capability" name="Gestionar el cumplimiento aeronáutico (RAC 100)" id="id-0587ef32b41250bba49a050a9f8071dd">
        <documentation>La aplicación aporta los registros de mantenimiento que la norma y las inspecciones exigen; los trámites ante la Aerocivil siguen en administración.</documentation>
        <property key="Nivel" value="2"/>
        <property key="Impacto" value="Parcial"/>
        <property key="Fase" value="1 (V2)"/>
        <property key="Fuente" value="Entrevista P97-P104"/>
      </element>
      <element xsi:type="archimate:Capability" name="Registrar la operación de la flota" id="id-f899e7ddbdde524c9ed62a08e63bcb85">
        <documentation>Horas y ciclos por dron y componente: la base de todo (H-24).</documentation>
        <property key="Nivel" value="2"/>
        <property key="Impacto" value="Directa"/>
        <property key="Fase" value="1 (V2)"/>
        <property key="Fuente" value="Entrevista P97-P104"/>
      </element>
      <element xsi:type="archimate:Capability" name="Planificar el mantenimiento preventivo" id="id-a81a5dce229e572d9082fefa18174968">
        <documentation>Plan por dron con condiciones y programación semanal.</documentation>
        <property key="Nivel" value="2"/>
        <property key="Impacto" value="Directa"/>
        <property key="Fase" value="1 (V2)"/>
        <property key="Fuente" value="Entrevista P97-P104"/>
      </element>
      <element xsi:type="archimate:Capability" name="Ejecutar el mantenimiento" id="id-0bf826888f8e52b8a4ae83e1c90d33da">
        <documentation>OT con repuestos y cierre (preventivo y registro del correctivo).</documentation>
        <property key="Nivel" value="2"/>
        <property key="Impacto" value="Directa"/>
        <property key="Fase" value="1 (V2)"/>
        <property key="Fuente" value="Entrevista P97-P104"/>
      </element>
      <element xsi:type="archimate:Capability" name="Liberar aeronaves" id="id-42def6526bcb536fad264759b955432c">
        <documentation>Liberación con rol distinto al ejecutor y vuelo de prueba.</documentation>
        <property key="Nivel" value="2"/>
        <property key="Impacto" value="Directa"/>
        <property key="Fase" value="1 (V2)"/>
        <property key="Fuente" value="Entrevista P97-P104"/>
      </element>
      <element xsi:type="archimate:Capability" name="Medir el desempeño de la flota" id="id-25feff921037517ab413e0a24a1e28bb">
        <documentation>Indicadores de disponibilidad, cumplimiento, MTBF y costo por hora.</documentation>
        <property key="Nivel" value="2"/>
        <property key="Impacto" value="Directa"/>
        <property key="Fase" value="1 (V2)"/>
        <property key="Fuente" value="Entrevista P97-P104"/>
      </element>
      <element xsi:type="archimate:Capability" name="Controlar las vigencias de certificaciones" id="id-011b8a1030635d708722ed645f35cf44">
        <documentation>La aplicación consulta quién está habilitado para cada modelo; las carpetas siguen en administración.</documentation>
        <property key="Nivel" value="2"/>
        <property key="Impacto" value="Parcial"/>
        <property key="Fase" value="1 (V2)"/>
        <property key="Fuente" value="Entrevista P97-P104"/>
      </element>
      <element xsi:type="archimate:Capability" name="Gestionar el inventario de repuestos del taller" id="id-a2e415a8771e590b95ceb3af9b73da45">
        <documentation>Reserva y consumo de repuestos del taller; el inventario general sigue fuera.</documentation>
        <property key="Nivel" value="2"/>
        <property key="Impacto" value="Parcial"/>
        <property key="Fase" value="1 (V2)"/>
        <property key="Fuente" value="Entrevista P97-P104"/>
      </element>
      <element xsi:type="archimate:Capability" name="Gestionar registros y bitácoras" id="id-cb843bd899b85445a1eca71637f055ee">
        <documentation>Mantener el orden: registros al día, trazables y exportables.</documentation>
        <property key="Nivel" value="2"/>
        <property key="Impacto" value="Directa"/>
        <property key="Fase" value="1 (V2)"/>
        <property key="Fuente" value="Entrevista P97-P104"/>
      </element>
    </folder>
  </folder>
  <folder name="Business" id="id-893f2996739259e9ab78a657579c1d16" type="business">
    <folder name="Procesos E2E" id="id-fb89bf8d05ce5abd922ef43b0797f4c1">
      <element xsi:type="archimate:BusinessProcess" name="Gestionar la disponibilidad de la flota por mantenimiento preventivo" id="id-fa0f126d63e758a4a131faa2d2d545f0">
        <documentation>Proceso E2E donde opera la aplicación: desde que se registra la operación (horas y ciclos) hasta que el dron queda liberado y los indicadores actualizados.</documentation>
        <property key="Fase" value="1 (V3)"/>
        <property key="Fuente" value="Entrevista P28-P29, P39; H-38"/>
      </element>
      <element xsi:type="archimate:BusinessProcess" name="Detectar intervención por vencer" id="id-9f498de3bd8d5f79878baa9284f22fcd">
        <documentation>Comparar horas, ciclos, calendario y estado contra el plan (hoy: Excel de los viernes).</documentation>
        <property key="Fase" value="1 (V3)"/>
        <property key="Alcance" value="Dentro (la aplicación lo apoya)"/>
        <property key="Fuente" value="Entrevista P29, P31"/>
      </element>
      <element xsi:type="archimate:BusinessProcess" name="Programar intervención" id="id-d76c0b128b4752e3b317ff07e5abb418">
        <documentation>Decidir fecha, técnico y repuestos en la reunión del lunes sin chocar con servicios.</documentation>
        <property key="Fase" value="1 (V3)"/>
        <property key="Alcance" value="Dentro (la aplicación lo apoya)"/>
        <property key="Fuente" value="Entrevista P32, P71-P75"/>
      </element>
      <element xsi:type="archimate:BusinessProcess" name="Alistar repuestos y bahía" id="id-93ca430a64e253d5aa63a7ba4486f5f1">
        <documentation>Abrir la OT, reservar repuestos y preparar la bahía.</documentation>
        <property key="Fase" value="1 (V3)"/>
        <property key="Alcance" value="Dentro (la aplicación lo apoya)"/>
        <property key="Fuente" value="Entrevista P29, P65"/>
      </element>
      <element xsi:type="archimate:BusinessProcess" name="Ejecutar intervención" id="id-c41fef20e5aa53cc9161b4327ea7678e">
        <documentation>Diagnóstico, desmonte, cambio, calibración y pruebas de banco.</documentation>
        <property key="Fase" value="1 (V3)"/>
        <property key="Alcance" value="Dentro (la aplicación lo apoya)"/>
        <property key="Fuente" value="Entrevista P33"/>
      </element>
      <element xsi:type="archimate:BusinessProcess" name="Verificar y liberar dron" id="id-d46e43f375a15d928f7a97226779d74b">
        <documentation>Autoverificación, vuelo de prueba y firma de liberación.</documentation>
        <property key="Fase" value="1 (V3)"/>
        <property key="Alcance" value="Dentro (la aplicación lo apoya)"/>
        <property key="Fuente" value="Entrevista P34; H-22, H-23"/>
      </element>
      <element xsi:type="archimate:BusinessProcess" name="Cerrar y registrar intervención" id="id-a2e569b3a63350db8cd9c2143cf83277">
        <documentation>Cerrar la OT, descontar repuestos, actualizar bitácora, costo y contadores.</documentation>
        <property key="Fase" value="1 (V3)"/>
        <property key="Alcance" value="Dentro (la aplicación lo apoya)"/>
        <property key="Fuente" value="Entrevista P35-P36"/>
      </element>
      <element xsi:type="archimate:BusinessFunction" name="Informar disponibilidad e indicadores" id="id-4e927707eb6c5c3688907cb87299fb5e">
        <documentation>Entrega estado del dron, disponibilidad y tablero mensual a Comercial y Gerencia.</documentation>
        <property key="Fase" value="1 (V3)"/>
        <property key="Alcance" value="Dentro"/>
        <property key="Fuente" value="Entrevista P92, P137"/>
      </element>
      <element xsi:type="archimate:BusinessFunction" name="Generar evidencia de mantenimiento" id="id-c642809378fe50d1a3a555a958ddf655">
        <documentation>Arma el histórico por dron para ingenios, aseguradora y autoridad.</documentation>
        <property key="Fase" value="1 (V3)"/>
        <property key="Alcance" value="Dentro"/>
        <property key="Fuente" value="Entrevista P92, P137"/>
      </element>
    </folder>
    <folder name="Actores y roles" id="id-4927194051415a20bc6c790fd3cf1d4d">
      <element xsi:type="archimate:BusinessRole" name="Jefe de Operaciones y Mantenimiento" id="id-fe933baa24f055b9a169327c644f668f">
        <documentation>Planea, programa, aprueba diferimientos y libera trabajos mayores.</documentation>
        <property key="Fase" value="1 (V3)"/>
        <property key="Fuente" value="Entrevista P22"/>
      </element>
      <element xsi:type="archimate:BusinessRole" name="Técnico de mantenimiento" id="id-174e56063e2956b599fa795edb6ab6b5">
        <documentation>Ejecuta la OT, firma el trabajo y recomienda no liberar.</documentation>
        <property key="Fase" value="1 (V3)"/>
        <property key="Fuente" value="Entrevista P22"/>
      </element>
      <element xsi:type="archimate:BusinessRole" name="Almacenista" id="id-d7d24a52818559fb97ffbc4ff765d552">
        <documentation>Lleva el kardex, reserva y entrega repuestos contra la OT.</documentation>
        <property key="Fase" value="1 (V3)"/>
        <property key="Fuente" value="Entrevista P22"/>
      </element>
      <element xsi:type="archimate:BusinessRole" name="Coordinación de servicios" id="id-1bd6113d50e1511995b17f78c34a8099">
        <documentation>Contrata y agenda servicios; trae el calendario al lunes.</documentation>
        <property key="Fase" value="1 (V3)"/>
        <property key="Fuente" value="Entrevista P22"/>
      </element>
      <element xsi:type="archimate:BusinessRole" name="Gerencia" id="id-1fab8651b5d355da88715c93f2e10a69">
        <documentation>Aprueba gastos mayores y es responsable de la seguridad operacional.</documentation>
        <property key="Fase" value="1 (V3)"/>
        <property key="Fuente" value="Entrevista P22"/>
      </element>
    </folder>
    <folder name="Servicios (por capa)" id="id-3c757a8e9348502c9ad2c01e6c2f61d5">
      <folder name="N2 Plataforma" id="id-b3e94629094f528e8e6a038b8e10f123">
        <element xsi:type="archimate:BusinessService" name="Programación de mantenimiento preventivo" id="id-f078f3a148c457e190f0eabeae768ad8">
          <documentation>Servicio de negocio de plataforma. Es el valor central de la solicitud: decidir cuándo entra cada dron sin chocar con servicios (P71-P73). Orquesta plan, flota, repuestos y habilitación.</documentation>
          <property key="Nivel" value="N2"/>
          <property key="Alcance" value="Incluido"/>
          <property key="Criterio principal" value="Valor estratégico"/>
          <property key="Fase" value="2 (V4)"/>
          <property key="Fuente" value="Entrevista + hallazgos"/>
        </element>
        <element xsi:type="archimate:BusinessService" name="Ejecución y liberación de intervenciones" id="id-19a5a7478e865189bce5c792bc720560">
          <documentation>Servicio de negocio de plataforma. Ejecutar y liberar el trabajo con repuestos y firma es parte explícita del alcance (P146).</documentation>
          <property key="Nivel" value="N2"/>
          <property key="Alcance" value="Incluido"/>
          <property key="Criterio principal" value="Alcance de la solicitud"/>
          <property key="Fase" value="2 (V4)"/>
          <property key="Fuente" value="Entrevista + hallazgos"/>
        </element>
        <element xsi:type="archimate:BusinessService" name="Disponibilidad de la flota" id="id-4506d7bb8ff557f78630054a5d088fac">
          <documentation>Servicio de negocio de plataforma. Responde al riesgo n.º 1 del negocio (flota disponible en pico) y a la pregunta de Comercial «¿cuántos drones puedo prometer?» (P92, P139).</documentation>
          <property key="Nivel" value="N2"/>
          <property key="Alcance" value="Incluido"/>
          <property key="Criterio principal" value="Valor estratégico"/>
          <property key="Fase" value="2 (V4)"/>
          <property key="Fuente" value="Entrevista + hallazgos"/>
        </element>
        <element xsi:type="archimate:BusinessService" name="Evidencia de mantenimiento" id="id-16c870b559aa5e27937e89e653a37dd1">
          <documentation>Servicio de negocio de plataforma. Auditorías de ingenios, aseguradora y autoridad exigen histórico por dron; hoy toma días (P137, H-05).</documentation>
          <property key="Nivel" value="N2"/>
          <property key="Alcance" value="Incluido"/>
          <property key="Criterio principal" value="Costo/beneficio y riesgo"/>
          <property key="Fase" value="2 (V4)"/>
          <property key="Fuente" value="Entrevista + hallazgos"/>
        </element>
      </folder>
      <folder name="N3 Subdominio" id="id-51f421c80b025923876b4b5208b8aa46">
        <element xsi:type="archimate:BusinessService" name="Registro de operación de flota" id="id-cc7368ffd4ed5867b06ba464e62764b0">
          <documentation>Servicio de subdominio. Horas y ciclos a partir de las operaciones es el primer requerimiento de la solicitud y la función más urgente (P149).</documentation>
          <property key="Nivel" value="N3"/>
          <property key="Alcance" value="Incluido"/>
          <property key="Criterio principal" value="Alcance de la solicitud"/>
          <property key="Fase" value="2 (V4)"/>
          <property key="Fuente" value="Entrevista + hallazgos"/>
        </element>
        <element xsi:type="archimate:BusinessService" name="Gestión de flota y componentes" id="id-e392bbd21abf5f0482a4d15428ae4345">
          <documentation>Servicio de subdominio. El contador pertenece al componente y viaja con él; hoy es el punto más frágil (H-20, H-21).</documentation>
          <property key="Nivel" value="N3"/>
          <property key="Alcance" value="Incluido"/>
          <property key="Criterio principal" value="Cohesión y propiedad de datos"/>
          <property key="Fase" value="2 (V4)"/>
          <property key="Fuente" value="Entrevista + hallazgos"/>
        </element>
        <element xsi:type="archimate:BusinessService" name="Gestión del plan de mantenimiento" id="id-397e5405b2a655d6927449071084134e">
          <documentation>Servicio de subdominio. Condiciones por horas, ciclos, calendario o estado por componente: el conocimiento que hoy vive en el Excel del jefe (P68-P70).</documentation>
          <property key="Nivel" value="N3"/>
          <property key="Alcance" value="Incluido"/>
          <property key="Criterio principal" value="Valor estratégico"/>
          <property key="Fase" value="2 (V4)"/>
          <property key="Fuente" value="Entrevista + hallazgos"/>
        </element>
        <element xsi:type="archimate:BusinessService" name="Gestión de órdenes de trabajo" id="id-40e1621e8a4c5dc084de1ea902f4dd64">
          <documentation>Servicio de subdominio. OT digital con repuestos y cierre; incluye registrar el correctivo con la misma OT marcada «C» (D-02).</documentation>
          <property key="Nivel" value="N3"/>
          <property key="Alcance" value="Incluido"/>
          <property key="Criterio principal" value="Alcance de la solicitud"/>
          <property key="Fase" value="2 (V4)"/>
          <property key="Fuente" value="Entrevista + hallazgos"/>
        </element>
        <element xsi:type="archimate:BusinessService" name="Gestión de repuestos del taller" id="id-9bc675c26948516091b6a138ddd7c286">
          <documentation>Servicio de subdominio. Reserva y consumo de repuestos por OT; el stock del taller está dentro del alcance, el inventario general no (P156).</documentation>
          <property key="Nivel" value="N3"/>
          <property key="Alcance" value="Incluido"/>
          <property key="Criterio principal" value="Cohesión y propiedad de datos"/>
          <property key="Fase" value="2 (V4)"/>
          <property key="Fuente" value="Entrevista + hallazgos"/>
        </element>
        <element xsi:type="archimate:BusinessService" name="Gestión de indicadores de mantenimiento" id="id-dea755b8788153dd850fc05146dcc70e">
          <documentation>Servicio de subdominio. Los cuatro indicadores de la solicitud con una única regla de conteo (H-28).</documentation>
          <property key="Nivel" value="N3"/>
          <property key="Alcance" value="Incluido"/>
          <property key="Criterio principal" value="Alcance de la solicitud"/>
          <property key="Fase" value="2 (V4)"/>
          <property key="Fuente" value="Entrevista + hallazgos"/>
        </element>
        <element xsi:type="archimate:BusinessService" name="Verificación de habilitación de técnicos" id="id-a992451b9a0c506898a5ee2f25e62bad">
          <documentation>Servicio de subdominio. Decisión D-03: se consulta quién puede hacer qué (curso del modelo vigente); las carpetas siguen en Administración.</documentation>
          <property key="Nivel" value="N3"/>
          <property key="Alcance" value="Incluido"/>
          <property key="Criterio principal" value="Costo/beneficio y riesgo"/>
          <property key="Fase" value="2 (V4)"/>
          <property key="Fuente" value="Entrevista + hallazgos"/>
        </element>
      </folder>
      <folder name="N4 Básicos" id="id-896bde7c6ba05e768fc9faa881b73fa4">
        <element xsi:type="archimate:BusinessService" name="Consolidación de horas y ciclos" id="id-b9bdaa9943d15bd8a0c1c09b77896a9a">
          <documentation>Servicio básico del subdominio. Entrada única que reemplaza app + papel + WhatsApp (H-24).</documentation>
          <property key="Nivel" value="N4"/>
          <property key="Alcance" value="Incluido"/>
          <property key="Criterio principal" value="Alcance de la solicitud"/>
          <property key="Fase" value="2 (V4)"/>
          <property key="Fuente" value="Entrevista + hallazgos"/>
        </element>
        <element xsi:type="archimate:BusinessService" name="Importación de telemetría" id="id-1187f9d874ef5f9984a5c43a07cd6e39">
          <documentation>Servicio básico del subdominio. Carga idempotente de los archivos exportados del fabricante; no se construye la telemetría (H-35).</documentation>
          <property key="Nivel" value="N4"/>
          <property key="Alcance" value="Incluido"/>
          <property key="Criterio principal" value="Costo/beneficio y riesgo"/>
          <property key="Fase" value="2 (V4)"/>
          <property key="Fuente" value="Entrevista + hallazgos"/>
        </element>
        <element xsi:type="archimate:BusinessService" name="Conciliación de discrepancias de registro" id="id-dd6bf5f70b245835bf00ff5a6cb11555">
          <documentation>Servicio básico del subdominio. Para mantenimiento manda la plataforma; para facturar, el informe firmado (H-25).</documentation>
          <property key="Nivel" value="N4"/>
          <property key="Alcance" value="Incluido"/>
          <property key="Criterio principal" value="Cohesión y propiedad de datos"/>
          <property key="Fase" value="2 (V4)"/>
          <property key="Fuente" value="Entrevista + hallazgos"/>
        </element>
        <element xsi:type="archimate:BusinessService" name="Alta de dron y componente" id="id-9e8794bf4cb052f9ae3f8747c7d2ef20">
          <documentation>Servicio básico del subdominio. Crea la identidad (ID interno, serie) a partir del catálogo del modelo.</documentation>
          <property key="Nivel" value="N4"/>
          <property key="Alcance" value="Incluido"/>
          <property key="Criterio principal" value="Cohesión y propiedad de datos"/>
          <property key="Fase" value="2 (V4)"/>
          <property key="Fuente" value="Entrevista + hallazgos"/>
        </element>
        <element xsi:type="archimate:BusinessService" name="Instalación y retiro de componente" id="id-f0036917224e56078365999cbfddc133">
          <documentation>Servicio básico del subdominio. Registra movimientos entre drones con hora de corte (H-20, H-21).</documentation>
          <property key="Nivel" value="N4"/>
          <property key="Alcance" value="Incluido"/>
          <property key="Criterio principal" value="Cohesión y propiedad de datos"/>
          <property key="Fase" value="2 (V4)"/>
          <property key="Fuente" value="Entrevista + hallazgos"/>
        </element>
        <element xsi:type="archimate:BusinessService" name="Consulta de vida remanente" id="id-a22ca48116db5a0a9a02dac6ac65f440">
          <documentation>Servicio básico del subdominio. Lectura de la vida restante por componente para decidir si se mueve o se retira.</documentation>
          <property key="Nivel" value="N4"/>
          <property key="Alcance" value="Incluido"/>
          <property key="Criterio principal" value="Cohesión y propiedad de datos"/>
          <property key="Fase" value="2 (V4)"/>
          <property key="Fuente" value="Entrevista + hallazgos"/>
        </element>
        <element xsi:type="archimate:BusinessService" name="Evaluación de vencimientos" id="id-6ac93f7324d75c8bb340f84f74814253">
          <documentation>Servicio básico del subdominio. Aplica «lo que ocurra primero» sobre horas, ciclos, calendario y estado (H-17).</documentation>
          <property key="Nivel" value="N4"/>
          <property key="Alcance" value="Incluido"/>
          <property key="Criterio principal" value="Valor estratégico"/>
          <property key="Fase" value="2 (V4)"/>
          <property key="Fuente" value="Entrevista + hallazgos"/>
        </element>
        <element xsi:type="archimate:BusinessService" name="Parametrización del plan" id="id-9f70626d076059f09050678d6c4fde79">
          <documentation>Servicio básico del subdominio. Umbrales con su fuente (manual o interna) y versionado por boletín (H-15).</documentation>
          <property key="Nivel" value="N4"/>
          <property key="Alcance" value="Incluido"/>
          <property key="Criterio principal" value="Valor estratégico"/>
          <property key="Fase" value="2 (V4)"/>
          <property key="Fuente" value="Entrevista + hallazgos"/>
        </element>
        <element xsi:type="archimate:BusinessService" name="Diferimiento de intervención" id="id-e7ff8b86036553e5bf327ff264c32e5b">
          <documentation>Servicio básico del subdominio. Solo tareas menores, hasta 10 %, con autorización del jefe (H-19).</documentation>
          <property key="Nivel" value="N4"/>
          <property key="Alcance" value="Incluido"/>
          <property key="Criterio principal" value="Costo/beneficio y riesgo"/>
          <property key="Fase" value="2 (V4)"/>
          <property key="Fuente" value="Entrevista + hallazgos"/>
        </element>
        <element xsi:type="archimate:BusinessService" name="Programación de parada" id="id-9e3f0e86d92153fa88dfb00959a80acd">
          <documentation>Servicio básico del subdominio. Agrupa tareas en una parada respetando dos bahías y la regla de misma línea (P72-P74).</documentation>
          <property key="Nivel" value="N4"/>
          <property key="Alcance" value="Incluido"/>
          <property key="Criterio principal" value="Valor estratégico"/>
          <property key="Fase" value="2 (V4)"/>
          <property key="Fuente" value="Entrevista + hallazgos"/>
        </element>
