          <property key="Fuente" value="H-27"/>
        </element>
        <element xsi:type="archimate:BusinessService" name="Gestión de SST y exámenes ocupacionales" id="id-a1d8a53a53fb532198138c2879713698">
          <documentation>Excluido: Es de Administración y del SG-SST; la aplicación solo respeta la habilitación de técnicos. Lo cubre: Administración (Marta).</documentation>
          <property key="Alcance" value="Excluido"/>
          <property key="Criterio principal" value="Madurez/commodity"/>
          <property key="Lo cubre" value="Administración (Marta)"/>
          <property key="Fase" value="2 (V4)"/>
          <property key="Fuente" value="H-10"/>
        </element>
      </folder>
    </folder>
    <folder name="Objetos y contratos" id="id-7cd820c8eead53789cb2ead97a45e4ba">
      <folder name="Contratos de servicio" id="id-0ab4261e431c5cc995971b6485d76017">
        <element xsi:type="archimate:Contract" name="Contrato de programación de mantenimiento preventivo" id="id-32d41ea2716e50e8b7c59782558b2638">
          <documentation>Operaciones: Consultar vencimientos; Proponer programa semanal; Programar parada; Reprogramar parada; Diferir tarea. Entradas: Dron, horas y ciclos consolidados, calendario de servicios (ACL-01), existencias del taller (ACL-02). Salidas: Programa semanal con paradas, técnicos y repuestos reservados; lista de vencimientos. Errores: TAREA_CRITICA_NO_DIFERIBLE; BAHIAS_COMPLETAS; MISMA_LINEA_EN_TALLER; TECNICO_NO_HABILITADO; REPUESTO_NO_DISPONIBLE. Pre: plan por dron vigente y contadores informados. Post: cada parada con técnico habilitado y repuestos reservados. Consumidores: Jefe de Operaciones y Mantenimiento; Coordinación de servicios (consulta).</documentation>
          <property key="Servicio" value="Programación de mantenimiento preventivo"/>
          <property key="Versión" value="1.0.0"/>
          <property key="Nivel" value="N2"/>
          <property key="RNF" value="Disponibilidad 99 % en horario de taller (6:00-20:00); respuesta &lt; 2 s; acceso por rol; datos de personas bajo la Ley 1581/2012."/>
          <property key="Política de cambios" value="Agregar campos en lugar de modificar; versionar el contrato; avisar al catálogo de servicios"/>
          <property key="Fase" value="2 (V4)"/>
          <property key="Fuente" value="Metodología SOA P3 (Contract-First)"/>
        </element>
        <element xsi:type="archimate:Contract" name="Contrato de ejecución y liberación de intervenciones" id="id-0cada71205fa531995521625a9a9cab2">
          <documentation>Operaciones: Abrir orden; Registrar ejecución y consumos; Registrar vuelo de prueba; Liberar dron; Cerrar orden. Entradas: Parada programada, tareas, repuestos con serie, hallazgos, firma. Salidas: Orden de trabajo cerrada, dron liberado, contadores y relojes actualizados. Errores: LIBERA_EL_MISMO_QUE_EJECUTO; PRUEBA_DE_VUELO_PENDIENTE; SERIE_FALTANTE; ORDEN_CERRADA_INMUTABLE. Pre: parada programada y técnico habilitado. Post: relojes reiniciados y bitácora actualizada. Consumidores: Técnicos; Jefe de Operaciones y Mantenimiento; Almacenista.</documentation>
          <property key="Servicio" value="Ejecución y liberación de intervenciones"/>
          <property key="Versión" value="1.0.0"/>
          <property key="Nivel" value="N2"/>
          <property key="RNF" value="Disponibilidad 99 % en horario de taller (6:00-20:00); respuesta &lt; 2 s; acceso por rol; datos de personas bajo la Ley 1581/2012."/>
          <property key="Política de cambios" value="Agregar campos en lugar de modificar; versionar el contrato; avisar al catálogo de servicios"/>
          <property key="Fase" value="2 (V4)"/>
          <property key="Fuente" value="Metodología SOA P3 (Contract-First)"/>
        </element>
        <element xsi:type="archimate:Contract" name="Contrato de disponibilidad de la flota" id="id-778097bff13059868d4f732701507064">
          <documentation>Operaciones: Consultar estado del dron; Consultar disponibilidad por período; Consultar indicadores. Entradas: Estado de tareas y paradas, regla de conteo. Salidas: Estado verde/amarillo/rojo por dron, disponibilidad y tablero mensual. Errores: REGLA_DE_CONTEO_NO_DEFINIDA; DRON_SIN_PLAN. Pre: contadores al día. Post: una sola cifra por período y regla. Consumidores: Coordinación de servicios; Gerencia; Jefe de Operaciones y Mantenimiento.</documentation>
          <property key="Servicio" value="Disponibilidad de la flota"/>
          <property key="Versión" value="1.0.0"/>
          <property key="Nivel" value="N2"/>
          <property key="RNF" value="Disponibilidad 99 % en horario de taller (6:00-20:00); respuesta &lt; 2 s; acceso por rol; datos de personas bajo la Ley 1581/2012."/>
          <property key="Política de cambios" value="Agregar campos en lugar de modificar; versionar el contrato; avisar al catálogo de servicios"/>
          <property key="Fase" value="2 (V4)"/>
          <property key="Fuente" value="Metodología SOA P3 (Contract-First)"/>
        </element>
        <element xsi:type="archimate:Contract" name="Contrato de evidencia de mantenimiento" id="id-b424817b91ea5d3294bb0780af8119e6">
          <documentation>Operaciones: Generar histórico por dron; Exportar evidencia por destinatario. Entradas: Dron, rango de fechas, destinatario (ingenio, aseguradora, autoridad). Salidas: Paquete de evidencia: OTs, bitácora, consumos y series. Errores: HISTORIAL_INCOMPLETO; DESTINATARIO_NO_SOPORTADO. Pre: OTs cerradas con series. Post: entrega en menos de un día. Consumidores: Jefe de Operaciones y Mantenimiento; Gerencia.</documentation>
          <property key="Servicio" value="Evidencia de mantenimiento"/>
          <property key="Versión" value="1.0.0"/>
          <property key="Nivel" value="N2"/>
          <property key="RNF" value="Disponibilidad 99 % en horario de taller (6:00-20:00); respuesta &lt; 2 s; acceso por rol; datos de personas bajo la Ley 1581/2012."/>
          <property key="Política de cambios" value="Agregar campos en lugar de modificar; versionar el contrato; avisar al catálogo de servicios"/>
          <property key="Fase" value="2 (V4)"/>
          <property key="Fuente" value="Metodología SOA P3 (Contract-First)"/>
        </element>
        <element xsi:type="archimate:Contract" name="Contrato de registro de operación de flota" id="id-685c0f1acb6d512eba91ed46d931dce9">
          <documentation>Operaciones: Registrar jornada; Consolidar horas y ciclos; Importar telemetría. Entradas: Parte de vuelo, lecturas de telemetría, vuelos. Salidas: Registro de operación, horas de vuelo y ciclos por dron/componente. Errores: DUPLICADO; DISCREPANCIA_MAYOR_20H. Pre: dron existente. Post: un vuelo se cuenta una sola vez. Consumidores: sv_prog, sv_disp, sv_evid.</documentation>
          <property key="Servicio" value="Registro de operación de flota"/>
          <property key="Versión" value="1.0.0"/>
          <property key="Nivel" value="N3"/>
          <property key="RNF" value="Respuesta &lt; 2 s; trazabilidad de cambios; consistencia fuerte dentro del subdominio."/>
          <property key="Política de cambios" value="Agregar campos en lugar de modificar; versionar el contrato; avisar al catálogo de servicios"/>
          <property key="Fase" value="2 (V4)"/>
          <property key="Fuente" value="Metodología SOA P3 (Contract-First)"/>
        </element>
        <element xsi:type="archimate:Contract" name="Contrato de gestión de flota y componentes" id="id-e37bbec0ccc75219876c3d769c16a362">
          <documentation>Operaciones: Alta; Instalar/retirar componente; Consultar vida remanente. Entradas: Modelo, serie, posición, hora de corte. Salidas: Dron, componente instalado, vida remanente. Errores: POSICION_OCUPADA; COMPONENTE_RETIRADO. Pre: posición libre y componente utilizable. Post: contador viaja con el componente. Consumidores: sv_prog, sv_ejec, sv_evid.</documentation>
          <property key="Servicio" value="Gestión de flota y componentes"/>
          <property key="Versión" value="1.0.0"/>
          <property key="Nivel" value="N3"/>
          <property key="RNF" value="Respuesta &lt; 2 s; trazabilidad de cambios; consistencia fuerte dentro del subdominio."/>
          <property key="Política de cambios" value="Agregar campos en lugar de modificar; versionar el contrato; avisar al catálogo de servicios"/>
          <property key="Fase" value="2 (V4)"/>
          <property key="Fuente" value="Metodología SOA P3 (Contract-First)"/>
        </element>
        <element xsi:type="archimate:Contract" name="Contrato de gestión del plan de mantenimiento" id="id-109280fe904c5f7cb88769ef93f609d4">
          <documentation>Operaciones: Definir plan por modelo; Ajustar por dron; Evaluar vencimientos; Diferir; Programar parada. Entradas: Boletines, umbrales, contadores. Salidas: Plan versionado, vencimientos, paradas. Errores: UMBRAL_SIN_FUENTE; AJUSTE_MAS_LAXO_QUE_MANUAL. Pre: catálogo de intervalos. Post: cada umbral con fuente. Consumidores: sv_prog, sv_disp.</documentation>
          <property key="Servicio" value="Gestión del plan de mantenimiento"/>
          <property key="Versión" value="1.0.0"/>
          <property key="Nivel" value="N3"/>
          <property key="RNF" value="Respuesta &lt; 2 s; trazabilidad de cambios; consistencia fuerte dentro del subdominio."/>
          <property key="Política de cambios" value="Agregar campos en lugar de modificar; versionar el contrato; avisar al catálogo de servicios"/>
          <property key="Fase" value="2 (V4)"/>
          <property key="Fuente" value="Metodología SOA P3 (Contract-First)"/>
        </element>
        <element xsi:type="archimate:Contract" name="Contrato de gestión de órdenes de trabajo" id="id-6149dc67cf195ffa8427ab04dad003d6">
          <documentation>Operaciones: Abrir; Registrar; Liberar; Cerrar. Entradas: Parada, tareas, consumos. Salidas: OT y su historial. Errores: ORDEN_CERRADA_INMUTABLE. Pre: parada programada. Post: OT cerrada con series y horas de corte. Consumidores: sv_ejec, sv_evid.</documentation>
          <property key="Servicio" value="Gestión de órdenes de trabajo"/>
          <property key="Versión" value="1.0.0"/>
          <property key="Nivel" value="N3"/>
          <property key="RNF" value="Respuesta &lt; 2 s; trazabilidad de cambios; consistencia fuerte dentro del subdominio."/>
          <property key="Política de cambios" value="Agregar campos en lugar de modificar; versionar el contrato; avisar al catálogo de servicios"/>
          <property key="Fase" value="2 (V4)"/>
          <property key="Fuente" value="Metodología SOA P3 (Contract-First)"/>
        </element>
        <element xsi:type="archimate:Contract" name="Contrato de gestión de repuestos del taller" id="id-8255e694ce1c5151aba78964a16b8eec">
          <documentation>Operaciones: Reservar; Consultar existencia; Solicitar reposición. Entradas: Repuesto, cantidad, OT. Salidas: Reserva, existencia usable, solicitud. Errores: EXISTENCIA_INSUFICIENTE. Pre: referencia en catálogo. Post: reservado ≤ existencia. Consumidores: sv_prog, sv_ejec.</documentation>
          <property key="Servicio" value="Gestión de repuestos del taller"/>
          <property key="Versión" value="1.0.0"/>
          <property key="Nivel" value="N3"/>
          <property key="RNF" value="Respuesta &lt; 2 s; trazabilidad de cambios; consistencia fuerte dentro del subdominio."/>
          <property key="Política de cambios" value="Agregar campos en lugar de modificar; versionar el contrato; avisar al catálogo de servicios"/>
          <property key="Fase" value="2 (V4)"/>
          <property key="Fuente" value="Metodología SOA P3 (Contract-First)"/>
        </element>
        <element xsi:type="archimate:Contract" name="Contrato de gestión de indicadores de mantenimiento" id="id-ed01a51552265616a8dbc555b8db717e">
          <documentation>Operaciones: Definir regla y metas; Calcular indicadores. Entradas: Horas, OTs, costos, regla de conteo. Salidas: Mediciones por período. Errores: REGLA_DE_CONTEO_NO_DEFINIDA. Pre: regla vigente. Post: medición con versión de regla. Consumidores: sv_disp.</documentation>
          <property key="Servicio" value="Gestión de indicadores de mantenimiento"/>
          <property key="Versión" value="1.0.0"/>
          <property key="Nivel" value="N3"/>
