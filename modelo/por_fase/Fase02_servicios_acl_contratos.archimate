        </element>
        <element xsi:type="archimate:Contract" name="Contrato de registro de ejecución y consumos" id="id-d062fded44fb501a9fb0d3ec2c109c8f">
          <documentation>Operaciones: Registrar tarea, consumo y hallazgo. Entradas: Tarea, repuesto con serie, horas-hombre. Salidas: Tarea ejecutada. Errores: SERIE_FALTANTE. Pre: OT abierta. Consumidores: sd_ot.</documentation>
          <property key="Servicio" value="Registro de ejecución y consumos"/>
          <property key="Versión" value="1.0.0"/>
          <property key="Nivel" value="N4"/>
          <property key="RNF" value="Operación atómica e idempotente; reintentos seguros."/>
          <property key="Política de cambios" value="Agregar campos en lugar de modificar; versionar el contrato; avisar al catálogo de servicios"/>
          <property key="Fase" value="2 (V4)"/>
          <property key="Fuente" value="Metodología SOA P3 (Contract-First)"/>
        </element>
        <element xsi:type="archimate:Contract" name="Contrato de autorización de liberación" id="id-4caa3b3ea23050b897f842b358313de6">
          <documentation>Operaciones: Liberar dron. Entradas: OT ejecutada, vuelo de prueba, firma. Salidas: Dron liberado. Errores: LIBERA_EL_MISMO_QUE_EJECUTO. Pre: prueba OK en mayores. Consumidores: sd_ot.</documentation>
          <property key="Servicio" value="Autorización de liberación"/>
          <property key="Versión" value="1.0.0"/>
          <property key="Nivel" value="N4"/>
          <property key="RNF" value="Operación atómica e idempotente; reintentos seguros."/>
          <property key="Política de cambios" value="Agregar campos en lugar de modificar; versionar el contrato; avisar al catálogo de servicios"/>
          <property key="Fase" value="2 (V4)"/>
          <property key="Fuente" value="Metodología SOA P3 (Contract-First)"/>
        </element>
        <element xsi:type="archimate:Contract" name="Contrato de cierre de orden de trabajo" id="id-892a7abee1155d94b399bcbd15ddebe6">
          <documentation>Operaciones: Cerrar OT. Entradas: OT liberada. Salidas: OT cerrada. Errores: SERIE_FALTANTE. Post: OT inmutable. Consumidores: sd_ot.</documentation>
          <property key="Servicio" value="Cierre de orden de trabajo"/>
          <property key="Versión" value="1.0.0"/>
          <property key="Nivel" value="N4"/>
          <property key="RNF" value="Operación atómica e idempotente; reintentos seguros."/>
          <property key="Política de cambios" value="Agregar campos en lugar de modificar; versionar el contrato; avisar al catálogo de servicios"/>
          <property key="Fase" value="2 (V4)"/>
          <property key="Fuente" value="Metodología SOA P3 (Contract-First)"/>
        </element>
        <element xsi:type="archimate:Contract" name="Contrato de reserva de repuestos" id="id-3845c3a9d05d5c9c98c963393c061184">
          <documentation>Operaciones: Reservar; Liberar reserva. Entradas: Repuesto, cantidad, OT. Salidas: Reserva. Errores: EXISTENCIA_INSUFICIENTE. Pre: reservado ≤ existencia. Consumidores: sd_rep.</documentation>
          <property key="Servicio" value="Reserva de repuestos"/>
          <property key="Versión" value="1.0.0"/>
          <property key="Nivel" value="N4"/>
          <property key="RNF" value="Operación atómica e idempotente; reintentos seguros."/>
          <property key="Política de cambios" value="Agregar campos en lugar de modificar; versionar el contrato; avisar al catálogo de servicios"/>
          <property key="Fase" value="2 (V4)"/>
          <property key="Fuente" value="Metodología SOA P3 (Contract-First)"/>
        </element>
        <element xsi:type="archimate:Contract" name="Contrato de consulta de existencias del taller" id="id-ffac03c97d6b5e18847a395a68a71ed0">
          <documentation>Operaciones: Consultar existencia. Entradas: Referencia. Salidas: Existencia usable. Errores: REFERENCIA_INEXISTENTE. Solo lectura. Consumidores: sd_rep.</documentation>
          <property key="Servicio" value="Consulta de existencias del taller"/>
          <property key="Versión" value="1.0.0"/>
          <property key="Nivel" value="N4"/>
          <property key="RNF" value="Operación atómica e idempotente; reintentos seguros."/>
          <property key="Política de cambios" value="Agregar campos en lugar de modificar; versionar el contrato; avisar al catálogo de servicios"/>
          <property key="Fase" value="2 (V4)"/>
          <property key="Fuente" value="Metodología SOA P3 (Contract-First)"/>
        </element>
        <element xsi:type="archimate:Contract" name="Contrato de solicitud de reposición" id="id-b543ad12c47956a4979602ebd2d4e641">
          <documentation>Operaciones: Solicitar reposición; Aprobar. Entradas: Referencia, cantidad, monto. Salidas: Solicitud. Errores: SOLICITUD_ABIERTA. Post: nivel de aprobación por monto. Consumidores: sd_rep.</documentation>
          <property key="Servicio" value="Solicitud de reposición"/>
          <property key="Versión" value="1.0.0"/>
          <property key="Nivel" value="N4"/>
          <property key="RNF" value="Operación atómica e idempotente; reintentos seguros."/>
          <property key="Política de cambios" value="Agregar campos en lugar de modificar; versionar el contrato; avisar al catálogo de servicios"/>
          <property key="Fase" value="2 (V4)"/>
          <property key="Fuente" value="Metodología SOA P3 (Contract-First)"/>
        </element>
        <element xsi:type="archimate:Contract" name="Contrato de cálculo de indicadores" id="id-5c9c1beb784d53cda6c1c6e81dea0020">
          <documentation>Operaciones: Calcular indicador. Entradas: Regla vigente, horas, OTs, costos. Salidas: Medición. Errores: REGLA_NO_DEFINIDA. Post: medición inmutable. Consumidores: sd_ind.</documentation>
          <property key="Servicio" value="Cálculo de indicadores"/>
          <property key="Versión" value="1.0.0"/>
          <property key="Nivel" value="N4"/>
          <property key="RNF" value="Operación atómica e idempotente; reintentos seguros."/>
          <property key="Política de cambios" value="Agregar campos en lugar de modificar; versionar el contrato; avisar al catálogo de servicios"/>
          <property key="Fase" value="2 (V4)"/>
          <property key="Fuente" value="Metodología SOA P3 (Contract-First)"/>
        </element>
        <element xsi:type="archimate:Contract" name="Contrato de definición de regla de conteo y metas" id="id-5e280e666cce5bce8f032fd3fe1e1e81">
          <documentation>Operaciones: Definir regla de conteo; Fijar meta. Entradas: Fórmula, regla, meta. Salidas: Definición versionada. Errores: REGLA_DUPLICADA. Post: una sola regla vigente. Consumidores: sd_ind.</documentation>
          <property key="Servicio" value="Definición de regla de conteo y metas"/>
          <property key="Versión" value="1.0.0"/>
          <property key="Nivel" value="N4"/>
          <property key="RNF" value="Operación atómica e idempotente; reintentos seguros."/>
          <property key="Política de cambios" value="Agregar campos en lugar de modificar; versionar el contrato; avisar al catálogo de servicios"/>
          <property key="Fase" value="2 (V4)"/>
          <property key="Fuente" value="Metodología SOA P3 (Contract-First)"/>
        </element>
        <element xsi:type="archimate:Contract" name="Contrato de consulta de habilitación vigente" id="id-0c8284b82bb5559f80311db54ecc0d6b">
          <documentation>Operaciones: Consultar habilitación. Entradas: Técnico, modelo. Salidas: Sí/no con vigencia. Errores: HABILITACION_VENCIDA. Solo lectura. Consumidores: sd_hab.</documentation>
          <property key="Servicio" value="Consulta de habilitación vigente"/>
          <property key="Versión" value="1.0.0"/>
          <property key="Nivel" value="N4"/>
          <property key="RNF" value="Operación atómica e idempotente; reintentos seguros."/>
          <property key="Política de cambios" value="Agregar campos en lugar de modificar; versionar el contrato; avisar al catálogo de servicios"/>
          <property key="Fase" value="2 (V4)"/>
          <property key="Fuente" value="Metodología SOA P3 (Contract-First)"/>
        </element>
        <element xsi:type="archimate:Contract" name="Contrato de catálogo de modelos y componentes" id="id-77244ca932d35de08898fd2dadb34396">
          <documentation>Operaciones: Consultar modelo y despiece. Entradas: Modelo. Salidas: Despiece por subsistema. Errores: MODELO_INEXISTENTE. Solo lectura; versionado. Consumidores: sd_flota, sd_plan.</documentation>
          <property key="Servicio" value="Catálogo de modelos y componentes"/>
          <property key="Versión" value="1.0.0"/>
          <property key="Nivel" value="N5"/>
          <property key="RNF" value="Solo lectura para los consumidores; versionado del catálogo."/>
          <property key="Política de cambios" value="Agregar campos en lugar de modificar; versionar el contrato; avisar al catálogo de servicios"/>
          <property key="Fase" value="2 (V4)"/>
          <property key="Fuente" value="Metodología SOA P3 (Contract-First)"/>
        </element>
        <element xsi:type="archimate:Contract" name="Contrato de catálogo de tareas e intervalos por modelo" id="id-83c0b3b2ad6a5d458de8ea6760f11d93">
          <documentation>Operaciones: Consultar tareas e intervalos. Entradas: Modelo, tipo de componente. Salidas: Tareas con umbral y fuente. Errores: SIN_INTERVALO. Solo lectura; versionado. Consumidores: sd_plan.</documentation>
          <property key="Servicio" value="Catálogo de tareas e intervalos por modelo"/>
          <property key="Versión" value="1.0.0"/>
          <property key="Nivel" value="N5"/>
          <property key="RNF" value="Solo lectura para los consumidores; versionado del catálogo."/>
          <property key="Política de cambios" value="Agregar campos en lugar de modificar; versionar el contrato; avisar al catálogo de servicios"/>
          <property key="Fase" value="2 (V4)"/>
          <property key="Fuente" value="Metodología SOA P3 (Contract-First)"/>
        </element>
        <element xsi:type="archimate:Contract" name="Contrato de catálogo de repuestos" id="id-610199c6a4e15cc2bbfa3049e85de4b6">
          <documentation>Operaciones: Consultar referencia y kit. Entradas: Referencia. Salidas: Repuesto y costo. Errores: REFERENCIA_INEXISTENTE. Solo lectura. Consumidores: sd_rep.</documentation>
          <property key="Servicio" value="Catálogo de repuestos"/>
          <property key="Versión" value="1.0.0"/>
          <property key="Nivel" value="N5"/>
          <property key="RNF" value="Solo lectura para los consumidores; versionado del catálogo."/>
          <property key="Política de cambios" value="Agregar campos en lugar de modificar; versionar el contrato; avisar al catálogo de servicios"/>
          <property key="Fase" value="2 (V4)"/>
          <property key="Fuente" value="Metodología SOA P3 (Contract-First)"/>
        </element>
        <element xsi:type="archimate:Contract" name="Contrato de identidad y permisos" id="id-88cfa20c4ef55437829a0766bf3d20b6">
          <documentation>Operaciones: Autenticar; Autorizar por rol. Entradas: Credenciales. Salidas: Sesión con roles. Errores: NO_AUTORIZADO. Roles de piloto, técnico, jefe, almacén, comercial y gerencia. Consumidores: Todos.</documentation>
          <property key="Servicio" value="Identidad y permisos"/>
          <property key="Versión" value="1.0.0"/>
          <property key="Nivel" value="N6"/>
          <property key="RNF" value="Transversal; sin lógica de negocio."/>
          <property key="Política de cambios" value="Agregar campos en lugar de modificar; versionar el contrato; avisar al catálogo de servicios"/>
          <property key="Fase" value="2 (V4)"/>
          <property key="Fuente" value="Metodología SOA P3 (Contract-First)"/>
        </element>
        <element xsi:type="archimate:Contract" name="Contrato de auditoría y trazabilidad de cambios" id="id-d2e40468599a5a9bac282a03d2b6257c">
          <documentation>Operaciones: Registrar cambio; Consultar historial de cambios. Entradas: Quién, qué, cuándo. Salidas: Historial inmutable. Errores: NO_ESCRIBIBLE. Append-only. Consumidores: sv_ejec, sv_evid.</documentation>
          <property key="Servicio" value="Auditoría y trazabilidad de cambios"/>
          <property key="Versión" value="1.0.0"/>
          <property key="Nivel" value="N6"/>
          <property key="RNF" value="Transversal; sin lógica de negocio."/>
          <property key="Política de cambios" value="Agregar campos en lugar de modificar; versionar el contrato; avisar al catálogo de servicios"/>
          <property key="Fase" value="2 (V4)"/>
          <property key="Fuente" value="Metodología SOA P3 (Contract-First)"/>
        </element>
        <element xsi:type="archimate:Contract" name="Contrato de notificación de alertas y avisos" id="id-0581e55011f1546790b0455ef2679886">
          <documentation>Operaciones: Enviar aviso. Entradas: Destinatario, mensaje, canal. Salidas: Aviso enviado/fallido. Errores: CANAL_NO_DISPONIBLE. Reintentos idempotentes. Consumidores: sv_prog, sv_disp.</documentation>
          <property key="Servicio" value="Notificación de alertas y avisos"/>
          <property key="Versión" value="1.0.0"/>
          <property key="Nivel" value="N6"/>
          <property key="RNF" value="Transversal; sin lógica de negocio."/>
          <property key="Política de cambios" value="Agregar campos en lugar de modificar; versionar el contrato; avisar al catálogo de servicios"/>
          <property key="Fase" value="2 (V4)"/>
          <property key="Fuente" value="Metodología SOA P3 (Contract-First)"/>
        </element>
      </folder>
    </folder>
    <folder name="Lenguaje ubicuo" id="id-631d03b54e915084886c919dbdb120ff">
      <folder name="Flota y Componentes" id="id-8d73a272d4745227bbbd1f336954ad25">
        <element xsi:type="archimate:BusinessObject" name="Estado del dron" id="id-38607674e89c5843ac0bb0eb3cfbcd36">
          <documentation>Semáforo operativo del dron en el tablero: verde (disponible), amarillo (por vencer o en espera) o rojo (parado).</documentation>
          <property key="Contexto" value="Flota y Componentes"/>
          <property key="Ejemplo" value="ADV-02 en rojo durante 21 días."/>
          <property key="No usar" value="color, status"/>
          <property key="Fuente" value="P26, P91"/>
          <property key="Fase" value="3 (V7)"/>
        </element>
        <element xsi:type="archimate:BusinessObject" name="Componente" id="id-da2a3f3c3021548da0c2f627cd92ea5f">
          <documentation>Pieza con identidad (número de serie), contadores propios y vida útil limitada: motor, batería, bomba, brazo, controlador.</documentation>
          <property key="Contexto" value="Flota y Componentes"/>
          <property key="Ejemplo" value="Motor serie M-4471 con 180 h propias."/>
          <property key="No usar" value="pieza, parte"/>
          <property key="Fuente" value="H-20, H-21; P40-P44"/>
          <property key="Fase" value="3 (V7)"/>
        </element>
        <element xsi:type="archimate:BusinessObject" name="Número de serie" id="id-446ff1c6bd405c5797afc83cd205502a">
          <documentation>Identificador del fabricante de un componente mayor; se anota al recibirlo y al instalarlo.</documentation>
          <property key="Contexto" value="Flota y Componentes"/>
          <property key="Ejemplo" value="Serie de la batería BAX601 marcada en la carcasa."/>
          <property key="No usar" value="código, referencia"/>
          <property key="Fuente" value="P43"/>
          <property key="Fase" value="3 (V7)"/>
        </element>
        <element xsi:type="archimate:BusinessObject" name="Componente instalado" id="id-f621b3e0122455ac9e3500c476ad0e7e">
          <documentation>Componente montado en una posición del despiece de un dron en un momento dado.</documentation>
          <property key="Contexto" value="Flota y Componentes"/>
          <property key="Ejemplo" value="Motor M-4471 en el brazo 2 del ADV-03 desde la OT 2026-117."/>
          <property key="No usar" value="montado, puesto"/>
          <property key="Fuente" value="H-20"/>
          <property key="Fase" value="3 (V7)"/>
        </element>
        <element xsi:type="archimate:BusinessObject" name="Vida remanente" id="id-2c32630ecea25fdf95c55fbf161e40ff">
          <documentation>Horas, ciclos o días que le quedan a un componente antes de su umbral; viaja con él al cambiar de dron.</documentation>
          <property key="Contexto" value="Flota y Componentes"/>
          <property key="Ejemplo" value="Motor sale del ADV-10 con 180 h; le quedan 120 h hasta las 300 h."/>
          <property key="No usar" value="vida útil restante"/>
          <property key="Fuente" value="H-20; P51"/>
          <property key="Fase" value="3 (V7)"/>
        </element>
      </folder>
      <folder name="Operación y Horas" id="id-e06a0b721fc75c4884089f66f65e7a90">
        <element xsi:type="archimate:BusinessObject" name="Horas de vuelo" id="id-a893781996305a8da929e274f3b96234">
          <documentation>Tiempo en el aire del dron; base para los intervalos de mantenimiento.</documentation>
          <property key="Contexto" value="Operación y Horas"/>
          <property key="Ejemplo" value="4 a 6 h por dron en una jornada."/>
          <property key="No usar" value="horas de motor"/>
          <property key="Fuente" value="H-26; P3"/>
          <property key="Fase" value="3 (V7)"/>
        </element>
        <element xsi:type="archimate:BusinessObject" name="Parte de vuelo" id="id-52a2a5b810ba527a9452ca3ae7863da9">
          <documentation>Formato en papel que diligencia el piloto al final de la jornada: lote, cliente, producto, dosis e incidentes.</documentation>
          <property key="Contexto" value="Operación y Horas"/>
          <property key="Ejemplo" value="Parte fotografiado al grupo de WhatsApp."/>
          <property key="No usar" value="reporte, planilla"/>
          <property key="Fuente" value="P13, P82"/>
          <property key="Fase" value="3 (V7)"/>
        </element>
        <element xsi:type="archimate:BusinessObject" name="Registro de operación" id="id-3761b1095e535c58beb8a42939791c07">
          <documentation>Unión consolidada de la app del fabricante, el parte de vuelo y el WhatsApp para una jornada de un dron.</documentation>
          <property key="Contexto" value="Operación y Horas"/>
          <property key="Ejemplo" value="Registro del ADV-06 del 14 de agosto."/>
          <property key="No usar" value="bitácora"/>
          <property key="Fuente" value="P82"/>
          <property key="Fase" value="3 (V7)"/>
        </element>
        <element xsi:type="archimate:BusinessObject" name="Lectura de telemetría" id="id-5cde7e0cf859571385aac6fa40452fb2">
          <documentation>Dato individual importado (horas de motor, ciclos de batería, voltaje, alarma).</documentation>
          <property key="Contexto" value="Operación y Horas"/>
          <property key="Ejemplo" value="Salud de la batería 14 = 82 %."/>
          <property key="No usar" value="log"/>
          <property key="Fuente" value="P83"/>
          <property key="Fase" value="3 (V7)"/>
        </element>
      </folder>
      <folder name="Plan de Mantenimiento" id="id-ccc62691e66d575ca7d98d01fa5abc86">
        <element xsi:type="archimate:BusinessObject" name="Plan por dron" id="id-68478f42e9fa5999acd986e3ff582e1a">
          <documentation>Plan de un dron concreto: tareas del modelo con sus vencimientos y ajustes propios.</documentation>
          <property key="Contexto" value="Plan de Mantenimiento"/>
          <property key="Ejemplo" value="Plan del ADV-03."/>
          <property key="No usar" value="hoja del dron"/>
          <property key="Fuente" value="P69"/>
          <property key="Fase" value="3 (V7)"/>
        </element>
        <element xsi:type="archimate:BusinessObject" name="Tarea programada" id="id-de99e78be3ca5dee8ecccc50e7f27ff9">
          <documentation>Tarea del plan de un dron con su próximo vencimiento y estado (al día, por vencer, vencida, diferida).</documentation>
          <property key="Contexto" value="Plan de Mantenimiento"/>
          <property key="Ejemplo" value="Service de 100 h del ADV-03: por vencer a las 95 h."/>
          <property key="No usar" value="pendiente"/>
          <property key="Fuente" value="P68, P79"/>
          <property key="Fase" value="3 (V7)"/>
        </element>
        <element xsi:type="archimate:BusinessObject" name="Condición de mantenimiento" id="id-4d555a2d7e6150129064ff375ddae599">
          <documentation>Regla que dispara una tarea por horas, ciclos, calendario o estado; con varias, manda lo que ocurra primero.</documentation>
          <property key="Contexto" value="Plan de Mantenimiento"/>
          <property key="Ejemplo" value="Batería: 800-1.000 ciclos o salud &lt; 80 %."/>
          <property key="No usar" value="intervalo (solo cubre horas)"/>
          <property key="Fuente" value="H-17; P45-P47"/>
          <property key="Fase" value="3 (V7)"/>
        </element>
        <element xsi:type="archimate:BusinessObject" name="Umbral" id="id-190f5129aaeb5d8597e1883f82b70f60">
          <documentation>Valor que activa una condición (100 h, 800 ciclos, 1 año, 10 % de desvío); siempre lleva su fuente.</documentation>
          <property key="Contexto" value="Plan de Mantenimiento"/>
          <property key="Ejemplo" value="Motores: 300 h."/>
          <property key="No usar" value="límite, tope"/>
          <property key="Fuente" value="P46; H-15"/>
          <property key="Fase" value="3 (V7)"/>
        </element>
        <element xsi:type="archimate:BusinessObject" name="Programa semanal" id="id-a7e85c73a8a058d5bb750aa359ebc7c3">
          <documentation>Decisión del lunes 6:30 a.m.: paradas, técnicos y repuestos de la semana.</documentation>
          <property key="Contexto" value="Plan de Mantenimiento"/>
          <property key="Ejemplo" value="Programa de la semana 34."/>
          <property key="No usar" value="agenda"/>
          <property key="Fuente" value="P71"/>
          <property key="Fase" value="3 (V7)"/>
        </element>
      </folder>
      <folder name="Intervenciones" id="id-2b258af7f7a95da0937b1db79a4c47ec">
        <element xsi:type="archimate:BusinessObject" name="Orden de trabajo" id="id-bc1a6f6900625740ba08b262b834861d">
          <documentation>Documento que autoriza y registra una intervención sobre un dron: tareas, repuestos con serie, horas-hombre, hallazgos y firmas.</documentation>
          <property key="Contexto" value="Intervenciones"/>
          <property key="Ejemplo" value="OT del service de 100 h del ADV-06."/>
          <property key="No usar" value="ticket, solicitud"/>
          <property key="Fuente" value="P33-P35"/>
          <property key="Fase" value="3 (V7)"/>
        </element>
        <element xsi:type="archimate:BusinessObject" name="Tarea ejecutada" id="id-fe4cfb8a529c579a81b2b331b8652191">
          <documentation>Trabajo realizado dentro de una OT con su resultado y quien lo hizo.</documentation>
          <property key="Contexto" value="Intervenciones"/>
          <property key="Ejemplo" value="Calibración de bomba realizada."/>
          <property key="No usar" value="paso"/>
          <property key="Fuente" value="P33"/>
          <property key="Fase" value="3 (V7)"/>
        </element>
        <element xsi:type="archimate:BusinessObject" name="Consumo (de repuesto)" id="id-ec1f11af9e8257d4a62bba9ddb72a3ac">
          <documentation>Repuesto realmente gastado en una OT, con la serie retirada y la instalada.</documentation>
          <property key="Contexto" value="Intervenciones"/>
          <property key="Ejemplo" value="Dos boquillas y un kit de filtros."/>
          <property key="No usar" value="salida"/>
          <property key="Fuente" value="H-36; P129"/>
          <property key="Fase" value="3 (V7)"/>
        </element>
        <element xsi:type="archimate:BusinessObject" name="Hallazgo" id="id-71454d0c8da158f2b2cb10030accff58">
          <documentation>Hecho encontrado durante una intervención o inspección que no estaba en el plan.</documentation>
          <property key="Contexto" value="Intervenciones"/>
          <property key="Ejemplo" value="Manguera con rajadura incipiente."/>
          <property key="No usar" value="novedad"/>
          <property key="Fuente" value="P38"/>
          <property key="Fase" value="3 (V7)"/>
        </element>
        <element xsi:type="archimate:BusinessObject" name="Liberación" id="id-3d52f0ea7b9c58e29f8d365c1c8f294f">
          <documentation>Firma que autoriza el regreso del dron al servicio; en trabajos mayores la da quien no ejecutó.</documentation>
          <property key="Contexto" value="Intervenciones"/>
          <property key="Ejemplo" value="Pompilio firma a las 8:00."/>
          <property key="No usar" value="visto bueno"/>
          <property key="Fuente" value="H-22; P24, P34"/>
          <property key="Fase" value="3 (V7)"/>
        </element>
        <element xsi:type="archimate:BusinessObject" name="Bitácora del dron" id="id-92dfbc2f9472565aab8b80a36dd2649f">
          <documentation>Cuaderno histórico de vuelos y mantenimiento de cada dron de la empresa.</documentation>
          <property key="Contexto" value="Intervenciones"/>
          <property key="Ejemplo" value="Bitácora del ADV-03."/>
          <property key="No usar" value="libro de vida"/>
          <property key="Fuente" value="H-36; P114, P132"/>
          <property key="Fase" value="3 (V7)"/>
        </element>
      </folder>
      <folder name="Repuestos del Taller" id="id-3cc7efaaa15f5c4da6999f64d00d626d">
        <element xsi:type="archimate:BusinessObject" name="Repuesto" id="id-0668d69b13e752ebb1b56f7a8a035c9e">
          <documentation>Unidad en bodega destinada a reemplazar un componente (mayores con serie, consumibles por lote).</documentation>
          <property key="Contexto" value="Repuestos del Taller"/>
          <property key="Ejemplo" value="Brazo completo T40."/>
          <property key="No usar" value="pieza de bodega"/>
          <property key="Fuente" value="P56, P57"/>
          <property key="Fase" value="3 (V7)"/>
        </element>
        <element xsi:type="archimate:BusinessObject" name="Reserva de repuesto" id="id-2db189a812fa59b2847a9091ddfe1d73">
          <documentation>Apartado de repuestos para una intervención programada.</documentation>
          <property key="Contexto" value="Repuestos del Taller"/>
          <property key="Ejemplo" value="Kit de filtros reservado para la parada del miércoles."/>
          <property key="No usar" value="separado"/>
          <property key="Fuente" value="H-29; P28"/>
          <property key="Fase" value="3 (V7)"/>
        </element>
        <element xsi:type="archimate:BusinessObject" name="Stock mínimo" id="id-e361b3c353c55d19a5504dd8e9b61a72">
          <documentation>Cantidad por debajo de la cual se solicita reposición inmediata.</documentation>
          <property key="Contexto" value="Repuestos del Taller"/>
          <property key="Ejemplo" value="2 brazos T40."/>
          <property key="No usar" value="mínimo de bodega"/>
          <property key="Fuente" value="P59"/>
          <property key="Fase" value="3 (V7)"/>
        </element>
        <element xsi:type="archimate:BusinessObject" name="Solicitud de reposición" id="id-ff1f4b50bf225adebf9206f85db147ea">
          <documentation>Pedido interno que nace al tocar el stock mínimo; aprueba el jefe hasta $5 M y la gerencia por encima.</documentation>
          <property key="Contexto" value="Repuestos del Taller"/>
          <property key="Ejemplo" value="Solicitud de 2 motores."/>
          <property key="No usar" value="orden de compra"/>
          <property key="Fuente" value="P61"/>
          <property key="Fase" value="3 (V7)"/>
        </element>
      </folder>
      <folder name="Indicadores" id="id-0dc5103f0cfd51deb4c4c3cf32ccdddc">
        <element xsi:type="archimate:BusinessObject" name="Disponibilidad de flota" id="id-3d9249e56e81531588b8e02bcb8e5eac">
          <documentation>Dron-días en verde sobre dron-días del período por 100.</documentation>
          <property key="Contexto" value="Indicadores"/>
          <property key="Ejemplo" value="Octubre: 86,8 % contando los 12 drones."/>
          <property key="No usar" value="uptime"/>
          <property key="Fuente" value="P91, P95"/>
          <property key="Fase" value="3 (V7)"/>
        </element>
        <element xsi:type="archimate:BusinessObject" name="Regla de conteo" id="id-3231fbe427ef50349dc9342ca7845064">
          <documentation>Decisión de qué drones entran al denominador de la disponibilidad (por ejemplo los donantes); debe ser una sola.</documentation>
          <property key="Contexto" value="Indicadores"/>
          <property key="Ejemplo" value="Donantes excluidos del denominador."/>
          <property key="No usar" value="criterio"/>
          <property key="Fuente" value="H-28; P95"/>
          <property key="Fase" value="3 (V7)"/>
        </element>
        <element xsi:type="archimate:BusinessObject" name="Meta (indicador)" id="id-3cd7fbff7c7b583191a73a9d62999cf2">
          <documentation>Valor objetivo de un indicador con fecha.</documentation>
          <property key="Contexto" value="Indicadores"/>
          <property key="Ejemplo" value="≥ 92 % en pico para 2027."/>
          <property key="No usar" value="objetivo (sin número)"/>
          <property key="Fuente" value="H-37"/>
          <property key="Fase" value="3 (V7)"/>
        </element>
        <element xsi:type="archimate:BusinessObject" name="Medición de indicador" id="id-a1dc63cd505b537aa5a0135c22f08f33">
          <documentation>Valor calculado de un indicador en un período con la versión de la regla usada.</documentation>
          <property key="Contexto" value="Indicadores"/>
          <property key="Ejemplo" value="Disponibilidad de agosto: 91 %."/>
          <property key="No usar" value="reporte"/>
          <property key="Fuente" value="P91"/>
          <property key="Fase" value="3 (V7)"/>
        </element>
      </folder>
      <folder name="Habilitación de Personal" id="id-0df46cdcf2365feda8ded743d647f815">
        <element xsi:type="archimate:BusinessObject" name="Técnico habilitado" id="id-ffb291024fe95971b1f302dc0bdcb3e7">
          <documentation>Técnico con el curso del modelo al día para una tarea (en el taller, 'habilitado' = curso del modelo vigente).</documentation>
          <property key="Contexto" value="Habilitación de Personal"/>
          <property key="Ejemplo" value="Jhon Fredy para el XAG."/>
          <property key="No usar" value="certificado (genérico)"/>
          <property key="Fuente" value="P131; H-04"/>
          <property key="Fase" value="3 (V7)"/>
        </element>
        <element xsi:type="archimate:BusinessObject" name="Habilitación de modelo" id="id-3fbeca7c016952d984c6ea304c944b23">
          <documentation>Vigencia del curso de un técnico para un modelo concreto.</documentation>
          <property key="Contexto" value="Habilitación de Personal"/>
          <property key="Ejemplo" value="Curso T40 vigente hasta dic."/>
          <property key="No usar" value="licencia"/>
          <property key="Fuente" value="P23, P131"/>
          <property key="Fase" value="3 (V7)"/>
        </element>
      </folder>
    </folder>
  </folder>
