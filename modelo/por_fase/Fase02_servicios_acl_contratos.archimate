          <property key="Fuente" value="Metodología SOA P3 (Contract-First)"/>
        </element>
        <element xsi:type="archimate:Contract" name="Contrato de verificación de habilitación de técnicos" id="id-f05a6425566e564595db8d739eec5238">
          <documentation>Operaciones: Consultar habilitación vigente. Entradas: Técnico, modelo, tarea. Salidas: Habilitado sí/no con vigencia. Errores: HABILITACION_VENCIDA. Pre: habilitaciones sincronizadas (ACL-04). Post: respuesta con fecha de vencimiento. Consumidores: sv_prog, sv_ejec.</documentation>
          <property key="Servicio" value="Verificación de habilitación de técnicos"/>
          <property key="Versión" value="1.0.0"/>
          <property key="Nivel" value="N3"/>
          <property key="RNF" value="Respuesta &lt; 2 s; trazabilidad de cambios; consistencia fuerte dentro del subdominio."/>
          <property key="Política de cambios" value="Agregar campos en lugar de modificar; versionar el contrato; avisar al catálogo de servicios"/>
          <property key="Fase" value="2 (V4)"/>
          <property key="Fuente" value="Metodología SOA P3 (Contract-First)"/>
        </element>
        <element xsi:type="archimate:Contract" name="Contrato de consolidación de horas y ciclos" id="id-c3b2cc2cf2d15a59a4b2512ff1374dc1">
          <documentation>Operaciones: Consolidar jornada. Entradas: Jornada de vuelo, canal de origen. Salidas: Horas de vuelo y ciclos consolidados. Errores: DUPLICADO. Pre: jornada con dron. Post: eventos de horas consolidadas. Consumidores: sd_oper.</documentation>
          <property key="Servicio" value="Consolidación de horas y ciclos"/>
