          <property key="Fase" value="5 (V8)"/>
        </element>
      </folder>
      <folder name="Flota y Componentes" id="id-02a15d8d757c59439e18e047ca9d6783">
        <element xsi:type="archimate:ApplicationService" name="Servicio de instalación y retiro de componentes" id="id-69a51db65f5c59b99f9a2ea1d4eb5f68">
          <documentation>Servicio de aplicación del contexto «Flota y Componentes».</documentation>
          <property key="Fase" value="5 (V8)"/>
        </element>
        <element xsi:type="archimate:ApplicationService" name="Servicio de vida remanente" id="id-b812027f769e5993aaf70155745be022">
          <documentation>Servicio de aplicación del contexto «Flota y Componentes».</documentation>
          <property key="Fase" value="5 (V8)"/>
        </element>
      </folder>
      <folder name="Plan de Mantenimiento" id="id-c22d92579b5f57c4afde65acb26da4f4">
        <element xsi:type="archimate:ApplicationService" name="Servicio de evaluación de vencimientos" id="id-9d12e13fcb775506b436ac01a7a691bc">
          <documentation>Servicio de aplicación del contexto «Plan de Mantenimiento».</documentation>
          <property key="Fase" value="5 (V8)"/>
        </element>
        <element xsi:type="archimate:ApplicationService" name="Servicio de gestión del plan" id="id-9922f5c9a19c5db18d889eb02e648975">
