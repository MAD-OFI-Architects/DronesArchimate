      <folder name="Intervenciones" id="id-fc793f3554545a87a568ce05aa599b23">
        <element xsi:type="archimate:ApplicationService" name="Servicio de órdenes de trabajo" id="id-5c3942b84ef6572b9d9e2600bbd77019">
          <documentation>Servicio de aplicación del contexto «Intervenciones».</documentation>
          <property key="Fase" value="5 (V8)"/>
        </element>
        <element xsi:type="archimate:ApplicationService" name="Servicio de liberación" id="id-73a2010320bf5feca6a1328c6f16353a">
          <documentation>Servicio de aplicación del contexto «Intervenciones».</documentation>
          <property key="Fase" value="5 (V8)"/>
        </element>
      </folder>
      <folder name="Repuestos del Taller" id="id-1fc108c2a9f55a79b6eb1d3654e524cd">
        <element xsi:type="archimate:ApplicationService" name="Servicio de reserva de repuestos" id="id-2017eb81980d57af9f2f0012023d4dcd">
          <documentation>Servicio de aplicación del contexto «Repuestos del Taller».</documentation>
          <property key="Fase" value="5 (V8)"/>
        </element>
        <element xsi:type="archimate:ApplicationService" name="Servicio de solicitud de reposición" id="id-1e07f4e9a29e513b8f8678b1a2b91910">
          <documentation>Servicio de aplicación del contexto «Repuestos del Taller».</documentation>
          <property key="Fase" value="5 (V8)"/>
