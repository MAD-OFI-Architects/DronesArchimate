<?xml version="1.0" encoding="UTF-8"?>
<archimate:model xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:archimate="http://www.archimatetool.com/archimate" name="Drones - Mantenimiento Preventivo - Fase 6" id="id-984c5fcbf0045ba080b7aa388da82234" version="5.0.0">
  <purpose>Arquitectura de la aplicación de mantenimiento preventivo de la flota de drones de fumigación de AgroDrones del Valle S.A.S. (ArchiMate + DDD). Un solo modelo con las vistas V1 a V11. Modelo parcial: Fase 6.</purpose>
  <folder name="Strategy" id="id-34147471b29c55d19c1668ed90d3ea62" type="strategy">
    <folder name="Capacidades" id="id-f40e931e4e9d5ce1ad547e4f3e557390">
      <element xsi:type="archimate:Capability" name="Gestionar el cumplimiento aeronáutico (RAC 100)" id="id-0587ef32b41250bba49a050a9f8071dd">
        <documentation>La aplicación aporta los registros de mantenimiento que la norma y las inspecciones exigen; los trámites ante la Aerocivil siguen en administración.</documentation>
        <property key="Nivel" value="2"/>
        <property key="Impacto" value="Parcial"/>
        <property key="Fase" value="1 (V2)"/>
        <property key="Fuente" value="Entrevista P97-P104"/>
      </element>
      <element xsi:type="archimate:Capability" name="Registrar la operación de la flota" id="id-f899e7ddbdde524c9ed62a08e63bcb85">
        <documentation>Horas y ciclos por dron y componente: la base de todo (H-24).</documentation>
        <property key="Nivel" value="2"/>
        <property key="Impacto" value="Directa"/>
        <property key="Fase" value="1 (V2)"/>
        <property key="Fuente" value="Entrevista P97-P104"/>
      </element>
      <element xsi:type="archimate:Capability" name="Planificar el mantenimiento preventivo" id="id-a81a5dce229e572d9082fefa18174968">
        <documentation>Plan por dron con condiciones y programación semanal.</documentation>
        <property key="Nivel" value="2"/>
        <property key="Impacto" value="Directa"/>
        <property key="Fase" value="1 (V2)"/>
        <property key="Fuente" value="Entrevista P97-P104"/>
      </element>
      <element xsi:type="archimate:Capability" name="Ejecutar el mantenimiento" id="id-0bf826888f8e52b8a4ae83e1c90d33da">
        <documentation>OT con repuestos y cierre (preventivo y registro del correctivo).</documentation>
        <property key="Nivel" value="2"/>
        <property key="Impacto" value="Directa"/>
        <property key="Fase" value="1 (V2)"/>
        <property key="Fuente" value="Entrevista P97-P104"/>
      </element>
      <element xsi:type="archimate:Capability" name="Liberar aeronaves" id="id-42def6526bcb536fad264759b955432c">
        <documentation>Liberación con rol distinto al ejecutor y vuelo de prueba.</documentation>
        <property key="Nivel" value="2"/>
        <property key="Impacto" value="Directa"/>
        <property key="Fase" value="1 (V2)"/>
        <property key="Fuente" value="Entrevista P97-P104"/>
      </element>
      <element xsi:type="archimate:Capability" name="Medir el desempeño de la flota" id="id-25feff921037517ab413e0a24a1e28bb">
        <documentation>Indicadores de disponibilidad, cumplimiento, MTBF y costo por hora.</documentation>
        <property key="Nivel" value="2"/>
        <property key="Impacto" value="Directa"/>
        <property key="Fase" value="1 (V2)"/>
        <property key="Fuente" value="Entrevista P97-P104"/>
      </element>
      <element xsi:type="archimate:Capability" name="Gestionar el inventario de repuestos del taller" id="id-a2e415a8771e590b95ceb3af9b73da45">
        <documentation>Reserva y consumo de repuestos del taller; el inventario general sigue fuera.</documentation>
        <property key="Nivel" value="2"/>
        <property key="Impacto" value="Parcial"/>
        <property key="Fase" value="1 (V2)"/>
        <property key="Fuente" value="Entrevista P97-P104"/>
      </element>
      <element xsi:type="archimate:Capability" name="Gestionar registros y bitácoras" id="id-cb843bd899b85445a1eca71637f055ee">
        <documentation>Mantener el orden: registros al día, trazables y exportables.</documentation>
        <property key="Nivel" value="2"/>
        <property key="Impacto" value="Directa"/>
        <property key="Fase" value="1 (V2)"/>
        <property key="Fuente" value="Entrevista P97-P104"/>
      </element>
      <element xsi:type="archimate:Capability" name="Gestionar los datos de telemetría" id="id-5dbde1c5051e5b298a20c4317cf270e8">
        <documentation>Se consumen vía capa anticorrupción; no se construyen.</documentation>
        <property key="Nivel" value="2"/>
        <property key="Impacto" value="Parcial"/>
        <property key="Fase" value="1 (V2)"/>
        <property key="Fuente" value="Entrevista P97-P104"/>
      </element>
      <element xsi:type="archimate:Capability" name="Administrar los sistemas de información" id="id-86ca9aca0e2a5c20aaaa02528c6cc6ca">
        <documentation>La aplicación reemplaza Excel, papel y WhatsApp para el mantenimiento.</documentation>
        <property key="Nivel" value="2"/>
        <property key="Impacto" value="Parcial"/>
        <property key="Fase" value="1 (V2)"/>
        <property key="Fuente" value="Entrevista P97-P104"/>
      </element>
    </folder>
  </folder>
  <folder name="Business" id="id-893f2996739259e9ab78a657579c1d16" type="business">
    <folder name="Procesos E2E" id="id-fb89bf8d05ce5abd922ef43b0797f4c1">
      <element xsi:type="archimate:BusinessProcess" name="Registrar operación de vuelo" id="id-2aff122badbd5a079eb2d7ca9329accd">
        <documentation>Consolidar app, parte de vuelo y WhatsApp en horas y ciclos.</documentation>
        <property key="Fase" value="1 (V3)"/>
        <property key="Alcance" value="Dentro (la aplicación lo apoya)"/>
        <property key="Fuente" value="Entrevista P28-P29, P80-P89; H-24"/>
      </element>
      <element xsi:type="archimate:BusinessProcess" name="Detectar intervención por vencer" id="id-9f498de3bd8d5f79878baa9284f22fcd">
        <documentation>Comparar horas, ciclos, calendario y estado contra el plan (hoy: Excel de los viernes).</documentation>
        <property key="Fase" value="1 (V3)"/>
        <property key="Alcance" value="Dentro (la aplicación lo apoya)"/>
        <property key="Fuente" value="Entrevista P29, P31"/>
      </element>
      <element xsi:type="archimate:BusinessProcess" name="Programar intervención" id="id-d76c0b128b4752e3b317ff07e5abb418">
        <documentation>Decidir fecha, técnico y repuestos en la reunión del lunes sin chocar con servicios.</documentation>
        <property key="Fase" value="1 (V3)"/>
        <property key="Alcance" value="Dentro (la aplicación lo apoya)"/>
        <property key="Fuente" value="Entrevista P32, P71-P75"/>
      </element>
      <element xsi:type="archimate:BusinessProcess" name="Alistar repuestos y bahía" id="id-93ca430a64e253d5aa63a7ba4486f5f1">
        <documentation>Abrir la OT, reservar repuestos y preparar la bahía.</documentation>
        <property key="Fase" value="1 (V3)"/>
        <property key="Alcance" value="Dentro (la aplicación lo apoya)"/>
        <property key="Fuente" value="Entrevista P29, P65"/>
      </element>
      <element xsi:type="archimate:BusinessProcess" name="Ejecutar intervención" id="id-c41fef20e5aa53cc9161b4327ea7678e">
        <documentation>Diagnóstico, desmonte, cambio, calibración y pruebas de banco.</documentation>
        <property key="Fase" value="1 (V3)"/>
        <property key="Alcance" value="Dentro (la aplicación lo apoya)"/>
        <property key="Fuente" value="Entrevista P33"/>
      </element>
      <element xsi:type="archimate:BusinessProcess" name="Verificar y liberar dron" id="id-d46e43f375a15d928f7a97226779d74b">
        <documentation>Autoverificación, vuelo de prueba y firma de liberación.</documentation>
        <property key="Fase" value="1 (V3)"/>
        <property key="Alcance" value="Dentro (la aplicación lo apoya)"/>
        <property key="Fuente" value="Entrevista P34; H-22, H-23"/>
      </element>
      <element xsi:type="archimate:BusinessProcess" name="Cerrar y registrar intervención" id="id-a2e569b3a63350db8cd9c2143cf83277">
        <documentation>Cerrar la OT, descontar repuestos, actualizar bitácora, costo y contadores.</documentation>
        <property key="Fase" value="1 (V3)"/>
        <property key="Alcance" value="Dentro (la aplicación lo apoya)"/>
        <property key="Fuente" value="Entrevista P35-P36"/>
      </element>
      <element xsi:type="archimate:BusinessEvent" name="Boletín del fabricante recibido" id="id-1350dd7df35d5ba087d48ed00024dc4d">
        <documentation>Disparador alterno: cambia un intervalo.</documentation>
        <property key="Fase" value="1 (V3)"/>
        <property key="Fuente" value="Entrevista P29, P65, P76, P106"/>
      </element>
      <element xsi:type="archimate:BusinessFunction" name="Informar disponibilidad e indicadores" id="id-4e927707eb6c5c3688907cb87299fb5e">
        <documentation>Entrega estado del dron, disponibilidad y tablero mensual a Comercial y Gerencia.</documentation>
        <property key="Fase" value="1 (V3)"/>
        <property key="Alcance" value="Dentro"/>
        <property key="Fuente" value="Entrevista P92, P137"/>
      </element>
      <element xsi:type="archimate:BusinessFunction" name="Generar evidencia de mantenimiento" id="id-c642809378fe50d1a3a555a958ddf655">
        <documentation>Arma el histórico por dron para ingenios, aseguradora y autoridad.</documentation>
        <property key="Fase" value="1 (V3)"/>
        <property key="Alcance" value="Dentro"/>
        <property key="Fuente" value="Entrevista P92, P137"/>
      </element>
    </folder>
    <folder name="Lenguaje ubicuo" id="id-631d03b54e915084886c919dbdb120ff">
      <folder name="Plan de Mantenimiento" id="id-ccc62691e66d575ca7d98d01fa5abc86">
        <element xsi:type="archimate:BusinessObject" name="Plan de mantenimiento" id="id-8404c8ac827654bdbad47c1769fee98f">
          <documentation>Conjunto de tareas con sus condiciones, definido por modelo y ajustado por dron.</documentation>
          <property key="Contexto" value="Plan de Mantenimiento"/>
          <property key="Ejemplo" value="Hoja del T40 con columnas por dron."/>
          <property key="No usar" value="calendario de mantenimiento"/>
          <property key="Fuente" value="P68, P69"/>
          <property key="Fase" value="3 (V7)"/>
        </element>
        <element xsi:type="archimate:BusinessObject" name="Plan por modelo" id="id-c5ba0751fe1757b09bd0625aef04ce2a">
          <documentation>Versión del plan que nace del manual del fabricante para un modelo.</documentation>
          <property key="Contexto" value="Plan de Mantenimiento"/>
          <property key="Ejemplo" value="Plan del T40 versión 3."/>
          <property key="No usar" value="plantilla"/>
          <property key="Fuente" value="P69, P70"/>
          <property key="Fase" value="3 (V7)"/>
        </element>
        <element xsi:type="archimate:BusinessObject" name="Plan por dron" id="id-68478f42e9fa5999acd986e3ff582e1a">
          <documentation>Plan de un dron concreto: tareas del modelo con sus vencimientos y ajustes propios.</documentation>
          <property key="Contexto" value="Plan de Mantenimiento"/>
          <property key="Ejemplo" value="Plan del ADV-03."/>
          <property key="No usar" value="hoja del dron"/>
          <property key="Fuente" value="P69"/>
          <property key="Fase" value="3 (V7)"/>
        </element>
        <element xsi:type="archimate:BusinessObject" name="Condición de mantenimiento" id="id-4d555a2d7e6150129064ff375ddae599">
          <documentation>Regla que dispara una tarea por horas, ciclos, calendario o estado; con varias, manda lo que ocurra primero.</documentation>
          <property key="Contexto" value="Plan de Mantenimiento"/>
          <property key="Ejemplo" value="Batería: 800-1.000 ciclos o salud &lt; 80 %."/>
          <property key="No usar" value="intervalo (solo cubre horas)"/>
          <property key="Fuente" value="H-17; P45-P47"/>
          <property key="Fase" value="3 (V7)"/>
        </element>
        <element xsi:type="archimate:BusinessObject" name="Umbral" id="id-190f5129aaeb5d8597e1883f82b70f60">
          <documentation>Valor que activa una condición (100 h, 800 ciclos, 1 año, 10 % de desvío); siempre lleva su fuente.</documentation>
          <property key="Contexto" value="Plan de Mantenimiento"/>
          <property key="Ejemplo" value="Motores: 300 h."/>
          <property key="No usar" value="límite, tope"/>
          <property key="Fuente" value="P46; H-15"/>
          <property key="Fase" value="3 (V7)"/>
        </element>
        <element xsi:type="archimate:BusinessObject" name="Fuente del intervalo" id="id-3334436d1e8056f78ddacc83146702bd">
          <documentation>Origen de un umbral: manual del fabricante o criterio interno; el interno nunca es más laxo que el manual.</documentation>
          <property key="Contexto" value="Plan de Mantenimiento"/>
          <property key="Ejemplo" value="Hélices: 100 h (interna), manual por verificar."/>
          <property key="No usar" value="referencia"/>
          <property key="Fuente" value="H-15; P123"/>
          <property key="Fase" value="3 (V7)"/>
        </element>
        <element xsi:type="archimate:BusinessObject" name="Vencimiento" id="id-1a86cfff941e5f24bfc24a029a85bca9">
          <documentation>Momento en que una tarea pasa a exigible: amarillo por vencer, rojo vencido.</documentation>
          <property key="Contexto" value="Plan de Mantenimiento"/>
          <property key="Ejemplo" value="Vence a las 100 h; hoy 95 h."/>
          <property key="No usar" value="caducidad"/>
          <property key="Fuente" value="P68"/>
          <property key="Fase" value="3 (V7)"/>
        </element>
        <element xsi:type="archimate:BusinessObject" name="Service" id="id-5096f1d2d26657c796f905055c553982">
          <documentation>Intervención preventiva por intervalo de horas (25 h, 100 h) o mayor de motores (~300 h).</documentation>
          <property key="Contexto" value="Plan de Mantenimiento"/>
          <property key="Ejemplo" value="Service de 100 h: un día en bahía."/>
          <property key="No usar" value="mantenimiento general"/>
          <property key="Fuente" value="P28, P78"/>
          <property key="Fase" value="3 (V7)"/>
        </element>
        <element xsi:type="archimate:BusinessObject" name="Tarea crítica" id="id-1200cf69a4c358d181c8769aac17fa1b">
          <documentation>Tarea de seguridad (motores, estructura, batería hinchada) que no se difiere nunca; el dron no vuela si está vencida.</documentation>
          <property key="Contexto" value="Plan de Mantenimiento"/>
          <property key="Ejemplo" value="Reapriete tras golpe en brazo."/>
          <property key="No usar" value="tarea urgente"/>
          <property key="Fuente" value="H-19; P49-P50"/>
          <property key="Fase" value="3 (V7)"/>
        </element>
        <element xsi:type="archimate:BusinessObject" name="Diferimiento" id="id-25dbc089f928517b85ef89dcf85d6386">
          <documentation>Aplazamiento autorizado de una tarea menor hasta 10 % de su intervalo, con firma del jefe.</documentation>
          <property key="Contexto" value="Plan de Mantenimiento"/>
          <property key="Ejemplo" value="Filtros diferidos 8 h."/>
          <property key="No usar" value="estiramiento (mala práctica)"/>
          <property key="Fuente" value="H-19; P49"/>
          <property key="Fase" value="3 (V7)"/>
        </element>
        <element xsi:type="archimate:BusinessObject" name="Parada" id="id-2c759ed2eb09562baedfb57c226513a5">
          <documentation>Ingreso programado de un dron al taller para una o varias tareas agrupadas.</documentation>
          <property key="Contexto" value="Plan de Mantenimiento"/>
          <property key="Ejemplo" value="Parada del miércoles 19 en bahía 1."/>
          <property key="No usar" value="entrada a taller"/>
          <property key="Fuente" value="P72"/>
          <property key="Fase" value="3 (V7)"/>
        </element>
        <element xsi:type="archimate:BusinessObject" name="Programa semanal" id="id-a7e85c73a8a058d5bb750aa359ebc7c3">
          <documentation>Decisión del lunes 6:30 a.m.: paradas, técnicos y repuestos de la semana.</documentation>
          <property key="Contexto" value="Plan de Mantenimiento"/>
          <property key="Ejemplo" value="Programa de la semana 34."/>
          <property key="No usar" value="agenda"/>
          <property key="Fuente" value="P71"/>
          <property key="Fase" value="3 (V7)"/>
        </element>
        <element xsi:type="archimate:BusinessObject" name="Bahía" id="id-50b9b3f3887f5edbbc8fda80e0a90410">
          <documentation>Espacio físico del taller; hay dos y no caben más de dos drones a la vez.</documentation>
          <property key="Contexto" value="Plan de Mantenimiento"/>
          <property key="Ejemplo" value="Bahía 1."/>
          <property key="No usar" value="puesto de trabajo"/>
          <property key="Fuente" value="P74"/>
          <property key="Fase" value="3 (V7)"/>
        </element>
        <element xsi:type="archimate:BusinessObject" name="Boletín del fabricante" id="id-4623d27f66b150cf97f31e1478f18ad3">
          <documentation>Aviso del fabricante o distribuidor que puede cambiar un intervalo del plan.</documentation>
          <property key="Contexto" value="Plan de Mantenimiento"/>
          <property key="Ejemplo" value="Boletín que acorta la inspección de conectores."/>
          <property key="No usar" value="circular"/>
          <property key="Fuente" value="P70, P106"/>
          <property key="Fase" value="3 (V7)"/>
        </element>
      </folder>
    </folder>
  </folder>
  <folder name="Application" id="id-d2a1f83d32885c7c83bec8a951e87476" type="application">
    <folder name="Contextos" id="id-0150c880e16c5fd3867e096052497c15">
      <folder name="Operación y Horas" id="id-6b4e8392195c5f07a8f7f919df8058cd">
        <element xsi:type="archimate:ApplicationService" name="Servicio de registro de operación de vuelo" id="id-b0b843d36ab85ff3808dcdc2be6dbdb8">
          <documentation>Servicio de aplicación del contexto «Operación y Horas».</documentation>
          <property key="Fase" value="5 (V8)"/>
        </element>
        <element xsi:type="archimate:ApplicationService" name="Servicio de importación de telemetría" id="id-2e1b1c3295d8518b90e990da53ea9fd3">
