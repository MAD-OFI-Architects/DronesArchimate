      </element>
      <element xsi:type="archimate:Resource" name="Pool de baterías y cargadores" id="id-cdcb83ee643e59c1aa286b08a9e79168">
        <documentation>Unas 30 baterías con cargadores de campo.</documentation>
        <property key="Fase" value="1 (V2)"/>
        <property key="Fuente" value="Entrevista P101"/>
      </element>
      <element xsi:type="archimate:Resource" name="Taller con banco de pruebas y dos bahías" id="id-ac31f1f041a7523fa063a751297e7a31">
        <documentation>Galpón de Palmira.</documentation>
        <property key="Fase" value="1 (V2)"/>
        <property key="Fuente" value="Entrevista P101"/>
      </element>
      <element xsi:type="archimate:Resource" name="Stock de repuestos" id="id-aec1a36fd65c5c639ffa13884a7ff9d4">
        <documentation>Bodega con estantería por modelo.</documentation>
        <property key="Fase" value="1 (V2)"/>
        <property key="Fuente" value="Entrevista P101"/>
      </element>
      <element xsi:type="archimate:Resource" name="Técnicos de mantenimiento" id="id-9dd24d7fe33b59d99290026300c2d615">
        <documentation>Tres técnicos (dos en taller, uno itinerante).</documentation>
        <property key="Fase" value="1 (V2)"/>
        <property key="Fuente" value="Entrevista P101"/>
      </element>
      <element xsi:type="archimate:Resource" name="Pilotos remotos habilitados" id="id-210839a3deeb541fa33fd8083a01b471">
        <documentation>Ocho pilotos con certificado.</documentation>
        <property key="Fase" value="1 (V2)"/>
        <property key="Fuente" value="Entrevista P101"/>
      </element>
      <element xsi:type="archimate:Resource" name="Registros y bitácoras (OTs archivadas)" id="id-261e90baec235dfaa7bdecaf55ec0089">
        <documentation>Evidencia de aeronavegabilidad demostrable.</documentation>
        <property key="Fase" value="1 (V2)"/>
        <property key="Fuente" value="Entrevista P101"/>
      </element>
      <element xsi:type="archimate:Resource" name="Manuales del fabricante" id="id-bd7880cc2a5154bf9c9a65c542959b20">
        <documentation>Base técnica de intervalos y procedimientos.</documentation>
        <property key="Fase" value="1 (V2)"/>
        <property key="Fuente" value="Entrevista P101"/>
      </element>
      <element xsi:type="archimate:Resource" name="Camionetas con plantas eléctricas" id="id-baa50718928b5f4dae08ceee070a3b8a">
        <documentation>Tres camionetas para cuadrillas y carga de baterías.</documentation>
        <property key="Fase" value="1 (V2)"/>
        <property key="Fuente" value="Entrevista P101"/>
      </element>
    </folder>
    <folder name="Cursos de acción" id="id-3bb88ee6b86f5115aaf599a31b931123">
      <element xsi:type="archimate:CourseOfAction" name="Sistematizar el mantenimiento preventivo de la flota" id="id-a22e43c3d76658bba018027d7df44c6c">
        <documentation>Implementar gestión sistematizada: plan por dron, OT digital, liberación y indicadores.</documentation>
        <property key="Fase" value="1 (V2)"/>
        <property key="Fuente" value="Entrevista P138, P141"/>
      </element>
      <element xsi:type="archimate:CourseOfAction" name="Consolidar el registro único de operación" id="id-efeacc80d2c55775af310f0f619cd9c1">
        <documentation>Entrada única de horas y ciclos que reemplaza los tres canales manuales.</documentation>
        <property key="Fase" value="1 (V2)"/>
        <property key="Fuente" value="Entrevista P138, P141"/>
      </element>
      <element xsi:type="archimate:CourseOfAction" name="Asegurar repuestos críticos con stock mínimo y reserva" id="id-ae7dbce5b4b555ba991cedff3da12ab3">
        <documentation>Evitar paradas largas por falta de repuestos importados (caso ADV-02).</documentation>
        <property key="Fase" value="1 (V2)"/>
        <property key="Fuente" value="Entrevista P138, P141"/>
      </element>
    </folder>
    <folder name="Flujo de valor" id="id-011d00fb0e855264836fe1aa988122db">
      <element xsi:type="archimate:ValueStream" name="Contratar el servicio" id="id-1217daab1f885bc9b69e7c5b33ec376a">
        <documentation>Etapa de alto nivel de la cadena de valor de la empresa (prestar el servicio de fumigación).</documentation>
        <property key="Fase" value="1 (V3)"/>
        <property key="Fuente" value="Entrevista P12, P97"/>
      </element>
      <element xsi:type="archimate:ValueStream" name="Programar el servicio" id="id-2c73a0390725575fb7e1f5aac743e4a1">
        <documentation>Etapa de alto nivel de la cadena de valor de la empresa (prestar el servicio de fumigación).</documentation>
        <property key="Fase" value="1 (V3)"/>
        <property key="Fuente" value="Entrevista P12, P97"/>
      </element>
      <element xsi:type="archimate:ValueStream" name="Preparar la flota y la misión" id="id-f789c555adac555398bfb5d33ad3e395">
        <documentation>Etapa de alto nivel de la cadena de valor de la empresa (prestar el servicio de fumigación).</documentation>
        <property key="Fase" value="1 (V3)"/>
        <property key="Fuente" value="Entrevista P12, P97"/>
      </element>
      <element xsi:type="archimate:ValueStream" name="Aplicar el producto" id="id-5b10e2454e875fed973611bec0ee2bf3">
        <documentation>Etapa de alto nivel de la cadena de valor de la empresa (prestar el servicio de fumigación).</documentation>
        <property key="Fase" value="1 (V3)"/>
        <property key="Fuente" value="Entrevista P12, P97"/>
      </element>
      <element xsi:type="archimate:ValueStream" name="Informar y facturar" id="id-614c240add2c5713a31e7bc8511ce0a3">
        <documentation>Etapa de alto nivel de la cadena de valor de la empresa (prestar el servicio de fumigación).</documentation>
        <property key="Fase" value="1 (V3)"/>
        <property key="Fuente" value="Entrevista P12, P97"/>
      </element>
    </folder>
  </folder>
  <folder name="Business" id="id-893f2996739259e9ab78a657579c1d16" type="business">
    <folder name="Procesos E2E" id="id-fb89bf8d05ce5abd922ef43b0797f4c1">
      <element xsi:type="archimate:BusinessProcess" name="Gestionar la disponibilidad de la flota por mantenimiento preventivo" id="id-fa0f126d63e758a4a131faa2d2d545f0">
        <documentation>Proceso E2E donde opera la aplicación: desde que se registra la operación (horas y ciclos) hasta que el dron queda liberado y los indicadores actualizados.</documentation>
        <property key="Fase" value="1 (V3)"/>
        <property key="Fuente" value="Entrevista P28-P29, P39; H-38"/>
      </element>
      <element xsi:type="archimate:BusinessProcess" name="Registrar operación de vuelo" id="id-2aff122badbd5a079eb2d7ca9329accd">
        <documentation>Consolidar app, parte de vuelo y WhatsApp en horas y ciclos.</documentation>
        <property key="Fase" value="1 (V3)"/>
        <property key="Alcance" value="Dentro (la aplicación lo apoya)"/>
        <property key="Fuente" value="Entrevista P28-P29, P80-P89; H-24"/>
      </element>
      <element xsi:type="archimate:BusinessProcess" name="Detectar intervención por vencer" id="id-9f498de3bd8d5f79878baa9284f22fcd">
        <documentation>Comparar horas, ciclos, calendario y estado contra el plan (hoy: Excel de los viernes).</documentation>
        <property key="Fase" value="1 (V3)"/>
        <property key="Alcance" value="Dentro (la aplicación lo apoya)"/>
        <property key="Fuente" value="Entrevista P29, P31"/>
      </element>
      <element xsi:type="archimate:BusinessProcess" name="Programar intervención" id="id-d76c0b128b4752e3b317ff07e5abb418">
        <documentation>Decidir fecha, técnico y repuestos en la reunión del lunes sin chocar con servicios.</documentation>
        <property key="Fase" value="1 (V3)"/>
        <property key="Alcance" value="Dentro (la aplicación lo apoya)"/>
        <property key="Fuente" value="Entrevista P32, P71-P75"/>
      </element>
      <element xsi:type="archimate:BusinessProcess" name="Alistar repuestos y bahía" id="id-93ca430a64e253d5aa63a7ba4486f5f1">
        <documentation>Abrir la OT, reservar repuestos y preparar la bahía.</documentation>
        <property key="Fase" value="1 (V3)"/>
        <property key="Alcance" value="Dentro (la aplicación lo apoya)"/>
        <property key="Fuente" value="Entrevista P29, P65"/>
      </element>
      <element xsi:type="archimate:BusinessProcess" name="Ejecutar intervención" id="id-c41fef20e5aa53cc9161b4327ea7678e">
        <documentation>Diagnóstico, desmonte, cambio, calibración y pruebas de banco.</documentation>
        <property key="Fase" value="1 (V3)"/>
        <property key="Alcance" value="Dentro (la aplicación lo apoya)"/>
        <property key="Fuente" value="Entrevista P33"/>
      </element>
      <element xsi:type="archimate:BusinessProcess" name="Verificar y liberar dron" id="id-d46e43f375a15d928f7a97226779d74b">
        <documentation>Autoverificación, vuelo de prueba y firma de liberación.</documentation>
        <property key="Fase" value="1 (V3)"/>
        <property key="Alcance" value="Dentro (la aplicación lo apoya)"/>
        <property key="Fuente" value="Entrevista P34; H-22, H-23"/>
      </element>
      <element xsi:type="archimate:BusinessProcess" name="Cerrar y registrar intervención" id="id-a2e569b3a63350db8cd9c2143cf83277">
        <documentation>Cerrar la OT, descontar repuestos, actualizar bitácora, costo y contadores.</documentation>
        <property key="Fase" value="1 (V3)"/>
        <property key="Alcance" value="Dentro (la aplicación lo apoya)"/>
        <property key="Fuente" value="Entrevista P35-P36"/>
      </element>
      <element xsi:type="archimate:BusinessEvent" name="Vuelo completado" id="id-b541958947ce5d089698ec992a35e178">
        <documentation>El dron termina una jornada de vuelo.</documentation>
        <property key="Fase" value="1 (V3)"/>
        <property key="Fuente" value="Entrevista P29, P65, P76, P106"/>
      </element>
      <element xsi:type="archimate:BusinessEvent" name="Umbral de condición alcanzado" id="id-6d28a8b5b8715386bec0066bca1a68d6">
        <documentation>Horas, ciclos, calendario o estado llegan al intervalo.</documentation>
        <property key="Fase" value="1 (V3)"/>
        <property key="Fuente" value="Entrevista P29, P65, P76, P106"/>
      </element>
      <element xsi:type="archimate:BusinessEvent" name="Lista de intervenciones armada" id="id-88308cb30d8652f2887595321003b1e0">
        <documentation>Cierre de la revisión de vencimientos.</documentation>
        <property key="Fase" value="1 (V3)"/>
        <property key="Fuente" value="Entrevista P29, P65, P76, P106"/>
      </element>
      <element xsi:type="archimate:BusinessEvent" name="Intervención programada" id="id-95fceba8d9c15c4582aff8b65ebd02fa">
        <documentation>Se fijó fecha, técnico y repuestos.</documentation>
        <property key="Fase" value="1 (V3)"/>
        <property key="Fuente" value="Entrevista P29, P65, P76, P106"/>
      </element>
      <element xsi:type="archimate:BusinessEvent" name="Dron ingresado a taller" id="id-598ae85d31825d60bdd20ea8b7e424de">
        <documentation>El dron entra a la bahía el día D.</documentation>
        <property key="Fase" value="1 (V3)"/>
        <property key="Fuente" value="Entrevista P29, P65, P76, P106"/>
      </element>
      <element xsi:type="archimate:BusinessEvent" name="Intervención ejecutada" id="id-a9169254c9765bff918641fe49e08a8e">
        <documentation>El técnico termina y autoverifica.</documentation>
        <property key="Fase" value="1 (V3)"/>
        <property key="Fuente" value="Entrevista P29, P65, P76, P106"/>
      </element>
      <element xsi:type="archimate:BusinessEvent" name="Dron liberado" id="id-75fe23799a1e5c09b7d7ed79fb8bfe18">
        <documentation>Firma de liberación (y vuelo de prueba en mayores).</documentation>
        <property key="Fase" value="1 (V3)"/>
        <property key="Fuente" value="Entrevista P29, P65, P76, P106"/>
      </element>
      <element xsi:type="archimate:BusinessEvent" name="Indicadores actualizados" id="id-fcbde6b015e05c13b443193d4e3b0493">
        <documentation>OT cerrada y contadores/indicadores al día.</documentation>
        <property key="Fase" value="1 (V3)"/>
        <property key="Fuente" value="Entrevista P29, P65, P76, P106"/>
      </element>
      <element xsi:type="archimate:BusinessEvent" name="Boletín del fabricante recibido" id="id-1350dd7df35d5ba087d48ed00024dc4d">
        <documentation>Disparador alterno: cambia un intervalo.</documentation>
        <property key="Fase" value="1 (V3)"/>
        <property key="Fuente" value="Entrevista P29, P65, P76, P106"/>
      </element>
      <element xsi:type="archimate:BusinessEvent" name="Hallazgo reportado" id="id-4e06998a794957d4af4c0b3009a32c7f">
        <documentation>Disparador alterno: piloto o técnico ve algo.</documentation>
        <property key="Fase" value="1 (V3)"/>
        <property key="Fuente" value="Entrevista P29, P65, P76, P106"/>
      </element>
      <element xsi:type="archimate:BusinessEvent" name="Faltante de repuesto detectado" id="id-244ee3010b7b542c91cec8e58dab6edf">
        <documentation>Excepción: falta repuesto para la OT.</documentation>
        <property key="Fase" value="1 (V3)"/>
        <property key="Fuente" value="Entrevista P29, P65, P76, P106"/>
      </element>
      <element xsi:type="archimate:BusinessEvent" name="Condición crítica vencida en servicio" id="id-f0e9cd8a4d98512da736bcfd245af969">
        <documentation>Excepción: el dron aterriza y no vuela.</documentation>
        <property key="Fase" value="1 (V3)"/>
        <property key="Fuente" value="Entrevista P29, P65, P76, P106"/>
      </element>
      <element xsi:type="archimate:BusinessEvent" name="Vuelo de prueba fallido" id="id-0b1d863398c250a0a191b4e3209f7c5b">
        <documentation>Excepción: la liberación se detiene.</documentation>
        <property key="Fase" value="1 (V3)"/>
        <property key="Fuente" value="Entrevista P29, P65, P76, P106"/>
      </element>
      <element xsi:type="archimate:BusinessEvent" name="Intervención no cumplida" id="id-6a671e9d9d995be2932510b4e47a24ca">
        <documentation>Excepción: la OT queda pendiente.</documentation>
        <property key="Fase" value="1 (V3)"/>
        <property key="Fuente" value="Entrevista P29, P65, P76, P106"/>
      </element>
      <element xsi:type="archimate:BusinessProcess" name="Resolver faltante de repuesto" id="id-1acb9183f54b564b9bf7439829eeb50b">
        <documentation>Canibalizar donantes, pedir prestado, comprar urgente o reprogramar (OT en espera, tablero amarillo).</documentation>
        <property key="Fase" value="1 (V3)"/>
        <property key="Alcance" value="Dentro (excepción)"/>
        <property key="Fuente" value="Entrevista P50, P65, P76"/>
      </element>
      <element xsi:type="archimate:BusinessProcess" name="Retirar dron por condición crítica" id="id-aaf511893c315f59b89053c634c19caf">
        <documentation>Aterrizar, informar y enviar sustituto; crítico = el dron no vuela.</documentation>
        <property key="Fase" value="1 (V3)"/>
        <property key="Alcance" value="Dentro (excepción)"/>
        <property key="Fuente" value="Entrevista P50, P65, P76"/>
      </element>
      <element xsi:type="archimate:BusinessProcess" name="Reprogramar intervención no cumplida" id="id-ddb198959d765a34904446f8d91b99ec">
        <documentation>Re-agendar el lunes siguiente con el motivo registrado.</documentation>
        <property key="Fase" value="1 (V3)"/>
        <property key="Alcance" value="Dentro (excepción)"/>
        <property key="Fuente" value="Entrevista P50, P65, P76"/>
      </element>
      <element xsi:type="archimate:BusinessProcess" name="Operar vuelo y aspersión" id="id-1185caa2183c59759a8834154588804c">
        <documentation>Misión del piloto con el dron; fuera de la aplicación (solo se registran sus resultados).</documentation>
        <property key="Fase" value="1 (V3)"/>
        <property key="Alcance" value="Fuera"/>
        <property key="Fuente" value="Entrevista P148, P155"/>
      </element>
      <element xsi:type="archimate:BusinessProcess" name="Programar servicios a clientes" id="id-71cbf664f5fc5c9c897e1fa8c0b8f303">
        <documentation>Calendario de servicios de Comercial; fuera de la aplicación (se consume por ACL).</documentation>
        <property key="Fase" value="1 (V3)"/>
        <property key="Alcance" value="Fuera"/>
        <property key="Fuente" value="Entrevista P148, P155"/>
      </element>
      <element xsi:type="archimate:BusinessProcess" name="Comprar o importar repuestos" id="id-27801175e6b159a2ae2ebe74427e0d7c">
        <documentation>Compra y aprobación (Almacén, Administración, Gerencia); la aplicación solo genera la solicitud.</documentation>
        <property key="Fase" value="1 (V3)"/>
        <property key="Alcance" value="Fuera"/>
        <property key="Fuente" value="Entrevista P148, P155"/>
      </element>
      <element xsi:type="archimate:BusinessProcess" name="Reportar a la autoridad y renovar registros" id="id-9cd4669f013a5e5c98a30cd72be108f2">
        <documentation>Trámites en UAS Colombia (Administración); la aplicación aporta la evidencia.</documentation>
        <property key="Fase" value="1 (V3)"/>
        <property key="Alcance" value="Fuera"/>
        <property key="Fuente" value="Entrevista P148, P155"/>
      </element>
      <element xsi:type="archimate:BusinessFunction" name="Informar disponibilidad e indicadores" id="id-4e927707eb6c5c3688907cb87299fb5e">
        <documentation>Entrega estado del dron, disponibilidad y tablero mensual a Comercial y Gerencia.</documentation>
        <property key="Fase" value="1 (V3)"/>
        <property key="Alcance" value="Dentro"/>
        <property key="Fuente" value="Entrevista P92, P137"/>
      </element>
      <element xsi:type="archimate:BusinessFunction" name="Generar evidencia de mantenimiento" id="id-c642809378fe50d1a3a555a958ddf655">
        <documentation>Arma el histórico por dron para ingenios, aseguradora y autoridad.</documentation>
        <property key="Fase" value="1 (V3)"/>
        <property key="Alcance" value="Dentro"/>
        <property key="Fuente" value="Entrevista P92, P137"/>
      </element>
    </folder>
    <folder name="Actores y roles" id="id-4927194051415a20bc6c790fd3cf1d4d">
      <element xsi:type="archimate:BusinessRole" name="Piloto remoto" id="id-2bfc6c617b1458a084fe0bc24c19ccc0">
        <documentation>Vuela, hace el primer nivel de mantenimiento y reporta fallas; recomienda, no decide parar.</documentation>
        <property key="Fase" value="1 (V3)"/>
        <property key="Fuente" value="Entrevista P22"/>
      </element>
      <element xsi:type="archimate:BusinessRole" name="Jefe de Operaciones y Mantenimiento" id="id-fe933baa24f055b9a169327c644f668f">
        <documentation>Planea, programa, aprueba diferimientos y libera trabajos mayores.</documentation>
        <property key="Fase" value="1 (V3)"/>
        <property key="Fuente" value="Entrevista P22"/>
      </element>
      <element xsi:type="archimate:BusinessRole" name="Técnico de mantenimiento" id="id-174e56063e2956b599fa795edb6ab6b5">
        <documentation>Ejecuta la OT, firma el trabajo y recomienda no liberar.</documentation>
        <property key="Fase" value="1 (V3)"/>
        <property key="Fuente" value="Entrevista P22"/>
      </element>
      <element xsi:type="archimate:BusinessRole" name="Almacenista" id="id-d7d24a52818559fb97ffbc4ff765d552">
        <documentation>Lleva el kardex, reserva y entrega repuestos contra la OT.</documentation>
        <property key="Fase" value="1 (V3)"/>
        <property key="Fuente" value="Entrevista P22"/>
      </element>
      <element xsi:type="archimate:BusinessRole" name="Coordinación de servicios" id="id-1bd6113d50e1511995b17f78c34a8099">
        <documentation>Contrata y agenda servicios; trae el calendario al lunes.</documentation>
        <property key="Fase" value="1 (V3)"/>
        <property key="Fuente" value="Entrevista P22"/>
      </element>
      <element xsi:type="archimate:BusinessRole" name="Gerencia" id="id-1fab8651b5d355da88715c93f2e10a69">
        <documentation>Aprueba gastos mayores y es responsable de la seguridad operacional.</documentation>
        <property key="Fase" value="1 (V3)"/>
        <property key="Fuente" value="Entrevista P22"/>
      </element>
      <element xsi:type="archimate:BusinessActor" name="Equipo de pilotos (líder: Camilo)" id="id-dfcbbc2bb3c757209fa35de6b872bd46">
        <documentation>Persona o equipo que desempeña el rol.</documentation>
        <property key="Fase" value="1 (V3)"/>
        <property key="Fuente" value="Entrevista P21-P22"/>
      </element>
      <element xsi:type="archimate:BusinessActor" name="Pompilio Ospina" id="id-48c8e6a81e595e25891bc5f70f4e2d2d">
        <documentation>Persona o equipo que desempeña el rol.</documentation>
        <property key="Fase" value="1 (V3)"/>
        <property key="Fuente" value="Entrevista P21-P22"/>
      </element>
      <element xsi:type="archimate:BusinessActor" name="Jhon Fredy, Duberney y Yeison" id="id-dd7ff84ae5c3536cb0068f789616b9f3">
        <documentation>Persona o equipo que desempeña el rol.</documentation>
        <property key="Fase" value="1 (V3)"/>
        <property key="Fuente" value="Entrevista P21-P22"/>
      </element>
      <element xsi:type="archimate:BusinessActor" name="(Nubia)" id="id-1166ee8b006850faa6a3d641b409def5">
        <documentation>Persona o equipo que desempeña el rol.</documentation>
        <property key="Fase" value="1 (V3)"/>
        <property key="Fuente" value="Entrevista P21-P22"/>
      </element>
      <element xsi:type="archimate:BusinessActor" name="(Sandra)" id="id-8999012e61f35551838feb41d2c24ba1">
        <documentation>Persona o equipo que desempeña el rol.</documentation>
        <property key="Fase" value="1 (V3)"/>
        <property key="Fuente" value="Entrevista P21-P22"/>
      </element>
      <element xsi:type="archimate:BusinessActor" name="Don Hernando Villegas" id="id-07d4cb0b96d354b6b74c1636cfd89e96">
        <documentation>Persona o equipo que desempeña el rol.</documentation>
        <property key="Fase" value="1 (V3)"/>
        <property key="Fuente" value="Entrevista P21-P22"/>
      </element>
    </folder>
    <folder name="Lenguaje ubicuo" id="id-631d03b54e915084886c919dbdb120ff">
      <folder name="Operación y Horas" id="id-e06a0b721fc75c4884089f66f65e7a90">
        <element xsi:type="archimate:BusinessObject" name="Parte de vuelo" id="id-52a2a5b810ba527a9452ca3ae7863da9">
          <documentation>Formato en papel que diligencia el piloto al final de la jornada: lote, cliente, producto, dosis e incidentes.</documentation>
          <property key="Contexto" value="Operación y Horas"/>
          <property key="Ejemplo" value="Parte fotografiado al grupo de WhatsApp."/>
          <property key="No usar" value="reporte, planilla"/>
          <property key="Fuente" value="P13, P82"/>
          <property key="Fase" value="3 (V7)"/>
        </element>
        <element xsi:type="archimate:BusinessObject" name="Registro de operación" id="id-3761b1095e535c58beb8a42939791c07">
          <documentation>Unión consolidada de la app del fabricante, el parte de vuelo y el WhatsApp para una jornada de un dron.</documentation>
          <property key="Contexto" value="Operación y Horas"/>
          <property key="Ejemplo" value="Registro del ADV-06 del 14 de agosto."/>
          <property key="No usar" value="bitácora"/>
          <property key="Fuente" value="P82"/>
          <property key="Fase" value="3 (V7)"/>
        </element>
      </folder>
      <folder name="Plan de Mantenimiento" id="id-ccc62691e66d575ca7d98d01fa5abc86">
        <element xsi:type="archimate:BusinessObject" name="Plan por dron" id="id-68478f42e9fa5999acd986e3ff582e1a">
          <documentation>Plan de un dron concreto: tareas del modelo con sus vencimientos y ajustes propios.</documentation>
          <property key="Contexto" value="Plan de Mantenimiento"/>
          <property key="Ejemplo" value="Plan del ADV-03."/>
          <property key="No usar" value="hoja del dron"/>
          <property key="Fuente" value="P69"/>
          <property key="Fase" value="3 (V7)"/>
        </element>
        <element xsi:type="archimate:BusinessObject" name="Programa semanal" id="id-a7e85c73a8a058d5bb750aa359ebc7c3">
          <documentation>Decisión del lunes 6:30 a.m.: paradas, técnicos y repuestos de la semana.</documentation>
          <property key="Contexto" value="Plan de Mantenimiento"/>
          <property key="Ejemplo" value="Programa de la semana 34."/>
          <property key="No usar" value="agenda"/>
          <property key="Fuente" value="P71"/>
          <property key="Fase" value="3 (V7)"/>
        </element>
      </folder>
      <folder name="Intervenciones" id="id-2b258af7f7a95da0937b1db79a4c47ec">
        <element xsi:type="archimate:BusinessObject" name="Orden de trabajo" id="id-bc1a6f6900625740ba08b262b834861d">
          <documentation>Documento que autoriza y registra una intervención sobre un dron: tareas, repuestos con serie, horas-hombre, hallazgos y firmas.</documentation>
          <property key="Contexto" value="Intervenciones"/>
          <property key="Ejemplo" value="OT del service de 100 h del ADV-06."/>
          <property key="No usar" value="ticket, solicitud"/>
          <property key="Fuente" value="P33-P35"/>
          <property key="Fase" value="3 (V7)"/>
        </element>
        <element xsi:type="archimate:BusinessObject" name="Liberación" id="id-3d52f0ea7b9c58e29f8d365c1c8f294f">
          <documentation>Firma que autoriza el regreso del dron al servicio; en trabajos mayores la da quien no ejecutó.</documentation>
          <property key="Contexto" value="Intervenciones"/>
          <property key="Ejemplo" value="Pompilio firma a las 8:00."/>
          <property key="No usar" value="visto bueno"/>
          <property key="Fuente" value="H-22; P24, P34"/>
          <property key="Fase" value="3 (V7)"/>
        </element>
        <element xsi:type="archimate:BusinessObject" name="Bitácora del dron" id="id-92dfbc2f9472565aab8b80a36dd2649f">
          <documentation>Cuaderno histórico de vuelos y mantenimiento de cada dron de la empresa.</documentation>
          <property key="Contexto" value="Intervenciones"/>
          <property key="Ejemplo" value="Bitácora del ADV-03."/>
          <property key="No usar" value="libro de vida"/>
          <property key="Fuente" value="H-36; P114, P132"/>
          <property key="Fase" value="3 (V7)"/>
        </element>
      </folder>
      <folder name="Repuestos del Taller" id="id-3cc7efaaa15f5c4da6999f64d00d626d">
        <element xsi:type="archimate:BusinessObject" name="Reserva de repuesto" id="id-2db189a812fa59b2847a9091ddfe1d73">
          <documentation>Apartado de repuestos para una intervención programada.</documentation>
          <property key="Contexto" value="Repuestos del Taller"/>
          <property key="Ejemplo" value="Kit de filtros reservado para la parada del miércoles."/>
          <property key="No usar" value="separado"/>
          <property key="Fuente" value="H-29; P28"/>
          <property key="Fase" value="3 (V7)"/>
        </element>
      </folder>
    </folder>
  </folder>
  <folder name="Application" id="id-d2a1f83d32885c7c83bec8a951e87476" type="application"/>
  <folder name="Technology &amp; Physical" id="id-7f3099b1390b5c4194199599fc70963c" type="technology"/>
  <folder name="Motivation" id="id-962c8dcf48ca501d84d29d02061b918d" type="motivation">
    <folder name="01 Stakeholders y drivers" id="id-b5488c9ac85955478d835a0e1e566713">
      <element xsi:type="archimate:Stakeholder" name="Gerencia (propietario)" id="id-1227b90e892c5d219d0948d58f4deec1">
        <documentation>Don Hernando Villegas. Decide y aprueba el gasto; le importan la rentabilidad y el riesgo.</documentation>
        <property key="Fuente" value="Entrevista P135, P144"/>
        <property key="Fase" value="1 (V1)"/>
      </element>
      <element xsi:type="archimate:Stakeholder" name="Jefe de Operaciones y Mantenimiento" id="id-0294bbc4251d577bb1f11f690d7b377e">
        <documentation>Pompilio Ospina. Planea, programa, aprueba y libera; le importan la disponibilidad y el orden de los registros.</documentation>
        <property key="Fuente" value="Entrevista P135, P21-P22"/>
        <property key="Fase" value="1 (V1)"/>
      </element>
      <element xsi:type="archimate:Stakeholder" name="Pilotos remotos" id="id-6c1d8906638c5513a46d8fbe01ed126b">
        <documentation>Ocho pilotos habilitados; necesitan equipos confiables y seguros; hacen mantenimiento de primer nivel.</documentation>
        <property key="Fuente" value="Entrevista P135, P22"/>
        <property key="Fase" value="1 (V1)"/>
      </element>
      <element xsi:type="archimate:Stakeholder" name="Técnicos de mantenimiento" id="id-5b6d87d7ecd05031aa3013ebeb9a7b11">
        <documentation>Tres técnicos (dos en taller, uno itinerante); necesitan carga razonable e información para trabajar.</documentation>
        <property key="Fuente" value="Entrevista P135, P22"/>
        <property key="Fase" value="1 (V1)"/>
      </element>
      <element xsi:type="archimate:Stakeholder" name="Clientes (ingenios y agroempresas)" id="id-edcbc71939d25b33bfd4dc29dc5e4fcf">
        <documentation>Ingenios (60-65 % de los ingresos), arroceros, palmeros y agroempresas; esperan cumplimiento y trazabilidad.</documentation>
        <property key="Fuente" value="Entrevista P5, P135"/>
        <property key="Fase" value="1 (V1)"/>
      </element>
      <element xsi:type="archimate:Stakeholder" name="Aerocivil (autoridad aeronáutica)" id="id-05e2ac155b2355839a6f815eca8e6d8a">
        <documentation>Regula la operación de UAS (RAC 100); espera cumplimiento y registros.</documentation>
        <property key="Fuente" value="Entrevista P135; H-02, H-03"/>
        <property key="Fase" value="1 (V1)"/>
      </element>
      <element xsi:type="archimate:Stakeholder" name="Aseguradora" id="id-e5a28a3d5c41569682f85b968d6b0238">
        <documentation>Póliza de responsabilidad civil; en siniestros pide evidencia de mantenimiento.</documentation>
        <property key="Fuente" value="Entrevista P135; H-05"/>
        <property key="Fase" value="1 (V1)"/>
      </element>
      <element xsi:type="archimate:Stakeholder" name="Comercial y Administración" id="id-d09e60e05b7659719df04c954e95c966">
        <documentation>Sandra (contrata y agenda) y Marta (costos, compras, carpetas de certificaciones); necesitan saber cuántos drones se pueden prometer y cuánto cuesta.</documentation>
        <property key="Fuente" value="Entrevista P92, P103, P151"/>
        <property key="Fase" value="1 (V1)"/>
      </element>
      <element xsi:type="archimate:Driver" name="Flota creciente y envejeciendo" id="id-2b250f477a605e2f9e60dff229e2fee4">
        <documentation>La flota pasó de 8 a 12 drones en cuatro años; el método de libreta ya no da abasto y los correctivos suben con la edad.</documentation>
        <property key="Fuente" value="Entrevista P136; H-27"/>
        <property key="Fase" value="1 (V1)"/>
      </element>
      <element xsi:type="archimate:Driver" name="Regulación UAS exige registros trazables" id="id-fd4a7afbfd055ec39bf313cc404d49e9">
        <documentation>Reglamentación nueva (RAC 100) aprieta por registros de operación y mantenimiento.</documentation>
        <property key="Fuente" value="Entrevista P136; H-02, H-03, H-40"/>
        <property key="Fase" value="1 (V1)"/>
      </element>
      <element xsi:type="archimate:Driver" name="Riesgo de perder contratos por indisponibilidad" id="id-876f1bb5b9d45893a783a44a175f3d27">
        <documentation>Un ingenio no espera: un dron parado en pico puede costar un contrato.</documentation>
        <property key="Fuente" value="Entrevista P4, P8, P136; H-29"/>
        <property key="Fase" value="1 (V1)"/>
      </element>
      <element xsi:type="archimate:Driver" name="Competencia más ordenada llegando al mercado" id="id-f8a2cc27145d5c51a444b8b7e63a9deb">
        <documentation>Están llegando empresas de drones con procesos más ordenados.</documentation>
        <property key="Fuente" value="Entrevista P136, P143"/>
        <property key="Fase" value="1 (V1)"/>
      </element>
      <element xsi:type="archimate:Driver" name="Riesgo de incidente con químico a bordo" id="id-68d25dbc597555d49addcd6383854e7a">
        <documentation>Riesgo #2 del negocio: daño a terceros, tema ambiental y póliza.</documentation>
        <property key="Fuente" value="Entrevista P8, P143; H-05"/>
        <property key="Fase" value="1 (V1)"/>
      </element>
      <element xsi:type="archimate:Assessment" name="Incidente ADV-02: 3 semanas parado, $8–10 M" id="id-c479ba6108c659cea4ba9e4e3b308b85">
        <documentation>Octubre 2025: falla de motor por corrosión de conectores, brazo sin stock (importación), 220 ha reprogramadas.</documentation>
        <property key="Fuente" value="Entrevista P19, P137; H-29"/>
        <property key="Fase" value="1 (V1)"/>
      </element>
      <element xsi:type="archimate:Assessment" name="Cumplimiento del plan en 65–70 %" id="id-ce22efc23bef574bbdd620e8e319e294">
        <documentation>Meta informal: 85 %.</documentation>
        <property key="Fuente" value="Entrevista P91, P93, P137; H-27"/>
        <property key="Fase" value="1 (V1)"/>
      </element>
      <element xsi:type="archimate:Assessment" name="Disponibilidad en pico de 80–85 %" id="id-fe31e3bcb10c505bab6ba28812a80106">
        <documentation>Valle ~90 %; en pico el negocio necesita tres drones el mismo día en tres municipios.</documentation>
        <property key="Fuente" value="Entrevista P91, P93, P95; H-28"/>
        <property key="Fase" value="1 (V1)"/>
      </element>
      <element xsi:type="archimate:Assessment" name="Horas consolidadas con 2–4 días de atraso" id="id-1a0c63854f5e56bba2c30e56f1e5f603">
        <documentation>Datos en tres canales (app, papel, WhatsApp) que se consolidan en Excel los viernes.</documentation>
        <property key="Fuente" value="Entrevista P10, P37; H-24"/>
        <property key="Fase" value="1 (V1)"/>
      </element>
      <element xsi:type="archimate:Assessment" name="Descuadre del kardex de 5–10 %" id="id-44a9ead379ba58c885e95905348d607c">
        <documentation>El stock 'dice que hay' y no hay; salidas sin anotar.</documentation>
        <property key="Fuente" value="Entrevista P58, P137"/>
        <property key="Fase" value="1 (V1)"/>
      </element>
      <element xsi:type="archimate:Assessment" name="Auditoría de ingenio: histórico armado en días" id="id-167e3221fbdc5f5e892ce719e4779b4d">
        <documentation>Un ingenio pidió el histórico de mantenimiento por dron y se armó a mano desde carpetas.</documentation>
        <property key="Fuente" value="Entrevista P137"/>
        <property key="Fase" value="1 (V1)"/>
      </element>
      <element xsi:type="archimate:Assessment" name="Correctivo en 40 % de las OTs" id="id-b76af6e3152b51908f05ed68c11edc59">
        <documentation>Mix 55 % preventivo / 40 % correctivo / 5 % por condición; el correctivo cuesta 2–3 veces el preventivo.</documentation>
        <property key="Fuente" value="Entrevista P6, P30; H-27"/>
        <property key="Fase" value="1 (V1)"/>
      </element>
      <element xsi:type="archimate:Value" name="Flota lista en temporada alta" id="id-1c744d47f4f756c0b6e3cc5402c2c901">
        <documentation>Utilidad que se compra al hacer preventivo: drones listos en octubre, cuando un dron parado cuesta un contrato.</documentation>
        <property key="Fuente" value="Entrevista P4, P11"/>
        <property key="Fase" value="1 (V1)"/>
      </element>
      <element xsi:type="archimate:Value" name="Contratos de ingenios conservados" id="id-71d8f16ee555521a97c498efcbc6069c">
        <documentation>Los ingenios aportan el 60-65 % de los ingresos; perderlos pone en riesgo a la empresa.</documentation>
        <property key="Fuente" value="Entrevista P5, P11"/>
        <property key="Fase" value="1 (V1)"/>
      </element>
      <element xsi:type="archimate:Value" name="Seguridad operacional demostrable" id="id-4d4fb90be843519186ef40f56a5f6816">
        <documentation>Poder mostrar a la autoridad, la aseguradora y los clientes que la flota está en condición segura.</documentation>
        <property key="Fuente" value="Entrevista P8, P121, P132; H-05"/>
        <property key="Fase" value="1 (V1)"/>
      </element>
    </folder>
    <folder name="02 Metas y resultados" id="id-9c1fafd22f45518fbcf1f737f5fffe09">
      <element xsi:type="archimate:Goal" name="Disponibilidad de flota ≥ 92 % en pico (2027)" id="id-7975fc7bfaef58128556c51fbd261228">
        <documentation>Disponibilidad sostenida en plena temporada para 2027.</documentation>
        <property key="Meta" value="≥ 92 %"/>
        <property key="Fecha" value="2027"/>
        <property key="Fuente" value="Entrevista P138; H-37, H-28"/>
        <property key="Fase" value="1 (V1)"/>
      </element>
      <element xsi:type="archimate:Goal" name="Cumplimiento del plan ≥ 85 % (2S-2027)" id="id-6aceebf2912c5325a4524f8911c7dd8f">
        <documentation>Cumplimiento del plan preventivo desde el segundo semestre de 2027.</documentation>
        <property key="Meta" value="≥ 85 %"/>
        <property key="Fecha" value="2S-2027"/>
        <property key="Fuente" value="Entrevista P138; H-37"/>
        <property key="Fase" value="1 (V1)"/>
      </element>
      <element xsi:type="archimate:Goal" name="Correctivo ≤ 25 % de las OTs (2028)" id="id-53895a71766257f3862fb1f4064fbf59">
        <documentation>Proporción de OTs correctivas hacia 2028.</documentation>
        <property key="Meta" value="≤ 25 %"/>
        <property key="Fecha" value="2028"/>
        <property key="Fuente" value="Entrevista P138; H-37, H-27"/>
        <property key="Fase" value="1 (V1)"/>
      </element>
      <element xsi:type="archimate:Goal" name="Horas y ciclos consolidados el mismo día (mes 1)" id="id-ac26fc45d41554ec96047dde9fb1e0c3">
        <documentation>Consolidación de horas el mismo día desde el primer mes de uso.</documentation>
        <property key="Meta" value="mismo día"/>
        <property key="Fecha" value="mes 1 de uso"/>
        <property key="Fuente" value="Entrevista P138; H-37, H-24"/>
        <property key="Fase" value="1 (V1)"/>
      </element>
      <element xsi:type="archimate:Goal" name="Costo de mantenimiento por hora −15 % (2028)" id="id-503e6d0c7db9545e97ff3db50eafbbbd">
        <documentation>Reducción del costo de mantenimiento por hora de vuelo hacia 2028 (hoy ~$80-100 mil COP/h).</documentation>
        <property key="Meta" value="−15 %"/>
        <property key="Fecha" value="2028"/>
        <property key="Fuente" value="Entrevista P91, P138; H-37"/>
        <property key="Fase" value="1 (V1)"/>
      </element>
      <element xsi:type="archimate:Outcome" name="Prometer tres drones con certeza" id="id-c0c0bc0ff2c753ad8bc47cee8d6107f2">
        <documentation>Comercial puede comprometer drones a un cliente sabiendo cuántos estarán disponibles.</documentation>
        <property key="Fuente" value="Entrevista P139, P92"/>
        <property key="Fase" value="1 (V1)"/>
      </element>
      <element xsi:type="archimate:Outcome" name="Cero condiciones críticas vencidas volando" id="id-75cfe8e2245c53f689511b094d97d639">
        <documentation>Ningún dron vuela con una condición crítica vencida.</documentation>
        <property key="Fuente" value="Entrevista P154, P139"/>
        <property key="Fase" value="1 (V1)"/>
      </element>
      <element xsi:type="archimate:Outcome" name="Auditoría entregada en un día" id="id-8f52c0c3d5be53e4b84272bba5ec1abd">
        <documentation>El histórico por dron se entrega a un ingenio, la aseguradora o la autoridad en un día.</documentation>
        <property key="Fuente" value="Entrevista P139, P154"/>
        <property key="Fase" value="1 (V1)"/>
      </element>
      <element xsi:type="archimate:Outcome" name="Preventivo sigue sin depender de una persona" id="id-ca5c04a0514f5b10a8ef73a97266d762">
        <documentation>El jefe de mantenimiento puede ausentarse tres días sin que el preventivo se congele.</documentation>
        <property key="Fuente" value="Entrevista P139, P37"/>
        <property key="Fase" value="1 (V1)"/>
      </element>
      <element xsi:type="archimate:Outcome" name="Horas y ciclos siempre al día" id="id-4a24fc3ca9f2582eb4760ec784b38e84">
        <documentation>Los datos de operación están disponibles sin consolidar a mano el viernes.</documentation>
        <property key="Fuente" value="Entrevista P154, P161"/>
        <property key="Fase" value="1 (V1)"/>
      </element>
    </folder>
    <folder name="03 Principios, requerimientos, restricciones" id="id-4809af809f085f8b9d104ffab4b8cc75">
      <element xsi:type="archimate:Principle" name="Seguridad antes que productividad" id="id-8f9230b4492d557e8a0e94986efdb130">
        <documentation>Lo crítico no se difiere jamás; la seguridad no se negocia con el calendario.</documentation>
        <property key="Fuente" value="Entrevista P32, P49, P140; H-19"/>
        <property key="Fase" value="1 (V1)"/>
      </element>
      <element xsi:type="archimate:Principle" name="Si no está escrito, no pasó" id="id-2ad19a7ee4705982b78e4a3c2e09fcf1">
        <documentation>Todo evento de mantenimiento debe quedar registrado.</documentation>
        <property key="Fuente" value="Entrevista P140"/>
        <property key="Fase" value="1 (V1)"/>
      </element>
      <element xsi:type="archimate:Principle" name="Quien ejecuta no libera" id="id-f8038c576dcc57409023429109391f59">
        <documentation>En trabajos mayores quien libera es distinto de quien ejecutó (aún no se cumple siempre).</documentation>
        <property key="Fuente" value="Entrevista P24, P140; H-22"/>
        <property key="Fase" value="1 (V1)"/>
      </element>
      <element xsi:type="archimate:Principle" name="El dato del fabricante es la base; la experiencia va encima" id="id-66b794a7f9bb540cb664c1bf4f0b5618">
        <documentation>Los intervalos del fabricante son el piso; los ajustes internos solo pueden ser más estrictos.</documentation>
        <property key="Fuente" value="Entrevista P18, P140; H-15"/>
        <property key="Fase" value="1 (V1)"/>
      </element>
      <element xsi:type="archimate:Principle" name="Volar o no volar lo decide una persona" id="id-572e0c6458055d0b9650f80e1f556a10">
        <documentation>El software apoya decisiones; la decisión de volar siempre es humana.</documentation>
        <property key="Fuente" value="Entrevista P150"/>
        <property key="Fase" value="1 (V1)"/>
      </element>
      <element xsi:type="archimate:Requirement" name="Consolidar horas y ciclos el mismo día" id="id-06d093045b545a6a917b1eeef8b36b00">
        <documentation>Registrar horas de vuelo y ciclos a partir de las operaciones, sin consolidación manual.</documentation>
        <property key="Prioridad" value="Imprescindible"/>
        <property key="Realizado por" value="Registro de operación de vuelo (provisional; se confirma en V4)"/>
        <property key="Fuente" value="Entrevista P141, P149; H-24"/>
        <property key="Fase" value="1 (V1)"/>
      </element>
      <element xsi:type="archimate:Requirement" name="Alertar vencimientos del plan por dron y componente" id="id-4a3577ac5e3953d2bc0fb4933e031507">
        <documentation>Plan por dron con condiciones por horas, ciclos, calendario o estado (manda lo que ocurra primero).</documentation>
        <property key="Prioridad" value="Imprescindible"/>
        <property key="Fuente" value="Entrevista P141, P46-P47; H-17"/>
        <property key="Fase" value="1 (V1)"/>
      </element>
      <element xsi:type="archimate:Requirement" name="Gestionar la OT digital con repuestos y cierre" id="id-a1b32e8af820527b8fbe1823a33f1f60">
        <documentation>Orden de trabajo con repuestos usados (series), horas-hombre, hallazgos y cierre.</documentation>
        <property key="Prioridad" value="Imprescindible"/>
        <property key="Fuente" value="Entrevista P33-P35, P141"/>
        <property key="Fase" value="1 (V1)"/>
      </element>
      <element xsi:type="archimate:Requirement" name="Reservar repuestos para intervenciones programadas" id="id-c87658b9f5595b98a872564bc9be9e91">
        <documentation>Stock del taller con reserva para cada intervención.</documentation>
        <property key="Prioridad" value="Imprescindible"/>
        <property key="Fuente" value="Entrevista P141; H-29"/>
        <property key="Fase" value="1 (V1)"/>
      </element>
      <element xsi:type="archimate:Requirement" name="Liberar el dron con firma distinta a quien ejecutó" id="id-6883995c38795d7e9bd6a83647e10ed2">
        <documentation>Liberación de trabajos mayores con vuelo de prueba y rol distinto al ejecutor.</documentation>
        <property key="Prioridad" value="Imprescindible"/>
        <property key="Fuente" value="Entrevista P24, P34; H-22, H-23"/>
        <property key="Fase" value="1 (V1)"/>
      </element>
      <element xsi:type="archimate:Requirement" name="Calcular indicadores con una única regla de conteo" id="id-eeceba8603ad5a458061239a1a17b157">
        <documentation>Disponibilidad, cumplimiento del plan, MTBF y costo por hora con una regla única (p. ej. tratamiento de los donantes).</documentation>
        <property key="Prioridad" value="Deseable"/>
        <property key="Fuente" value="Entrevista P91, P95, P141; H-28"/>
        <property key="Fase" value="1 (V1)"/>
      </element>
      <element xsi:type="archimate:Requirement" name="Exportar evidencia de mantenimiento para auditoría" id="id-b57cf205aaba5ac0a8ea701760bd7c56">
        <documentation>Reportes exportables para ingenios, aseguradora y autoridad.</documentation>
        <property key="Prioridad" value="Deseable"/>
        <property key="Realizado por" value="Generación de evidencia de mantenimiento (provisional; se confirma en V4)"/>
        <property key="Fuente" value="Entrevista P137, P141; H-05"/>
        <property key="Fase" value="1 (V1)"/>
      </element>
      <element xsi:type="archimate:Requirement" name="Conservar la vida remanente del componente" id="id-d3b67ceac0d155f5bd58d9002d55f38e">
        <documentation>El contador pertenece al componente y viaja con él entre drones.</documentation>
        <property key="Prioridad" value="Imprescindible"/>
        <property key="Fuente" value="Entrevista P36, P44, P51; H-20, H-21"/>
        <property key="Fase" value="1 (V1)"/>
      </element>
      <element xsi:type="archimate:Requirement" name="Ofrecer interfaz simple en español, sin doble digitación" id="id-935929d1885053bc9c7923fe70803e25">
        <documentation>Uso fácil, en español, sin digitar dos veces lo mismo.</documentation>
        <property key="Prioridad" value="Imprescindible"/>
        <property key="Fuente" value="Entrevista P142, P160"/>
        <property key="Fase" value="1 (V1)"/>
      </element>
      <element xsi:type="archimate:Constraint" name="Presupuesto de pyme: sin licencias caras por usuario" id="id-19f1ae35a4e25b5fbbcb9e4e0b4201dd">
        <documentation>Proyecto de presupuesto limitado.</documentation>
        <property key="Fuente" value="Entrevista P142"/>
        <property key="Fase" value="1 (V1)"/>
      </element>
      <element xsi:type="archimate:Constraint" name="Conectividad regular en campo" id="id-f90d4165aaca527d904ec2f99ac2a00a">
        <documentation>Datos móviles con señal irregular.</documentation>
        <property key="Fuente" value="Entrevista P142, P160"/>
        <property key="Fase" value="1 (V1)"/>
      </element>
      <element xsi:type="archimate:Constraint" name="Telemetría del fabricante solo por exportación manual" id="id-8b058097f69654c4a3152a3021fcaaf4">
        <documentation>No se paga la gestión de flota en la nube del fabricante; no hay API.</documentation>
        <property key="Fuente" value="Entrevista P142; H-35"/>
        <property key="Fase" value="1 (V1)"/>
      </element>
      <element xsi:type="archimate:Constraint" name="RAC 100 (Res. 0334/2024): registros de operación" id="id-ae575800a8b75337bce0f3d868aba1a7">
        <documentation>Reglamento UAS de la Aerocivil; requisitos exactos de registros y retención por precisar (S-03).</documentation>
        <property key="Fuente" value="H-02, H-03, H-40; S-03"/>
        <property key="Fase" value="1 (V1)"/>
      </element>
      <element xsi:type="archimate:Constraint" name="Seguro RC exige evidencia de mantenimiento" id="id-3c5803a681cd5ac8ab6bca08e12d243c">
        <documentation>En siniestros la aseguradora pide evidencia de mantenimiento; condicionado pendiente de lectura.</documentation>
        <property key="Fuente" value="Entrevista P25; H-05"/>
        <property key="Fase" value="1 (V1)"/>
      </element>
      <element xsi:type="archimate:Constraint" name="Ley 1581/2012: protección de datos personales" id="id-e8dfbec4945057c2b8e78d24675af95c">
        <documentation>Aplica a datos de pilotos, técnicos y clientes.</documentation>
        <property key="Fuente" value="H-11"/>
        <property key="Fase" value="1 (V1)"/>
      </element>
      <element xsi:type="archimate:Constraint" name="SST y normas ambientales (SG-SST, posconsumo)" id="id-27767412292a5228a1e2fd516cd67d36">
        <documentation>Decreto 1072/2015, Res. 0312/2019, Res. 1675/2013, Res. 1297/2010 y 799/2025 (alcance litio por verificar).</documentation>
        <property key="Fuente" value="H-08, H-09, H-10; S-05"/>
        <property key="Fase" value="1 (V1)"/>
      </element>
    </folder>
    <folder name="04 Significados" id="id-e40615fec8a1509b8cbe3bf3a0a01035">
      <element xsi:type="archimate:Meaning" name="Mantenimiento = inversión en disponibilidad, no solo costo" id="id-d131016ed4ed5f34b12eeffe7a7b1e0c">
        <documentation>Interpretación del experto: el mantenimiento no es solo un costo (22 % del total); cuando se gasta en preventivo se compra flota lista en octubre.</documentation>
        <property key="Fuente" value="Entrevista P6, P11 (corrección del experto)"/>
        <property key="Fase" value="1 (V1)"/>
      </element>
      <element xsi:type="archimate:Meaning" name="Disponible" id="id-b1069409b4bf52139075ce7ac5167522">
        <documentation>Palabra con significados distintos según el contexto: Disponible (programación) (Programación de servicios (externo)); Disponible (mantenimiento) (Plan de Mantenimiento).</documentation>
        <property key="Fase" value="3 (V7)"/>
        <property key="Fuente" value="H-18, H-26, H-36"/>
      </element>
    </folder>
  </folder>
