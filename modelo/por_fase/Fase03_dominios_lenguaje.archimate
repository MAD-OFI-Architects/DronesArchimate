  <folder name="Technology &amp; Physical" id="id-7f3099b1390b5c4194199599fc70963c" type="technology"/>
  <folder name="Motivation" id="id-962c8dcf48ca501d84d29d02061b918d" type="motivation">
    <folder name="04 Significados" id="id-e40615fec8a1509b8cbe3bf3a0a01035">
      <element xsi:type="archimate:Meaning" name="Registro" id="id-df8670670eee54d5b568a689850d39a4">
        <documentation>Palabra con significados distintos según el contexto: ID interno (Flota y Componentes); Registro oficial (matrícula UAS) (Autoridad aeronáutica (externo)).</documentation>
        <property key="Fase" value="3 (V7)"/>
        <property key="Fuente" value="H-18, H-26, H-36"/>
      </element>
      <element xsi:type="archimate:Meaning" name="Estado" id="id-d4f17931c79b5791932ba73c437d62c6">
        <documentation>Palabra con significados distintos según el contexto: Estado del dron (Flota y Componentes); Estado del componente (Flota y Componentes); Estado (de condición) (Plan de Mantenimiento); Estado de la orden (Intervenciones).</documentation>
        <property key="Fase" value="3 (V7)"/>
        <property key="Fuente" value="H-18, H-26, H-36"/>
      </element>
      <element xsi:type="archimate:Meaning" name="Ciclo" id="id-2c1fbe5c8d855d84a91564ed65053c32">
        <documentation>Palabra con significados distintos según el contexto: Horas de dron (Flota y Componentes); Ciclo de carga (Flota y Componentes); Carga de caldo (Flota y Componentes).</documentation>
        <property key="Fase" value="3 (V7)"/>
        <property key="Fuente" value="H-18, H-26, H-36"/>
      </element>
      <element xsi:type="archimate:Meaning" name="Horas" id="id-560bc6e7e4ab5c9cae0abdf43e633912">
        <documentation>Palabra con significados distintos según el contexto: Horas de vuelo (Operación y Horas); Horas de motor (Telemetría del fabricante (externo)).</documentation>
        <property key="Fase" value="3 (V7)"/>
        <property key="Fuente" value="H-18, H-26, H-36"/>
      </element>
      <element xsi:type="archimate:Meaning" name="Servicio / misión" id="id-a7a1897b353b5635b128b516326de2fb">
        <documentation>Palabra con significados distintos según el contexto: Servicio de fumigación (Programación de servicios (externo)); Misión (Operación y Horas).</documentation>
        <property key="Fase" value="3 (V7)"/>
        <property key="Fuente" value="H-18, H-26, H-36"/>
      </element>
      <element xsi:type="archimate:Meaning" name="Disponible" id="id-b1069409b4bf52139075ce7ac5167522">
        <documentation>Palabra con significados distintos según el contexto: Disponible (programación) (Programación de servicios (externo)); Disponible (mantenimiento) (Plan de Mantenimiento).</documentation>
        <property key="Fase" value="3 (V7)"/>
        <property key="Fuente" value="H-18, H-26, H-36"/>
      </element>
      <element xsi:type="archimate:Meaning" name="Salida / consumo" id="id-6eec4484b3925cd5b5ab97a4f5b5208d">
        <documentation>Palabra con significados distintos según el contexto: Consumo (de repuesto) (Intervenciones); Salida (kardex) (Inventario y compras (externo)).</documentation>
        <property key="Fase" value="3 (V7)"/>
        <property key="Fuente" value="H-18, H-26, H-36"/>
      </element>
      <element xsi:type="archimate:Meaning" name="Bitácora" id="id-bdd3f890e23750e9acaff538b10136d2">
        <documentation>Palabra con significados distintos según el contexto: Bitácora del dron (Intervenciones); Bitácora oficial (Autoridad aeronáutica (externo)).</documentation>
        <property key="Fase" value="3 (V7)"/>
        <property key="Fuente" value="H-18, H-26, H-36"/>
      </element>
      <element xsi:type="archimate:Meaning" name="Stock" id="id-f5ab78a7e04b5c4b8d6c7426588219b6">
        <documentation>Palabra con significados distintos según el contexto: Existencia (Repuestos del Taller); Stock (bodega) (Inventario y compras (externo)).</documentation>
        <property key="Fase" value="3 (V7)"/>
        <property key="Fuente" value="H-18, H-26, H-36"/>
      </element>
      <element xsi:type="archimate:Meaning" name="Certificado" id="id-7d699760cc1e5921ad147b11e25dc943">
        <documentation>Palabra con significados distintos según el contexto: Técnico habilitado (Habilitación de Personal); Certificado de curso (Talento humano (externo)); Certificado de piloto UAS (Autoridad aeronáutica (externo)).</documentation>
        <property key="Fase" value="3 (V7)"/>
        <property key="Fuente" value="H-18, H-26, H-36"/>
      </element>
      <element xsi:type="archimate:Meaning" name="Valor" id="id-370da533629153b7b84021c5070909ac">
        <documentation>Palabra con significados distintos según el contexto: Valor (Indicadores). En V1 (motivación), «valor» (Value) es además el beneficio que aporta la aplicación: flota lista en temporada, contratos conservados, seguridad demostrable.</documentation>
        <property key="Fase" value="3 (V7)"/>
        <property key="Fuente" value="H-18, H-26, H-36"/>
      </element>
    </folder>
  </folder>
