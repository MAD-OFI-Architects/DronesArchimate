        <element xsi:type="archimate:BusinessObject" name="Dron" id="id-a415d42fd290503e9f644cf7e59e615a">
          <documentation>Aeronave no tripulada de la flota, con identidad propia y horas acumuladas que nunca se reinician.</documentation>
          <property key="Contexto" value="Flota y Componentes"/>
          <property key="Ejemplo" value="ADV-03 (T40) con 240 h de dron."/>
