  <folder name="Application" id="id-d2a1f83d32885c7c83bec8a951e87476" type="application">
    <folder name="Dominios" id="id-42eb362fb87850c28355fd048a343472">
      <element xsi:type="archimate:Grouping" name="Dominio: Flota y Componentes" id="id-c112cd9435bb5ce1846f17056c0173e0">
        <documentation>Saber qué drones hay, qué componentes lleva cada uno y cuánta vida les queda, con el contador pegado al componente.</documentation>
        <property key="Clasificación" value="Core"/>
        <property key="Diferenciación" value="El «reloj del componente» y su arrastre entre drones es lo que hoy no se logra (H-20, H-21) y origina fallas como la del ADV-02."/>
        <property key="Complejidad" value="Alta: dos marcas, despiece por modelo, pool de baterías, donantes; cambia al comprar equipos nuevos."/>
        <property key="Comprar vs construir" value="No existe un producto que modele este despiece con arrastre de vida entre drones; se construye."/>
        <property key="Estrategia de inversión" value="Diseño táctico completo (agregados Dron y Componente, V6a)."/>
        <property key="Fase" value="3 (V5)"/>
        <property key="Fuente" value="Event Storming (Fase 3) y entrevista"/>
      </element>
      <element xsi:type="archimate:Grouping" name="Dominio: Plan de Mantenimiento" id="id-9f6a6848d79256599b9cc04ca87aef92">
        <documentation>Decidir cuándo toca intervenir cada dron y componente y programar paradas sin chocar con los servicios.</documentation>
        <property key="Clasificación" value="Core"/>
        <property key="Diferenciación" value="Convierte datos en la decisión de cuándo intervenir: «lo que ocurra primero», fuentes de intervalos, diferimientos y paradas con restricciones físicas (H-15, H-17, H-19)."/>
        <property key="Complejidad" value="Alta: reglas cambian con boletines y hallazgos; restricciones de bahías, líneas y técnicos."/>
        <property key="Comprar vs construir" value="Un ERP de mantenimiento genérico no cubre estas reglas ni el ajuste por dron; se construye."/>
        <property key="Estrategia de inversión" value="Diseño táctico completo (agregados Plan por modelo, Plan por dron y Programa semanal, V6b)."/>
        <property key="Fase" value="3 (V5)"/>
        <property key="Fuente" value="Event Storming (Fase 3) y entrevista"/>
      </element>
      <element xsi:type="archimate:Grouping" name="Dominio: Intervenciones" id="id-fe9bf196d75d51e49432ac2443c42a4b">
        <documentation>Ejecutar, liberar y cerrar el trabajo de mantenimiento dejando evidencia verificable.</documentation>
        <property key="Clasificación" value="Core"/>
        <property key="Diferenciación" value="Aplica «quien ejecuta no libera» y la hora de corte; es la prueba de aeronavegabilidad ante autoridad, aseguradora e ingenios (H-22, H-23)."/>
        <property key="Complejidad" value="Alta: estados, invariantes de liberación y cierre; correctivos y preventivos comparten OT."/>
        <property key="Comprar vs construir" value="Un software de OT genérico no impone la liberación ni arrastra vida; se construye."/>
        <property key="Estrategia de inversión" value="Diseño táctico completo (agregado Orden de trabajo, V6c)."/>
        <property key="Fase" value="3 (V5)"/>
        <property key="Fuente" value="Event Storming (Fase 3) y entrevista"/>
      </element>
      <element xsi:type="archimate:Grouping" name="Dominio: Operación y Horas" id="id-e366b71d96ef5d1089f3ac63ce37f465">
        <documentation>Registrar las operaciones de vuelo y consolidar horas y ciclos en una entrada única.</documentation>
        <property key="Clasificación" value="Soporte"/>
        <property key="Diferenciación" value="Es necesario y urgente (P149) pero no diferencia: cualquier flota necesita horas al día."/>
        <property key="Complejidad" value="Media: tres canales, discrepancias e idempotencia de la telemetría."/>
        <property key="Comprar vs construir" value="No se compra: depende del modelo de telemetría de cada fabricante (ACL-03); se construye lo mínimo con ACL."/>
        <property key="Estrategia de inversión" value="Diseño razonable: dos agregados pequeños (V6d) y capa anticorrupción."/>
        <property key="Fase" value="3 (V5)"/>
        <property key="Fuente" value="Event Storming (Fase 3) y entrevista"/>
      </element>
      <element xsi:type="archimate:Grouping" name="Dominio: Repuestos del Taller" id="id-2d91e4e39b9655589e7f1a22704c1b40">
        <documentation>Reservar y consumir repuestos por OT y pedir reposición al tocar el mínimo.</documentation>
        <property key="Clasificación" value="Soporte"/>
        <property key="Diferenciación" value="Apoya al core (evita el caso ADV-02) pero un taller cualquiera también reserva repuestos."/>
        <property key="Complejidad" value="Media: reservas, mínimos y niveles de aprobación."/>
        <property key="Comprar vs construir" value="Existen sistemas de inventario, pero el inventario general quedó fuera; se construye solo reserva, consumo y solicitud."/>
        <property key="Estrategia de inversión" value="Diseño razonable (V6e)."/>
        <property key="Fase" value="3 (V5)"/>
        <property key="Fuente" value="Event Storming (Fase 3) y entrevista"/>
      </element>
      <element xsi:type="archimate:Grouping" name="Dominio: Indicadores" id="id-6faab6ea0d345857a22cc9646d539138">
        <documentation>Calcular disponibilidad, cumplimiento del plan, MTBF y costo por hora con una sola regla de conteo.</documentation>
        <property key="Clasificación" value="Soporte"/>
        <property key="Diferenciación" value="Las fórmulas son estándar; solo la regla de conteo única (donantes) es propia (H-28). No diferencia al negocio."/>
        <property key="Complejidad" value="Baja a media: cálculos sobre eventos; la regla es lo delicado."/>
        <property key="Comprar vs construir" value="Una herramienta de BI podría sustituir los tableros, pero la regla y las metas se modelan aquí."/>
        <property key="Estrategia de inversión" value="Diseño razonable, agregados livianos (V6f)."/>
        <property key="Fase" value="3 (V5)"/>
        <property key="Fuente" value="Event Storming (Fase 3) y entrevista"/>
      </element>
      <element xsi:type="archimate:Grouping" name="Dominio: Habilitación de Personal" id="id-6e44b5aa82c452c4ba58ac14d0a1f8b3">
        <documentation>Saber qué técnico está habilitado para qué modelo y tarea (espejo de lo que administra Talento humano).</documentation>
        <property key="Clasificación" value="Soporte"/>
        <property key="Diferenciación" value="Específico del taller (curso por modelo) pero sin ventaja competitiva."/>
        <property key="Complejidad" value="Baja: pocas reglas, datos de solo lectura."/>
        <property key="Comprar vs construir" value="Los registros viven en Administración (ACL-04); aquí solo se consulta la vigencia."/>
        <property key="Estrategia de inversión" value="Diseño mínimo (V6g)."/>
        <property key="Fase" value="3 (V5)"/>
        <property key="Fuente" value="Event Storming (Fase 3) y entrevista"/>
      </element>
      <element xsi:type="archimate:Grouping" name="Dominio: Evidencia y Reportes" id="id-b5382d0225a556eb963c2a7110860a94">
        <documentation>Entregar el histórico por dron a ingenios, aseguradora y autoridad en un día.</documentation>
        <property key="Clasificación" value="Genérico"/>
        <property key="Diferenciación" value="Cualquier operador debe poder exportar su historial; no es lo que diferencia al negocio."/>
        <property key="Complejidad" value="Baja: lee lo que producen Flota e Intervenciones."/>
        <property key="Comprar vs construir" value="Comprar o integrar una herramienta de reportes/exportación sobre los datos del core."/>
        <property key="Estrategia de inversión" value="Solo se justifica la compra/integración; sin diseño táctico propio."/>
        <property key="Fase" value="3 (V5)"/>
        <property key="Fuente" value="Event Storming (Fase 3) y entrevista"/>
      </element>
      <element xsi:type="archimate:Grouping" name="Dominio: Notificaciones" id="id-488aacbf30625c88be737b73e1451be1">
        <documentation>Avisar por correo o WhatsApp vencimientos, paradas y habilitaciones por vencer.</documentation>
        <property key="Clasificación" value="Genérico"/>
        <property key="Diferenciación" value="Funcionalidad común a cualquier sistema."/>
        <property key="Complejidad" value="Baja."/>
        <property key="Comprar vs construir" value="Comprar/integrar un servicio de mensajería; no se construye."/>
        <property key="Estrategia de inversión" value="Solo integración; sin diseño táctico propio."/>
        <property key="Fase" value="3 (V5)"/>
        <property key="Fuente" value="Event Storming (Fase 3) y entrevista"/>
      </element>
    </folder>
    <folder name="Contextos" id="id-0150c880e16c5fd3867e096052497c15">
      <element xsi:type="archimate:ApplicationComponent" name="Flota y Componentes" id="id-9bf5f2968a5253a7b29b2d62a3546268">
        <documentation>Componente del contexto delimitado «Flota y Componentes» (Core). Saber qué drones hay, qué componentes lleva cada uno y cuánta vida les queda, con el contador pegado al componente.</documentation>
        <property key="Clasificación" value="Core"/>
        <property key="Fase" value="3 (V5)"/>
      </element>
      <element xsi:type="archimate:ApplicationComponent" name="Plan de Mantenimiento" id="id-a9415f54aa14560ba9ce342ee3a245cf">
        <documentation>Componente del contexto delimitado «Plan de Mantenimiento» (Core). Decidir cuándo toca intervenir cada dron y componente y programar paradas sin chocar con los servicios.</documentation>
        <property key="Clasificación" value="Core"/>
        <property key="Fase" value="3 (V5)"/>
      </element>
      <element xsi:type="archimate:ApplicationComponent" name="Intervenciones" id="id-5fb2e8c1954e593cae010b56da9294f4">
        <documentation>Componente del contexto delimitado «Intervenciones» (Core). Ejecutar, liberar y cerrar el trabajo de mantenimiento dejando evidencia verificable.</documentation>
        <property key="Clasificación" value="Core"/>
        <property key="Fase" value="3 (V5)"/>
      </element>
      <element xsi:type="archimate:ApplicationComponent" name="Operación y Horas" id="id-d04e44283afb50d7bc04a22869194a8a">
        <documentation>Componente del contexto delimitado «Operación y Horas» (Soporte). Registrar las operaciones de vuelo y consolidar horas y ciclos en una entrada única.</documentation>
        <property key="Clasificación" value="Soporte"/>
        <property key="Fase" value="3 (V5)"/>
      </element>
      <element xsi:type="archimate:ApplicationComponent" name="Repuestos del Taller" id="id-92b6019b163950f9853d9de79388269c">
        <documentation>Componente del contexto delimitado «Repuestos del Taller» (Soporte). Reservar y consumir repuestos por OT y pedir reposición al tocar el mínimo.</documentation>
        <property key="Clasificación" value="Soporte"/>
        <property key="Fase" value="3 (V5)"/>
      </element>
      <element xsi:type="archimate:ApplicationComponent" name="Indicadores" id="id-1d94d416333e50b78640580977bade21">
        <documentation>Componente del contexto delimitado «Indicadores» (Soporte). Calcular disponibilidad, cumplimiento del plan, MTBF y costo por hora con una sola regla de conteo.</documentation>
        <property key="Clasificación" value="Soporte"/>
        <property key="Fase" value="3 (V5)"/>
      </element>
      <element xsi:type="archimate:ApplicationComponent" name="Habilitación de Personal" id="id-d662ac3df2dd524bb6e84b1913926797">
        <documentation>Componente del contexto delimitado «Habilitación de Personal» (Soporte). Saber qué técnico está habilitado para qué modelo y tarea (espejo de lo que administra Talento humano).</documentation>
        <property key="Clasificación" value="Soporte"/>
        <property key="Fase" value="3 (V5)"/>
      </element>
      <element xsi:type="archimate:ApplicationComponent" name="Evidencia y Reportes" id="id-76fa75960dc1538fafd0e6b34e3ba273">
        <documentation>Componente del contexto delimitado «Evidencia y Reportes» (Genérico). Entregar el histórico por dron a ingenios, aseguradora y autoridad en un día.</documentation>
        <property key="Clasificación" value="Genérico"/>
        <property key="Fase" value="3 (V5)"/>
      </element>
      <element xsi:type="archimate:ApplicationComponent" name="Notificaciones" id="id-7cb3fd0c3d9e5d8b8ebfcc5231fe9f07">
        <documentation>Componente del contexto delimitado «Notificaciones» (Genérico). Avisar por correo o WhatsApp vencimientos, paradas y habilitaciones por vencer.</documentation>
        <property key="Clasificación" value="Genérico"/>
        <property key="Fase" value="3 (V5)"/>
      </element>
      <element xsi:type="archimate:ApplicationComponent" name="Aplicación de mantenimiento preventivo" id="id-598bd55d66745c2cb28b3dc6202f9997">
        <documentation>Aplicación a construir: conjunto de los nueve contextos delimitados.</documentation>
        <property key="Fase" value="5 (ecosistema)"/>
      </element>
    </folder>
